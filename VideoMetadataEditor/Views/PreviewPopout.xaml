<Window x:Class="VideoMetadataEditor.Views.PreviewPopout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview"
        Width="640" Height="420"
        MinWidth="320" MinHeight="240"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        Background="#FF1A1A2E"
        Closing="OnClosing">

    <Window.Resources>
        <Style x:Key="PlayerBtn" TargetType="Button">
            <Setter Property="Background" Value="#40FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#60FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#80FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Video surface -->
        <MediaElement x:Name="Player"
                      Grid.Row="0"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      Stretch="Uniform"
                      MediaEnded="Player_MediaEnded"/>

        <!-- Controls bar -->
        <Border Grid.Row="1"
                Background="#CC0D0D1A"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="PlayPauseBtn"
                        Grid.Column="0"
                        Content="▶ Play"
                        Style="{StaticResource PlayerBtn}"
                        Click="PlayPause_Click"/>

                <Button Grid.Column="1"
                        Content="⏹"
                        Style="{StaticResource PlayerBtn}"
                        Padding="10,5"
                        Margin="6,0,0,0"
                        Click="Stop_Click"
                        ToolTip="Stop"/>

                <TextBlock x:Name="TitleLabel"
                           Grid.Column="2"
                           Foreground="#AAFFFFFF"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="12,0"/>

                <TextBlock Grid.Column="3"
                           Text="Vol"
                           Foreground="#88FFFFFF"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>

                <Slider x:Name="VolumeSlider"
                        Grid.Column="4"
                        Minimum="0" Maximum="1" Value="0.7"
                        Width="70" VerticalAlignment="Center"
                        ToolTip="Volume"
                        ValueChanged="VolumeSlider_ValueChanged"/>
            </Grid>
        </Border>
    </Grid>
</Window>
