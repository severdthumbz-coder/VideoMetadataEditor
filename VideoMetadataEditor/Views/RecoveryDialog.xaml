<Window x:Class="VideoMetadataEditor.Views.RecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:VideoMetadataEditor.Converters"
        Title="Incomplete Operations Detected"
        Width="720" MinWidth="560"
        SizeToContent="Height"
        MaxHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

    <Window.Resources>
        <!-- Converters needed since this window has its own resource scope -->
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvBoolVis" Invert="True"/>

        <Style TargetType="Button" x:Key="ActionBtn">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        </Style>
        <Style TargetType="Button" x:Key="ResumeBtn" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#1A4CAF50"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
        </Style>
        <Style TargetType="Button" x:Key="DeleteBtn" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#1AEF5350"/>
            <Setter Property="BorderBrush" Value="#EF5350"/>
            <Setter Property="Foreground" Value="#C62828"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="⚠ Incomplete Operations Found"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundBrush}"/>
            <TextBlock Margin="0,4,0,0" FontSize="12"
                       Foreground="{DynamicResource ForegroundMutedBrush}"
                       TextWrapping="Wrap">
                The following temp or backup files were detected in your loaded folders.
                These are left when the application exits mid-write.
                Choose an action for each file, or use the bulk buttons below.
            </TextBlock>
        </StackPanel>

        <Separator Grid.Row="1" Margin="0,0,0,12"/>

        <!-- Candidate list -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="400">
            <ItemsControl x:Name="CandidateList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Type badge + filename -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Background="{Binding TypeBadgeColor}"
                                            CornerRadius="3" Padding="5,2" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding TypeBadge}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding FileName}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding TempFilePath}"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding FileSizeDisplay}"
                                               FontSize="11"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>
                                </Grid>

                                <!-- Description -->
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Description}"
                                           FontSize="11"
                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                           Margin="0,4,0,4"/>

                                <!-- Embedded title + folder -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4"
                                            Visibility="{Binding HasTitle, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="Embedded title: "
                                               FontSize="11" FontStyle="Italic"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                    <TextBlock Text="{Binding EmbeddedTitle}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </StackPanel>

                                <!-- Source file selector (for WriteTemp with multiple matches) -->
                                <Grid Grid.Row="3"
                                      Visibility="{Binding NeedsSourceSelection, Converter={StaticResource BoolVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Apply to:"
                                               FontSize="11"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <ComboBox Grid.Column="1"
                                              x:Name="SourceCombo"
                                              ItemsSource="{Binding PossibleSourceFiles}"
                                              SelectedItem="{Binding SelectedSourceFile}"
                                              FontSize="11"
                                              VerticalAlignment="Center"/>
                                    <Button Grid.Column="2"
                                            Content="▶ Resume"
                                            Style="{StaticResource ResumeBtn}"
                                            IsEnabled="{Binding CanResume}"
                                            Tag="{Binding}"
                                            Click="ResumeBtn_Click"/>
                                    <Button Grid.Column="3"
                                            Content="🗑 Delete"
                                            Style="{StaticResource DeleteBtn}"
                                            Tag="{Binding}"
                                            Click="DeleteBtn_Click"/>
                                </Grid>

                                <!-- Auto-resolve row (single source or backup-only) -->
                                <StackPanel Grid.Row="3" Orientation="Horizontal"
                                            Visibility="{Binding NeedsSourceSelection, Converter={StaticResource InvBoolVis}}">
                                    <Button Content="▶ Resume"
                                            Style="{StaticResource ResumeBtn}"
                                            Visibility="{Binding CanAutoResume, Converter={StaticResource BoolVis}}"
                                            Tag="{Binding}"
                                            Click="ResumeBtn_Click"/>
                                    <Button Content="🗑 Delete"
                                            Style="{StaticResource DeleteBtn}"
                                            Tag="{Binding}"
                                            Click="DeleteBtn_Click"/>
                                    <TextBlock Margin="8,0,0,0"
                                               FontSize="11" FontStyle="Italic"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding CanAutoResume, Converter={StaticResource BoolVis}}"
                                               Text="{Binding AutoResumeTarget}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer buttons -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       x:Name="SummaryText"
                       FontSize="11"
                       Foreground="{DynamicResource ForegroundMutedBrush}"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="▶ Resume All"
                    Style="{StaticResource ResumeBtn}"
                    x:Name="ResumeAllBtn"
                    Click="ResumeAllBtn_Click"/>
            <Button Grid.Column="2" Content="🗑 Delete All"
                    Style="{StaticResource DeleteBtn}"
                    Click="DeleteAllBtn_Click"/>
            <Button Grid.Column="3" Content="Dismiss"
                    Style="{StaticResource ActionBtn}"
                    Margin="12,0,0,0"
                    Click="DismissBtn_Click"/>
        </Grid>
    </Grid>
</Window>
