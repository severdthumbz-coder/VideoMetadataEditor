<Window x:Class="VideoMetadataEditor.Views.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VideoMetadataEditor"
        Width="500" Height="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border CornerRadius="18"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🎬" FontSize="52" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                <TextBlock Text="Video Metadata Editor"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock x:Name="VersionText"
                           FontSize="12"
                           Foreground="{DynamicResource ForegroundMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock Text="Batch tag · rename · embed metadata into video files"
                           FontSize="11"
                           Foreground="{DynamicResource ForegroundMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,6,0,20"/>
            </StackPanel>

            <ProgressBar Grid.Row="1" x:Name="SplashProgress"
                         Height="3" Margin="36,0" Value="0" Maximum="100"/>

            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceAltBrush}"
                    CornerRadius="0,0,18,18">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
                    <TextBlock Text="© 2026 VideoMetadataEditor  ·  v1.4.0 build 127"
                               FontSize="11"
                               Foreground="{DynamicResource ForegroundMutedBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock FontSize="10"
                               Foreground="{DynamicResource ForegroundMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,2,0,0">
                        <Run>Powered by </Run>
                        <Hyperlink NavigateUri="https://www.themoviedb.org"
                                   RequestNavigate="Attribution_RequestNavigate">
                            TMDB
                        </Hyperlink>
                        <Run> · </Run>
                        <Hyperlink NavigateUri="https://www.omdbapi.com"
                                   RequestNavigate="Attribution_RequestNavigate">
                            OMDB
                        </Hyperlink>
                        <Run> · TagLib#</Run>
                    </TextBlock>
                    <TextBlock Text="This product uses the TMDB API but is not endorsed or certified by TMDB."
                               FontSize="9"
                               Foreground="{DynamicResource ForegroundMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,1,0,0"
                               Opacity="0.7"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
