<Window x:Class="VideoMetadataEditor.Views.MainWindow"
         Closing="MainWindow_Closing"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VideoMetadataEditor.ViewModels"
        xmlns:conv="clr-namespace:VideoMetadataEditor.Converters"
        xmlns:models="clr-namespace:VideoMetadataEditor.Models"
        xmlns:views="clr-namespace:VideoMetadataEditor.Views"
        Title="{Binding AppVersionFull, StringFormat='Video Metadata Editor {0}', Mode=OneTime}"
        Width="1260" Height="820"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        Drop="Window_Drop"
        AllowDrop="True">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvBoolVis" Invert="True"/>
        <conv:NullToVisibilityConverter x:Key="NullVis"/>
        <conv:NullToVisibilityConverter x:Key="NullCol" Invert="True"/>
        <conv:InvertBoolConverter       x:Key="InvBool"/>
        <conv:BytesToImageSourceConverter x:Key="BytesToImg"/>
        <conv:PathToFilenameConverter x:Key="PathToFilenameConverter"/>
        <conv:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter"/>
        <conv:BoolToStringConverter x:Key="ThemeIcon" TrueValue="🌙" FalseValue="☀️"/>
        <conv:NullableBoolToVisibilityConverter x:Key="NullableBoolVis"/>
        <conv:BoolToStringConverter x:Key="BoolToStringDetected" TrueValue="✓ Found"   FalseValue="Not found"/>
        <conv:BoolToStringConverter x:Key="BoolToWatchedLabel"   TrueValue="♥ Watched" FalseValue="Unwatched"/>
        <conv:StringEqualsBoolConverter x:Key="StringEqualsBool"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>   <!-- Title bar -->
            <RowDefinition Height="4"/>    <!-- Top progress bar -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Status bar with progress -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- TITLE BAR -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App name + version -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎬" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Video Metadata Editor"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBlock Text="{Binding AppVersionFull, Mode=OneTime}"
                                   FontSize="10"
                                   Foreground="{DynamicResource ForegroundMutedBrush}"/>
                        <!-- Update badge: shown only when a newer GitHub release exists.
                             Click opens the release page in the browser. -->
                        <Button Command="{Binding OpenUpdateUrlCommand}"
                                Cursor="Hand"
                                Margin="0,2,0,0"
                                Padding="6,1"
                                HorizontalAlignment="Left"
                                ToolTip="A newer version is available on GitHub — click to open the release page"
                                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolVis}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#2E7D32" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="{Binding UpdateBadgeText}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="White"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- File action toolbar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="{DynamicResource Btn.AddFiles}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding AddFilesCommand}"
                            Padding="10,6" Margin="0,0,4,0"/>
                    <Button Content="{DynamicResource Btn.AddFolder}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding AddFolderCommand}"
                            Padding="10,6" Margin="0,0,4,0"/>
                    <CheckBox Content="{DynamicResource Btn.Recursive}"
                              IsChecked="{Binding AddFolderRecursive}"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0" FontSize="12"
                              ToolTip="When checked, Add Folder scans all subfolders. Uncheck to load only the top-level folder."/>
                    <Separator Width="1" Height="20" Background="{DynamicResource BorderBrush}" Margin="0,0,8,0"/>
                    <Button Content="{DynamicResource Btn.All}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding SelectAllCommand}"
                            Padding="8,6" FontSize="12" Margin="0,0,4,0"/>
                    <Button Content="{DynamicResource Btn.None}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding DeselectAllCommand}"
                            Padding="8,6" FontSize="12" Margin="0,0,8,0"/>
                    <Separator Width="1" Height="20" Background="{DynamicResource BorderBrush}" Margin="0,0,8,0"/>
                    <Button Content="{DynamicResource Btn.Lock}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ToggleSelectedLockCommand}"
                            CommandParameter="Lock"
                            Padding="8,6" FontSize="12" Margin="0,0,4,0"
                            Foreground="{DynamicResource ErrorBrush}"
                            ToolTip="Lock selected files (set read-only)"/>
                    <Button Content="{DynamicResource Btn.Unlock}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ToggleSelectedLockCommand}"
                            CommandParameter="Unlock"
                            Padding="8,6" FontSize="12" Margin="0,0,8,0"
                            ToolTip="Unlock selected files (clear read-only)"/>
                    <Separator Width="1" Height="20" Background="{DynamicResource BorderBrush}" Margin="0,0,8,0"/>
                    <Button Content="{DynamicResource Btn.BatchProcess}"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding BatchProcessCommand}"
                            Padding="14,6"/>
                    <Button Content="{DynamicResource Btn.TvBatch}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding BatchTvCommand}"
                            Padding="10,6" Margin="8,0,0,0"
                            ToolTip="Series-level TV batch: parses S##E## codes from filenames, auto-searches TMDB for each show, then embeds + renames all selected episodes in one operation."/>
                    <Button Content="{DynamicResource Btn.BatchRename}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding BatchRenameOnlyCommand}"
                            ToolTip="Rename all selected files using the pattern. No metadata tags are written."
                            Padding="10,6" Margin="8,0,0,0"/>
                    <Button Content="✎ Batch Edit Fields"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding BatchEditFieldsCommand}"
                            Padding="10,6" Margin="8,0,0,0"
                            ToolTip="Apply one or more shared field values (Genre, Cast, Director, MPA, Year, Show title, Watched) across all selected files at once. Per-file values like Title, Episode and IDs are not changed. Revertible with ↩ Undo Batch."/>
                    <Button Content="{Binding CancelButtonLabel}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelOperationCommand}"
                            Padding="10,6" Margin="8,0,0,0"
                            Foreground="{DynamicResource ErrorBrush}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                </StackPanel>

                <!-- Theme toggle & close -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding ToggleThemeCommand}"
                            Content="{Binding IsDark, Converter={StaticResource ThemeIcon}}"
                            ToolTip="Toggle Dark/Light Theme"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- PROGRESS BAR (slim) -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <ProgressBar Grid.Row="1"
                     Value="{Binding ProgressValue}"
                     Maximum="100"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- MAIN CONTENT AREA -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="240" MaxWidth="480"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─────────────────────────────────────────────────────────────── -->
            <!-- LEFT PANEL — File List + Drop Zone -->
            <!-- ─────────────────────────────────────────────────────────────── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- File List -->
                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- List header -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource SurfaceAltBrush}"
                                Padding="12,8">
                            <Grid>
                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundMutedBrush}">
                                    <Run Text="FILES "/>
                                    <Run Text="{Binding Files.Count, StringFormat='({0})', Mode=OneWay}"/>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="{DynamicResource Files.Refresh}"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding RefreshFilesCommand}"
                                            Padding="6,3" FontSize="11"
                                            Margin="0,0,4,0"
                                            ToolTip="Re-read metadata from all loaded files"/>
                                    <Button Content="{DynamicResource Files.Clear}"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding ClearFilesCommand}"
                                            Padding="6,3" FontSize="11"/>
                                    <Button Content="⚠ Next Error"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding JumpToNextFailureCommand}"
                                            Padding="6,3" FontSize="11" Margin="4,0,0,0"
                                            Foreground="#E53935" FontWeight="SemiBold"
                                            ToolTip="Jump to next file with a write error"
                                            Visibility="{Binding HasAnyFailure, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- File items -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Files}"
                                 SelectedItem="{Binding SelectedFile}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 BorderThickness="0">
                            <!-- Row colour coding: green = written OK, pink = write failed, yellow = new watch-folder file -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="IsHitTestVisible" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding WriteStatus}"
                                                     Value="{x:Static models:WriteStatus.Success}">
                                            <Setter Property="Background" Value="#1800C800"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding WriteStatus}"
                                                     Value="{x:Static models:WriteStatus.Failed}">
                                            <Setter Property="Background" Value="#18FF2020"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsNewFile}" Value="True">
                                            <Setter Property="Background" Value="#28FFD700"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- Separator row: thin horizontal divider between file groups -->
                                    <Grid>
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="🔧 Remux to .mkv (fix tagging issues)"
                                                          Click="FilesRemuxToMkv_Click"
                                                          ToolTip="Losslessly rebuild this file as MKV. Fixes files that refuse metadata embedding. Original is kept."/>
                                                <MenuItem Header="🔧 Remux to .mp4 (fix + faststart)"
                                                          Click="FilesRemuxToMp4_Click"
                                                          ToolTip="Losslessly rebuild this file as MP4 with faststart. Original is kept."/>
                                                <Separator/>
                                                <MenuItem Header="🔧 Open in fallback app…"
                                                          Click="FilesOpenInFallback_Click"
                                                          ToolTip="Open this file in the fallback application (e.g. TagScanner, MediaInfo Lite) set in Settings → Write Error Diagnostics."/>
                                                <MenuItem Header="📂 Open containing folder"
                                                          Click="FilesOpenFolder_Click"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <!-- Normal file row — hidden when IsSeparator=true -->
                                        <Grid Margin="0"
                                              Visibility="{Binding IsSeparator, Converter={StaticResource InvBoolVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FilePath}"/>
                                                <!-- Parsed title + year detected from filename -->
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding ParsedTitle, Converter={StaticResource NullVis}}">
                                                    <TextBlock Text="{Binding ParsedTitle}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="160"/>
                                                    <TextBlock Text=" · "
                                                               FontSize="11"
                                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                                               Visibility="{Binding ParsedYear, Converter={StaticResource NullVis}}"/>
                                                    <TextBlock Text="{Binding ParsedYear}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                                               Visibility="{Binding ParsedYear, Converter={StaticResource NullVis}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                                            CornerRadius="3" Padding="4,1">
                                                        <TextBlock Text="{Binding Extension}"
                                                                   FontSize="10" FontWeight="Bold"
                                                                   Foreground="{DynamicResource AccentBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding FileSizeDisplay}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                                               Margin="6,0,0,0"/>
                                                    <!-- Match score badge -->
                                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                                            CornerRadius="3" Padding="4,1" Margin="6,0,0,0"
                                                            Visibility="{Binding MatchLabel, Converter={StaticResource NullVis}}">
                                                        <TextBlock Text="{Binding MatchLabel}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                                    </Border>
                                                    <!-- Watched badge -->
                                                    <Border Background="{DynamicResource PrimaryBrush}"
                                                            CornerRadius="3" Padding="4,1" Margin="6,0,0,0"
                                                            Visibility="{Binding IsWatched, Converter={StaticResource BoolVis}}"
                                                            Opacity="0.7">
                                                        <TextBlock Text="watched" FontSize="10" Foreground="White"/>
                                                    </Border>
                                                    <!-- Progress badge — shows % when in-progress (Trakt playback progress) -->
                                                    <Border Background="{DynamicResource AccentBrush}"
                                                            CornerRadius="3" Padding="4,1" Margin="4,0,0,0"
                                                            Opacity="0.75"
                                                            Visibility="{Binding ProgressLabel, Converter={StaticResource NullVis}}">
                                                        <TextBlock Text="{Binding ProgressLabel}"
                                                                   FontSize="10" Foreground="White"/>
                                                    </Border>
                                                    <!-- Remux candidate badge -->
                                                    <Border Background="{DynamicResource AccentBrush}"
                                                            CornerRadius="3" Padding="4,1" Margin="6,0,0,0"
                                                            Visibility="{Binding IsRemuxCandidate, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="REMUXED" FontSize="10" FontWeight="Bold"
                                                                   Foreground="White"/>
                                                    </Border>
                                                    <!-- Disk-verified badge — "what's actually on disk" signal.
                                                         Green ✓ = post-embed disk re-read matched the intended write;
                                                         amber ⚠ = written but the disk re-read did not match. -->
                                                    <Border CornerRadius="3" Padding="4,1" Margin="6,0,0,0"
                                                            Visibility="{Binding DiskVerifiedDisplay, Converter={StaticResource NullVis}}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DiskVerified}" Value="True">
                                                                        <Setter Property="Background" Value="#2E7D32"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding DiskVerified}" Value="False">
                                                                        <Setter Property="Background" Value="#B26A00"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding DiskVerifiedDisplay}"
                                                                   FontSize="10" Foreground="White"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                        <!-- Status + Lock icons (right column) -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="4,0,0,0">
                                            <!-- Lock toggle icon -->
                                            <TextBlock Text="{Binding LockIcon}"
                                                       FontSize="13"
                                                       ToolTip="{Binding LockToolTip}"
                                                       Cursor="Hand"
                                                       Margin="0,0,4,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- Embed status icon -->
                                            <TextBlock FontSize="14" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value=""/>
                                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                                <Setter Property="Text" Value="⏳"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                <Setter Property="Text" Value="✅"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                <Setter Property="Text" Value="❌"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                    <!-- ── Separator row ── shown only when IsSeparator=true -->
                                    <Border Height="10" Margin="4,2"
                                            Visibility="{Binding IsSeparator, Converter={StaticResource BoolVis}}">
                                        <Line X1="0" Y1="5" X2="10000" Y2="5"
                                              Stroke="{DynamicResource BorderBrush}"
                                              StrokeThickness="1"
                                              StrokeDashArray="4,3"
                                              Opacity="0.5"
                                              HorizontalAlignment="Stretch"/>
                                    </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty-state / drop zone overlay -->
                        <Border Grid.Row="1"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="8"
                                Margin="12"
                                Padding="12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Files.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="⬆" FontSize="36" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                <TextBlock Text="Drop video files here"
                                           FontSize="14" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                           Margin="0,6,0,2"/>
                                <TextBlock Text="or use Add Files / Add Folder above"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                <TextBlock Text="MP4 · MKV · MOV · WMV · M4V · WebM"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Remove / Delete buttons -->
                <Grid Grid.Row="1" Margin="8,4,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Row 1: Remove + Delete -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="↩ Remove from List"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding RemoveFileCommand}"
                                Padding="10,7"
                                ToolTip="Remove from list without deleting the file"/>
                        <Button Grid.Column="2"
                                Content="🗑 Delete File"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding DeleteFileCommand}"
                                Padding="10,7"
                                Foreground="{DynamicResource ErrorBrush}"
                                ToolTip="Permanently delete the file from disk"/>
                    </Grid>
                    <!-- Row 2: Undo + Toggle Watched -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="↺ Undo Last Embed"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding UndoLastEmbedCommand}"
                                Padding="10,7"
                                ToolTip="Restore this file to its state before the last embed or rename"/>
                        <Button Grid.Column="2"
                                Content="{Binding SelectedFile.IsWatched, Converter={StaticResource BoolToWatchedLabel}}"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding ToggleWatchedCommand}"
                                Padding="10,7"
                                ToolTip="Toggle ♥ Watched / Unwatched — syncs to Trakt if connected"/>
                    </Grid>
                    <!-- Row 5: Rename Only -->
                    <Button Grid.Row="5"
                            Content="✏ Rename File Only"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RenameCurrentFileCommand}"
                            Padding="10,7"
                            HorizontalAlignment="Stretch"
                            ToolTip="Rename using the current pattern without embedding any metadata tags"/>
                    <!-- Row 6: Undo Batch + watched selectors -->
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="↩ Undo Batch"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding UndoBatchCommand}"
                                Padding="8,5" FontSize="11"
                                ToolTip="Revert all files that succeeded in the last Batch Process to their pre-batch state"/>
                        <Button Grid.Column="2"
                                Content="🎬 Select Unwatched"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding SelectUnwatchedCommand}"
                                Padding="8,5" FontSize="11"/>
                        <Button Grid.Column="4"
                                Content="✓ Select Watched"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding SelectWatchedCommand}"
                                Padding="8,5" FontSize="11"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- ─────────────────────────────────────────────────────────────── -->
            <!-- RIGHT PANEL — Tabs -->
            <!-- ─────────────────────────────────────────────────────────────── -->
            <Grid Grid.Column="2">
                <!-- Format warning banner -->
                <Border x:Name="WarningBanner"
                        Background="{DynamicResource WarningBrush}"
                        Padding="12,6"
                        VerticalAlignment="Top"
                        Panel.ZIndex="10"
                        Visibility="{Binding FormatWarning, Converter={StaticResource NullVis}}">
                    <TextBlock Text="{Binding FormatWarning}"
                               Foreground="White" FontSize="12" FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                </Border>

                <TabControl x:Name="MainTabControl"
                            SelectedIndex="{Binding SelectedTabIndex}"
                            Margin="0,0,0,0">
                    <TabControl.Resources>
                        <Style TargetType="TabPanel">
                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                        </Style>
                    </TabControl.Resources>

                    <!-- ══════════════════════════════════════════════════════ -->
                    <!-- TAB 1 — RAW DATA (embedded + edit) -->
                    <!-- ══════════════════════════════════════════════════════ -->
                    <TabItem Header="{DynamicResource Tab.RawData}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="20" MaxWidth="980">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Metadata form -->
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">

                                    <TextBlock Text="Embedded Metadata"
                                               Style="{StaticResource SectionHeader}"/>

                                    <!-- Original Filename (read-only, always shows the on-disk name) -->
                                    <TextBlock Text="ORIGINAL FILENAME" Style="{StaticResource LabelText}"/>
                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="8,7"
                                            Margin="0,0,0,12">
                                        <TextBlock Text="{Binding OriginalFileName}"
                                                   FontSize="12"
                                                   FontFamily="Consolas"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding OriginalFileName}"/>
                                    </Border>

                                    <!-- Filename parse result banner -->
                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="0,0,0,2"
                                            CornerRadius="6" Padding="10,7"
                                            Margin="0,0,0,12"
                                            Visibility="{Binding ParsedFileInfo, Converter={StaticResource NullVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🎯 " FontSize="13"/>
                                            <TextBlock Text="{Binding ParsedFileInfo}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Content type toggle -->
                                    <Border Margin="0,0,0,12" Padding="10,8"
                                            Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                                       Text="CONTENT TYPE"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <RadioButton Content="🎬 Movie"
                                                             IsChecked="{Binding IsEpisodeMode, Converter={StaticResource InvertBool}}"
                                                             GroupName="ContentType"
                                                             VerticalAlignment="Center"
                                                             FontSize="12" Margin="0,0,12,0"
                                                             ToolTip="Treat this file as a movie"/>
                                                <RadioButton Content="📺 TV Episode"
                                                             IsChecked="{Binding IsEpisodeMode}"
                                                             GroupName="ContentType"
                                                             VerticalAlignment="Center"
                                                             FontSize="12"
                                                             ToolTip="Treat this file as a TV series episode — reveals episode-specific fields"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- TV Episode fields (visible only in TV mode) -->
                                    <StackPanel Visibility="{Binding IsEpisodeMode, Converter={StaticResource BoolVis}}"
                                                Margin="0,0,0,0">

                                        <TextBlock Text="SHOW TITLE" Style="{StaticResource LabelText}"/>
                                        <TextBox Text="{Binding EditingMetadata.ShowTitle, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,12"
                                                 ToolTip="The series name, e.g. Batman: The Animated Series"/>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="SEASON" Style="{StaticResource LabelText}"/>
                                                <TextBox Text="{Binding EditingMetadata.Season, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                         ToolTip="Season number (e.g. 1)"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="EPISODE" Style="{StaticResource LabelText}"/>
                                                <TextBox Text="{Binding EditingMetadata.Episode, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                         ToolTip="Episode number within the season (e.g. 5)"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="AIRED DATE" Style="{StaticResource LabelText}"/>
                                                <TextBox Text="{Binding EditingMetadata.AiredDate, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Original air date (YYYY-MM-DD)"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="EPISODE TITLE" Style="{StaticResource LabelText}"/>
                                        <TextBox Text="{Binding EditingMetadata.EpisodeTitle, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,12"
                                                 ToolTip="Individual episode title, e.g. On Leather Wings"/>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="TVDB ID" Style="{StaticResource LabelText}"/>
                                                <TextBox Text="{Binding EditingMetadata.TvdbId, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="TheTVDB series ID (optional, used by Jellyfin/Kodi)"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="TMDB SERIES ID" Style="{StaticResource LabelText}"/>
                                                <TextBox Text="{Binding EditingMetadata.TmdbSeriesId, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="TMDB series ID (distinct from the episode's TMDB ID)"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- TV rename pattern hint -->
                                        <TextBlock FontSize="11" Margin="0,0,0,12"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   TextWrapping="Wrap">
                                            💡 Suggested TV rename pattern:
                                            <Run Text="{Binding TvRenamePatternSuggestion, Mode=OneWay}"
                                                 FontFamily="Consolas" FontSize="11"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Title — label changes in TV mode -->
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
                                                <Setter Property="Text" Value="TITLE"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEpisodeMode}" Value="True">
                                                        <Setter Property="Text" Value="EPISODE TITLE (for tags) / TITLE"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox Text="{Binding EditingMetadata.Title, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,12"/>

                                    <!-- Year -->
                                    <TextBlock Text="RELEASE YEAR" Style="{StaticResource LabelText}"/>
                                    <TextBox Text="{Binding EditingMetadata.Year, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,12" MaxLength="4"/>

                                    <!-- Genre -->
                                    <TextBlock Text="GENRE" Style="{StaticResource LabelText}"/>
                                    <TextBox Text="{Binding EditingMetadata.Genre, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding FormatSupportsFullTags}"
                                             Margin="0,0,0,12"/>

                                    <!-- Director -->
                                    <TextBlock Text="DIRECTOR" Style="{StaticResource LabelText}"/>
                                    <TextBox Text="{Binding EditingMetadata.Director, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding FormatSupportsFullTags}"
                                             Margin="0,0,0,12"/>

                                    <!-- Cast -->
                                    <TextBlock Text="FULL CAST (comma-separated)" Style="{StaticResource LabelText}"/>
                                    <TextBox Text="{Binding EditingMetadata.Cast, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding FormatSupportsFullTags}"
                                             AcceptsReturn="False"
                                             TextWrapping="Wrap"
                                             Height="72"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,0,0,12"/>

                                    <!-- Rating -->
                                    <TextBlock Text="IMDB RATING" Style="{StaticResource LabelText}"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding EditingMetadata.Rating, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}"
                                                 ToolTip="IMDB rating 0.0 – 10.0 (e.g. 7.3)"
                                                 Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding EditingMetadata.StarDisplay}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Visibility="{Binding EditingMetadata.StarDisplay, Converter={StaticResource NullVis}}"/>
                                        <Border Grid.Column="2"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="4"
                                                Padding="2,0" Margin="8,0,0,0"
                                                MinHeight="32"
                                                VerticalAlignment="Stretch"
                                                ToolTip="MPA Content Rating — pick from list or type a custom value (e.g. TV-MA, M, 18+)">
                                            <ComboBox IsEditable="True"
                                                      Text="{Binding EditingMetadata.MpaRating, UpdateSourceTrigger=LostFocus}"
                                                      BorderThickness="0"
                                                      Background="Transparent"
                                                      MinWidth="90"
                                                      FontSize="13" FontWeight="SemiBold"
                                                      VerticalContentAlignment="Center"
                                                      Foreground="{DynamicResource ForegroundBrush}">
                                                <!-- Theatrical -->
                                                <ComboBoxItem Content="G"/>
                                                <ComboBoxItem Content="PG"/>
                                                <ComboBoxItem Content="PG-13"/>
                                                <ComboBoxItem Content="R"/>
                                                <ComboBoxItem Content="NC-17"/>
                                                <ComboBoxItem Content="NR"/>
                                                <!-- TV -->
                                                <ComboBoxItem Content="TV-Y"/>
                                                <ComboBoxItem Content="TV-Y7"/>
                                                <ComboBoxItem Content="TV-G"/>
                                                <ComboBoxItem Content="TV-PG"/>
                                                <ComboBoxItem Content="TV-14"/>
                                                <ComboBoxItem Content="TV-MA"/>
                                                <!-- International commonly seen -->
                                                <ComboBoxItem Content="U"/>
                                                <ComboBoxItem Content="12"/>
                                                <ComboBoxItem Content="12A"/>
                                                <ComboBoxItem Content="15"/>
                                                <ComboBoxItem Content="18"/>
                                                <ComboBoxItem Content="M"/>
                                                <ComboBoxItem Content="MA15+"/>
                                                <ComboBoxItem Content="R18+"/>
                                            </ComboBox>
                                        </Border>
                                    </Grid>

                                    <!-- Description -->
                                    <TextBlock Text="DESCRIPTION / SYNOPSIS" Style="{StaticResource LabelText}"/>
                                    <TextBox Text="{Binding EditingMetadata.Description, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Height="90"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,0,0,12"/>

                                    <!-- IDs -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="IMDB ID" Style="{StaticResource LabelText}"/>
                                            <TextBox Text="{Binding EditingMetadata.ImdbId, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="TMDB ID" Style="{StaticResource LabelText}"/>
                                            <TextBox Text="{Binding EditingMetadata.TmdbId, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Rename preview -->
                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            CornerRadius="6" Padding="12,8" Margin="0,4,0,12">
                                        <StackPanel>
                                            <TextBlock Text="RENAME PREVIEW" Style="{StaticResource LabelText}" Margin="0"/>
                                            <TextBlock Text="{Binding RenamePreview}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Read-only warning banner -->
                                    <Border Background="{DynamicResource ErrorBrush}"
                                            CornerRadius="6" Padding="12,7" Margin="0,0,0,8"
                                            Visibility="{Binding SelectedFileIsReadOnly, Converter={StaticResource BoolVis}}">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🔒" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="File is locked (read-only)"
                                                               FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                                    <TextBlock Text="Click Unlock — the app will auto-clear the attribute and stop the preview player."
                                                               FontSize="11" Foreground="#DDFFFFFF"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button HorizontalAlignment="Right"
                                                    Content="{DynamicResource Btn.Unlock}"
                                                    Command="{Binding ToggleLockCommand}"
                                                    Padding="12,5" FontSize="12"
                                                    Foreground="White" FontWeight="SemiBold"
                                                    Background="#30FFFFFF" BorderThickness="0"
                                                    Cursor="Hand" VerticalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#50FFFFFF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Action buttons (WrapPanel so they reflow to a second
                                         row instead of clipping when the window is narrow) -->
                                    <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Content="📄 Export NFO"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding ExportNfoCommand}"
                                                Padding="10,6" Margin="0,0,6,6"
                                                ToolTip="Export Kodi/Plex compatible .nfo sidecar file alongside this video. All selected files in the Files panel will be exported."/>
                                        <Button Content="🖼 Export Artwork"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding ExportArtworkCommand}"
                                                Padding="10,6" Margin="0,0,6,6"
                                                ToolTip="Write the poster as a sidecar image (e.g. Movie-poster.jpg, or poster.jpg in folder style) next to each selected video, for Plex/Jellyfin/Kodi to read from disk. Naming style is set in Settings → 🖼 Artwork Export. Artwork is taken from the loaded metadata, the embedded tag, or downloaded via TMDB."/>
                                        <Button Content="📥 Import NFO"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding ImportNfoCommand}"
                                                Padding="10,6" Margin="0,0,6,6"
                                                ToolTip="Read the .nfo sidecar next to each selected video and load its metadata into the editable fields for review. Nothing is written to the file until you click Apply + Embed. Reads Kodi/Plex/Jellyfin NFOs including legacy ID and rating formats."/>
                                        <Button Content="💾 Apply + Embed + Rename"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding ApplyMetadataCommand}"
                                                Margin="0,0,6,6"
                                                ToolTip="Embed the fields shown above into the file and rename it"/>
                                        <!-- Warning when auto-rename is off —only affects Batch operations -->
                                        <TextBlock Text="ⓘ Auto-rename is OFF — Batch Process and Watch Folder will not rename files. Manual rename buttons still work."
                                                   FontSize="11" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource WarningBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AutoRenameEnabled}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Content="✏ Rename Only"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding RenameCurrentFileCommand}"
                                                ToolTip="Rename this file using the current pattern without embedding any metadata tags"
                                                Margin="0,0,6,6"/>

                                        <Button Content="📋 Use Retrieved"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding ApplyRetrievedCommand}"
                                                ToolTip="Copy metadata from Retrieved Data tab into this form"
                                                Margin="0,0,6,6"/>
                                        <!-- Lock / Unlock toggle for current file -->
                                        <Button Command="{Binding ToggleLockCommand}"
                                                Margin="0,0,6,6" Padding="10,7"
                                                ToolTip="{Binding SelectedFile.LockToolTip}"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                    <Setter Property="Content" Value="🔓 Unlocked"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedFileIsReadOnly}" Value="True">
                                                            <Setter Property="Content" Value="🔒 Locked"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Right: Artwork + Media Player + Technical Info -->
                                <StackPanel Grid.Column="1">

                                    <!-- ── Cover Artwork ─────────────────────── -->
                                    <TextBlock Text="COVER ARTWORK" Style="{StaticResource LabelText}"/>

                                    <Border Width="200" Height="200"
                                            Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="2"
                                            CornerRadius="8"
                                            AllowDrop="True"
                                            Drop="Artwork_Drop"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="Artwork_Click"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Image Source="{Binding ArtworkImage}"
                                                   Stretch="UniformToFill"
                                                   StretchDirection="DownOnly"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="🖼&#x0A;Drop image&#x0A;or click"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                                       FontSize="12"
                                                       Visibility="{Binding ArtworkImage, Converter={StaticResource NullCol}}"/>
                                        </Grid>
                                    </Border>

                                    <Grid Margin="0,0,0,2" Width="200">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Content="📁 Browse Image"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding PickArtworkCommand}"
                                                IsEnabled="{Binding FormatSupportsArtwork}"/>
                                        <Button Grid.Column="2"
                                                Content="📋"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding CopyArtworkToClipboardCommand}"
                                                Padding="8,7"
                                                FontSize="14"
                                                ToolTip="Copy cover art to clipboard"/>
                                    </Grid>

                                    <TextBlock Text="Not supported for this format"
                                               FontSize="11"
                                               Foreground="{DynamicResource WarningBrush}"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding FormatSupportsArtwork, Converter={StaticResource InvBoolVis}}"/>

                                    <TextBlock Text="Auto-compressed to 500px JPEG 85%"
                                               FontSize="10"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Width="200"
                                               Margin="0,4,0,12"/>

                                    <!-- ── Mini Media Player ─────────────────── -->
                                    <TextBlock Text="PREVIEW" Style="{StaticResource LabelText}"
                                               Visibility="{Binding SelectedFile, Converter={StaticResource NullVis}}"/>

                                    <Border Width="200"
                                            Background="Black"
                                            CornerRadius="6"
                                            ClipToBounds="True"
                                            Margin="0,0,0,0"
                                            Visibility="{Binding SelectedFile, Converter={StaticResource NullVis}}">
                                        <Grid>
                                            <!-- Media element -->
                                            <MediaElement x:Name="PreviewPlayer"
                                                          Width="200" Height="112"
                                                          Stretch="Uniform"
                                                          LoadedBehavior="Manual"
                                                          UnloadedBehavior="Stop"
                                                          Volume="0.7"/>

                                            <!-- Poster/play overlay when not playing -->
                                            <Border Background="#CC000000"
                                                    Visibility="{Binding IsPreviewPlaying, Converter={StaticResource InvBoolVis}}">
                                                <TextBlock Text="▶"
                                                           FontSize="28"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.8"/>
                                            </Border>

                                            <!-- Click overlay -->
                                            <Border Background="Transparent"
                                                    Cursor="Hand"
                                                    MouseLeftButtonUp="PreviewPlayer_Click"
                                                    ToolTip="Click to play / pause"/>
                                        </Grid>
                                    </Border>

                                    <!-- Player controls — same 200px width as Browse Image -->
                                    <Grid Width="200" Margin="0,4,0,12"
                                          Visibility="{Binding SelectedFile, Converter={StaticResource NullVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                x:Name="PlayPauseBtn"
                                                Content="▶ Play"
                                                Style="{StaticResource SecondaryButton}"
                                                FontSize="11" Padding="0,7"
                                                HorizontalContentAlignment="Center"
                                                Click="PlayPause_Click"/>
                                        <Button Grid.Column="2"
                                                Content="⏹"
                                                Style="{StaticResource SecondaryButton}"
                                                FontSize="12" Padding="0,7"
                                                HorizontalContentAlignment="Center"
                                                Click="StopPreview_Click"
                                                ToolTip="Stop"/>
                                        <Button Grid.Column="4"
                                                Content="⧉"
                                                Style="{StaticResource SecondaryButton}"
                                                FontSize="13" Padding="0,7"
                                                HorizontalContentAlignment="Center"
                                                Click="PopoutPreview_Click"
                                                ToolTip="Pop out into a floating window"/>
                                    </Grid>

                                    <!-- ── Technical Info Panel ──────────────── -->
                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            Width="200"
                                            Visibility="{Binding MediaInfo, Converter={StaticResource NullVis}}">
                                        <StackPanel>
                                            <!-- File size + duration + container -->
                                            <TextBlock Text="{Binding MediaInfo.VideoLine}"
                                                       FontSize="10"
                                                       FontFamily="Consolas"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,3"/>
                                            <!-- Video codec + resolution -->
                                            <TextBlock Text="{Binding MediaInfo.VideoCodecLine}"
                                                       FontSize="10"
                                                       FontFamily="Consolas"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,3"
                                                       Visibility="{Binding MediaInfo.VideoCodecLine, Converter={StaticResource NullVis}}"/>
                                            <!-- Audio codec + channels + kHz + kbps -->
                                            <TextBlock Text="{Binding MediaInfo.AudioLine}"
                                                       FontSize="10"
                                                       FontFamily="Consolas"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding MediaInfo.AudioLine, Converter={StaticResource NullVis}}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- ── Remux candidate actions (only for *.remux.* files) ── -->
                                    <!-- Positioned below the technical info so it reads as an action -->
                                    <!-- on the file whose details are shown above. -->
                                    <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6"
                                            Width="200"
                                            Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1"
                                            Visibility="{Binding SelectedFile.IsRemuxCandidate, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                        <StackPanel>
                                            <TextBlock Text="🔧 REMUXED COPY"
                                                       FontWeight="Bold" FontSize="11"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,8"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}">
                                                This is a clean remuxed copy created to fix embedding.
                                                Test it / try embedding metadata, then choose. Nothing is
                                                deleted until you click one of these.
                                            </TextBlock>
                                            <Button Content="✓ Replace Original"
                                                    Click="ReplaceOriginal_Click"
                                                    Margin="0,0,0,4" Padding="0,7"
                                                    HorizontalContentAlignment="Center"
                                                    ToolTip="Delete the original and keep this remuxed copy (renamed to the original's name). Original goes to Recycle Bin.">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                        <Setter Property="Background" Value="#2E7D32"/>
                                                        <Setter Property="BorderBrush" Value="#1B5E20"/>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="↩ Restore Original"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Click="RestoreOriginal_Click"
                                                    Padding="0,7" HorizontalContentAlignment="Center"
                                                    ToolTip="Discard this remuxed copy and keep the original unchanged. The remux goes to Recycle Bin."/>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ══════════════════════════════════════════════════════ -->
                    <!-- TAB 2 — RETRIEVED DATA (API search) -->
                    <!-- ══════════════════════════════════════════════════════ -->
                    <TabItem Header="{DynamicResource Tab.RetrievedData}">
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Search controls -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Title search -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             conv:WatermarkHelper.Watermark="Search by movie title…"
                                             KeyDown="SearchBox_KeyDown"/>
                                    <Button Grid.Column="2"
                                            Content="🔍 Search"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding SearchApiCommand}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>
                                </Grid>

                                <!-- ID lookup -->
                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding IdLookup, UpdateSourceTrigger=PropertyChanged}"
                                             conv:WatermarkHelper.Watermark="Lookup by IMDB ID (tt0111161) or TMDB ID (278)"
                                             KeyDown="IdBox_KeyDown"/>
                                    <Button Grid.Column="2"
                                            Content="🎯 Lookup ID"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding LookupByIdCommand}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>
                                </Grid>

                                <!-- Refine-by-ID tip: shown when IMDB or TMDB ID is entered in Raw Data -->
                                <Border Grid.Row="2"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource PrimaryBrush}"
                                        BorderThickness="0,0,0,2"
                                        CornerRadius="5" Padding="10,6"
                                        Visibility="{Binding HasIdRefinement, Converter={StaticResource BoolVis}}">
                                    <TextBlock FontSize="12" TextWrapping="Wrap">
                                        <Run Text="🔎 ID refinement active — " Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"/>
                                        <Run Text="{Binding IdRefinementHint, Mode=OneWay}" Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                        <Run Text=" Click Search to use it." Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                    </TextBlock>
                                </Border>
                            </Grid>

                            <!-- Results split -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Search result list -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Text="SEARCH RESULTS"
                                               Style="{StaticResource LabelText}"
                                               Margin="0,0,0,6"/>
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding SearchResults}"
                                             SelectedItem="{Binding SelectedSearchResult}"
                                             SelectionChanged="SearchResults_SelectionChanged"
                                             PreviewMouseLeftButtonDown="SearchResults_PreviewMouseDown">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayText}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ImdbId}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Grid.Row="2"
                                            Content="↓ Load More Results"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding LoadMoreResultsCommand}"
                                            Margin="0,4,0,0" Padding="8,5" FontSize="11"
                                            Visibility="{Binding HasMoreResults, Converter={StaticResource BoolVis}}"/>
                                    <Button Grid.Row="3"
                                            Content="✕ Clear Results"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding ClearSearchCommand}"
                                            Margin="0,4,0,0" Padding="8,5" FontSize="11"
                                            Visibility="{Binding SearchResults.Count, Converter={StaticResource NullVis}}"/>
                                </Grid>

                                <!-- Detail panel -->
                                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                    <Grid>
                                        <!-- No metadata placeholder -->
                                        <TextBlock Text="Select a search result to view details"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   FontSize="14"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding RetrievedMetadata, Converter={StaticResource NullCol}}"/>

                                        <!-- ── TV Season / Episode Picker — Step 1 ─────────── -->
                                        <Border Margin="0,0,16,12"
                                                Padding="12,10"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource AccentBrush}"
                                                BorderThickness="1" CornerRadius="6"
                                                Visibility="{Binding IsTvPickerVisible, Converter={StaticResource BoolVis}}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding TvPickerShowTitle}"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ForegroundBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="1" Content="✕"
                                                            Command="{Binding HideTvPickerCommand}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="6,2" FontSize="11"
                                                            ToolTip="Close picker"/>
                                                </Grid>

                                                <TextBlock Text="SELECT SEASON" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding TvSeasonNumbers}"
                                                          SelectedItem="{Binding TvSelectedSeason}"
                                                          Margin="0,0,0,10"
                                                          HorizontalAlignment="Left" Width="120">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding StringFormat='Season {0}'}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>

                                                <!-- Direct S##E## entry — jump to any episode without scrolling -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="Jump to episode:" VerticalAlignment="Center"
                                                               Margin="0,0,8,0" FontSize="12"
                                                               Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                                    <TextBox x:Name="DirectEpisodeBox"
                                                             Width="100" FontSize="13" Padding="4,3"
                                                             Text="{Binding DirectEpisodeEntry, UpdateSourceTrigger=PropertyChanged}"
                                                             KeyDown="DirectEpisodeBox_KeyDown"
                                                             ToolTip="Type S01E02 or just 2 and press Enter"/>
                                                    <TextBlock Text="(e.g. S01E02 or just 2)"
                                                               VerticalAlignment="Center"
                                                               Margin="6,0,0,0" FontSize="11"
                                                               Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                                </StackPanel>

                                                <TextBlock Text="SELECT EPISODE" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding TvEpisodeItems}"
                                                          SelectedItem="{Binding TvSelectedEpisode}"
                                                          DisplayMemberPath="DisplayText"
                                                          Margin="0,0,0,10"
                                                          HorizontalAlignment="Stretch"/>

                                                <!-- Episode preview -->
                                                <TextBlock Text="{Binding TvSelectedEpisode.AirDate, StringFormat='Aired: {0}'}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                                           Margin="0,0,0,4"
                                                           Visibility="{Binding TvSelectedEpisode.AirDate, Converter={StaticResource NullVis}}"/>
                                                <TextBlock Text="{Binding TvSelectedEpisode.Overview}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="60"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,0,10"
                                                           Visibility="{Binding TvSelectedEpisode.Overview, Converter={StaticResource NullVis}}"/>

                                                <Button HorizontalAlignment="Left" Padding="12,7">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"/>
                                                    </Button.Style>
                                                    <Button.Content>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="① " FontWeight="SemiBold"/>
                                                            <TextBlock Text="Load This Episode"/>
                                                        </StackPanel>
                                                    </Button.Content>
                                                    <Button.Command>
                                                        <Binding Path="PickTvEpisodeCommand"/>
                                                    </Button.Command>
                                                    <Button.IsEnabled>
                                                        <Binding Path="CanPickTvEpisode"/>
                                                    </Button.IsEnabled>
                                                </Button>
                                            </StackPanel>
                                        </Border>


                                        <!-- Retrieved metadata detail — hidden when TV picker is open -->
                                        <StackPanel Margin="16,0,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <!-- Hide when no result loaded -->
                                                        <DataTrigger Binding="{Binding RetrievedMetadata}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <!-- Hide when TV picker is open -->
                                                        <DataTrigger Binding="{Binding IsTvPickerVisible}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding RetrievedMetadata.Title}"
                                                               FontSize="20" FontWeight="Bold"
                                                               Foreground="{DynamicResource ForegroundBrush}"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding RetrievedMetadata.Year}"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                                               Margin="0,2,0,8"/>

                                                    <!-- Source links -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                        <TextBlock Visibility="{Binding RetrievedMetadata.TmdbUrl, Converter={StaticResource NullVis}}">
                                                            <Hyperlink NavigateUri="{Binding RetrievedMetadata.TmdbUrl}" RequestNavigate="Hyperlink_RequestNavigate">
                                                                View on TMDB ↗
                                                            </Hyperlink>
                                                        </TextBlock>
                                                        <TextBlock Visibility="{Binding RetrievedMetadata.ImdbUrl, Converter={StaticResource NullVis}}">
                                                            <Hyperlink NavigateUri="{Binding RetrievedMetadata.ImdbUrl}" RequestNavigate="Hyperlink_RequestNavigate">
                                                                View on IMDb ↗
                                                            </Hyperlink>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding RetrievedMetadata.Genre}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               Margin="0,0,0,4"/>
                                                    <!-- Rating stars + MPA badge -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                                                Visibility="{Binding RetrievedMetadata.StarDisplay, Converter={StaticResource NullVis}}">
                                                        <TextBlock Text="{Binding RetrievedMetadata.StarDisplay}"
                                                                   FontSize="14"
                                                                   Foreground="#F5C518"
                                                                   VerticalAlignment="Center"
                                                                   ToolTip="IMDB Rating"/>
                                                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1" CornerRadius="4"
                                                                Padding="6,2" Margin="10,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding RetrievedMetadata.MpaRatingDisplay, Converter={StaticResource NullVis}}"
                                                                ToolTip="MPA Content Rating">
                                                            <TextBlock Text="{Binding RetrievedMetadata.MpaRatingDisplay}"
                                                                       FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Image Grid.Column="1"
                                                       Source="{Binding RetrievedMetadata.ArtworkBytes, Converter={StaticResource BytesToImg}}"
                                                       Height="140" Width="100"
                                                       Stretch="UniformToFill"
                                                       HorizontalAlignment="Right"/>
                                            </Grid>

                                            <TextBlock Text="DIRECTOR" Style="{StaticResource LabelText}"/>
                                            <TextBlock Text="{Binding RetrievedMetadata.Director}"
                                                       Style="{StaticResource BaseText}"
                                                       Margin="0,0,0,10"/>

                                            <TextBlock Text="CAST" Style="{StaticResource LabelText}"/>
                                            <TextBlock Text="{Binding RetrievedMetadata.Cast}"
                                                       Style="{StaticResource BaseText}"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="120"
                                                       Margin="0,0,0,10"/>

                                            <TextBlock Text="SYNOPSIS" Style="{StaticResource LabelText}"/>
                                            <TextBlock Text="{Binding RetrievedMetadata.Description}"
                                                       Style="{StaticResource BaseText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,16"/>

                                            <Button Content="⬇ Apply to Raw Data Tab"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding ApplyRetrievedCommand}"
                                                    HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>

                            <!-- Console / log -->
                            <Expander Grid.Row="2" Header="📋 Processing Log" Margin="0,12,0,0">
                                <ListBox ItemsSource="{Binding ConsoleLog}"
                                         Height="120"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         Background="{DynamicResource InputBackgroundBrush}"
                                         Foreground="{DynamicResource AccentBrush}"/>
                            </Expander>

                            <!-- ── Subtitles ──────────────────────────────────── -->
                            <Expander Grid.Row="3"
                                      Header="🗒 Subtitles"
                                      Margin="0,12,0,0"
                                      IsExpanded="False">
                                <StackPanel Margin="0,8,0,0">
                                    <!-- Language filter + search -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding SubtitleSearchLanguages, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12"
                                                 ToolTip="Language codes, comma-separated (e.g. en, fr, de). Leave blank for all languages."/>
                                        <Button Grid.Column="2"
                                                Content="🔍 Search"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding SearchSubtitlesCommand}"
                                                Padding="12,6"
                                                IsEnabled="{Binding IsSearchingSubtitles, Converter={StaticResource InvBool}}"/>
                                        <Button Grid.Column="4"
                                                Content="✕ Clear"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding ClearSubtitleResultsCommand}"
                                                Padding="10,6"/>
                                    </Grid>

                                    <!-- Results list -->
                                    <ListBox ItemsSource="{Binding SubtitleSearchResults}"
                                             SelectedItem="{Binding SelectedSubtitleResult}"
                                             Height="160"
                                             Margin="0,0,0,8"
                                             BorderThickness="1"
                                             Background="{DynamicResource InputBackgroundBrush}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="4,2">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold"
                                                               Text="{Binding FileName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding LanguageName}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding Format}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                                   Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding DownloadCount, StringFormat='{}{0} downloads'}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                                        <TextBlock Text=" · HI"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                                   Visibility="{Binding HearingImpaired, Converter={StaticResource BoolVis}}"/>
                                                        <TextBlock Text=" · Forced"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                                   Visibility="{Binding ForeignPartsOnly, Converter={StaticResource BoolVis}}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Download + status -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Content="⬇ Download Selected"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding DownloadSubtitleCommand}"
                                                Padding="12,6"
                                                Margin="0,0,8,0"
                                                ToolTip="Download the selected subtitle and save it alongside the video file"/>
                                        <TextBlock Text="{Binding SubtitleDownloadStatus}"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Requires OpenSubtitles API key in Settings → Metadata &amp; APIs"
                                               FontSize="10"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Expander>
                        </Grid>
                    </TabItem>

                    <!-- ══════════════════════════════════════════════════════ -->
                    <!-- TAB 5 — MOVE / COPY -->
                    <!-- ══════════════════════════════════════════════════════ -->
                    <TabItem Header="{DynamicResource Tab.MoveCopy}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="24,20">

                                <TextBlock Text="Move or Copy Selected Files"
                                           Style="{StaticResource SectionHeader}"/>

                                <!-- Engine status -->
                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="12,8" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="⚡" FontSize="18"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DetectedEngineText}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                
                                                
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource ForegroundMutedBrush}">
                                                    <Run Text="FastCopy:"/>
                                                </TextBlock>
                                                <TextBlock Margin="4,0,0,0" FontSize="11" FontWeight="SemiBold"
                                                           Text="{Binding FastCopyDetected, Converter={StaticResource BoolToStringDetected}, Mode=OneWay}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Destination folder -->
                                <TextBlock Text="DESTINATION FOLDER" Style="{StaticResource LabelText}"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding CopyDestination, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,8,0"
                                             conv:WatermarkHelper.Watermark="Select or type destination folder path…"/>
                                    <Button Grid.Column="1"
                                            Content="📁 Browse"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding BrowseCopyDestCommand}"
                                            Padding="12,7"/>
                                </Grid>

                                <!-- Disk space status — auto-shown when transfer is started -->
                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="10,7" Margin="0,0,0,16"
                                        Visibility="{Binding DiskSpaceStatus, Converter={StaticResource NullVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💾 " FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DiskSpaceStatus}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- ── Smart Organisation Banner ──────────────────── -->
                                <Border Margin="0,0,0,16"
                                        Padding="12,10"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1" CornerRadius="6"
                                        Visibility="{Binding SmartOrganiseEnabled, Converter={StaticResource BoolVis}}">
                                    <StackPanel>
                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Margin="0,0,0,6">
                                            🗂 Smart Organisation is active
                                        </TextBlock>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="4"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                       Text="🎬 Movies →"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding SmartMoviesPreviewPath, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Grid.Row="2" Grid.Column="0"
                                                       Text="📺 TV Shows →"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding SmartTvPreviewPath, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   Margin="0,8,0,0" TextWrapping="Wrap">
                                            Folders are created automatically. Only applies to the Custom Fast engine.
                                            Change in Settings → 🗂 Move / Copy — Smart Organisation.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- ── Space Analysis ─────────────────────────────── -->
                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="16,14" Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="💾" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Space Analysis"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Results panel — hidden until analysed -->
                                        <Border Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="6"
                                                Padding="14,10" Margin="0,0,0,12"
                                                Visibility="{Binding SpaceAnalysisVisible, Converter={StaticResource BoolVis}}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="💾 " FontSize="12"/>
                                                    <TextBlock FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ForegroundBrush}">Space Analysis Results:</TextBlock>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="🗂 " FontSize="12"/>
                                                    <TextBlock FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}">
                                                        <Run Text="Source Files: " FontWeight="SemiBold"/>
                                                        <Run Text="{Binding SpaceSourceInfo, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="🌐 " FontSize="12"/>
                                                    <TextBlock FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}">
                                                        <Run Text="Destination Free Space: " FontWeight="SemiBold"/>
                                                        <Run Text="{Binding SpaceDestInfo, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,8">
                                                    <TextBlock Text="⚙ " FontSize="12"/>
                                                    <TextBlock FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}">
                                                        <Run Text="Disk Usage: " FontWeight="SemiBold"/>
                                                        <Run Text="{Binding SpaceDiskUsage, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <!-- Status message — green if OK, red if not -->
                                                <TextBlock Text="{Binding SpaceStatusMsg}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SpaceIsSufficient}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock FontSize="12"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   Margin="0,0,0,10"
                                                   Visibility="{Binding SpaceAnalysisVisible, Converter={StaticResource InvBoolVis}}">
                                            Click 'Analyze Space' to see available disk space and estimated file sizes.
                                        </TextBlock>

                                        <Button Content="🔍 Analyze Space"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding AnalyzeSpaceCommand}"
                                                HorizontalAlignment="Left"
                                                Padding="16,8"/>
                                    </StackPanel>
                                </Border>

                                <!-- ── File Conflict Resolution ───────────────────── -->
                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="16,14" Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <TextBlock Text="⚠" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource WarningBrush}"/>
                                            <TextBlock Text="File Conflict Resolution"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="If file exists:"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0"/>
                                            <ComboBox Grid.Column="1"
                                                      SelectedValue="{Binding ConflictMode}"
                                                      SelectedValuePath="Tag"
                                                      FontSize="12">
                                                <ComboBoxItem Content="Skip" Tag="Skip"/>
                                                <ComboBoxItem Content="Overwrite" Tag="Overwrite"/>
                                                <ComboBoxItem Content="Overwrite if Newer" Tag="OverwriteIfNewer"/>
                                                <ComboBoxItem Content="Rename (keep both)" Tag="Rename"/>
                                            </ComboBox>
                                        </Grid>
                                        <TextBlock Text="{Binding ConflictModeDescription}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Preferred engine -->
                                <TextBlock Text="COPY ENGINE" Style="{StaticResource LabelText}"/>

                                <!-- Smart Organisation info banner — only shown when active -->
                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1" CornerRadius="5"
                                        Padding="10,8" Margin="0,0,0,8"
                                        Visibility="{Binding SmartOrganiseEnabled, Converter={StaticResource BoolVis}}">
                                    <TextBlock FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource AccentBrush}">
                                        🗂 <Bold>Smart Organisation is active.</Bold>
                                        Movies → destination\Movies\
                                        TV Episodes → destination\TV Shows\Show (Year)\Season ##\
                                        FastCopy and Auto are disabled — Smart Organisation requires
                                        per-file routing which only Custom Fast supports.
                                    </TextBlock>
                                </Border>

                                <WrapPanel Margin="0,0,0,8">
                                    <RadioButton IsChecked="{Binding PreferredCopyEngine, Converter={StaticResource StringEqualsBool}, ConverterParameter=Auto}"
                                                 IsEnabled="{Binding AutoEngineAllowed}"
                                                 Margin="0,0,16,6" VerticalAlignment="Center"
                                                 ToolTip="Auto: uses FastCopy if installed, otherwise Custom Fast. Disabled when Smart Organisation is active.">
                                        <TextBlock>
                                            <Run Text="Auto"/>
                                            <Run Text=" (FastCopy → Custom Fast)" Foreground="{DynamicResource ForegroundMutedBrush}" FontSize="11"/>
                                        </TextBlock>
                                    </RadioButton>
                                    <RadioButton IsChecked="{Binding PreferredCopyEngine, Converter={StaticResource StringEqualsBool}, ConverterParameter=FastCopy}"
                                                 IsEnabled="{Binding FastCopyAllowed}"
                                                 Margin="0,0,16,6" VerticalAlignment="Center">
                                        <RadioButton.ToolTip>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="FastCopy: fast headless engine, native move with verification."/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SmartOrganiseEnabled}" Value="True">
                                                                <Setter Property="Text" Value="FastCopy is disabled when Smart Organisation is active — FastCopy cannot route files to different subfolders per file. Use Custom Fast instead."/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </RadioButton.ToolTip>
                                        <TextBlock>
                                            <Run Text="FastCopy"/>
                                            <Run Text="{Binding FastCopyDetected, Converter={StaticResource BoolToStringDetected}, Mode=OneWay}"
                                                 Foreground="{DynamicResource ForegroundMutedBrush}" FontSize="11"/>
                                        </TextBlock>
                                    </RadioButton>
                                    <RadioButton IsChecked="{Binding PreferredCopyEngine, Converter={StaticResource StringEqualsBool}, ConverterParameter=Built-in}"
                                                 Margin="0,0,16,6" VerticalAlignment="Center"
                                                 ToolTip="Custom Fast: multi-threaded in-process engine. Required when Smart Organisation is active.">
                                        <TextBlock>
                                            <Run Text="Custom Fast"/>
                                            <Run FontSize="11" FontWeight="SemiBold"
                                                 Foreground="{DynamicResource PrimaryBrush}">
                                                <Run.Style>
                                                    <Style TargetType="Run">
                                                        <Setter Property="Text" Value=" ★ Recommended"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SmartOrganiseEnabled}" Value="True">
                                                                <Setter Property="Text" Value=" ★ Required for Smart Organise"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Run.Style>
                                            </Run>
                                        </TextBlock>
                                    </RadioButton>

                                </WrapPanel>

                                <!-- Selected file count info -->
                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="12,8" Margin="0,0,0,20">
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource ForegroundMutedBrush}">
                                        <Run Text="Selected files: "/>
                                        <Run Text="{Binding SelectedFileCount, Mode=OneWay}"
                                             Foreground="{DynamicResource PrimaryBrush}"
                                             FontWeight="SemiBold"/>
                                        <Run Text=" of "/>
                                        <Run Text="{Binding Files.Count, Mode=OneWay}"
                                             FontWeight="SemiBold"/>
                                        <Run Text=" — use ☑ All / ☐ None in the toolbar to change selection."/>
                                    </TextBlock>
                                </Border>

                                <!-- Action buttons -->
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="📋 Copy Selected Files"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding CopyFilesCommand}"
                                            Padding="18,10" Margin="0,0,12,0"/>
                                    <Button Content="✂ Move Selected Files"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding MoveFilesCommand}"
                                            Padding="18,10"/>
                                </StackPanel>

                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                           Margin="0,10,0,0" TextWrapping="Wrap">
                                    Progress and status are shown in the bar at the bottom of the window.
                                    FastCopy runs headless with real-time progress in the status bar.
                                    Custom Fast runs entirely in-process: multi-threaded, drive-tuned,
                                    byte-accurate progress, automatic retries, size verification.
                                    FastCopy runs headless for fast, quiet transfers. Custom Fast is the built-in engine with real-time progress.
                                    Destination free space is always checked before any transfer begins.
                                </TextBlock>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ══════════════════════════════════════════════════════ -->
                    <!-- TAB 3 — SETTINGS -->
                    <!-- ══════════════════════════════════════════════════════ -->
                     <!-- ══════════════════════════════════════════════════════ -->
                     <TabItem Header="{DynamicResource Tab.Settings}">
                         <Grid>
                             <Grid.ColumnDefinitions>
                                 <!-- Left nav list — fixed width -->
                                 <ColumnDefinition Width="175"/>
                                 <!-- Right content area — fills remaining space -->
                                 <ColumnDefinition Width="*"/>
                             </Grid.ColumnDefinitions>

                             <!-- ── Left nav ──────────────────────────────── -->
                             <Border Grid.Column="0"
                                     BorderThickness="0,0,1,0"
                                     BorderBrush="{DynamicResource BorderColorBrush}">
                                 <ListBox x:Name="SettingsNavList"
                                          SelectedIndex="0"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          Margin="0,12,0,0"
                                          VirtualizingPanel.IsVirtualizing="False">
                                     <ListBoxItem Padding="12,8">🔑  Metadata &amp; APIs</ListBoxItem>
                                     <ListBoxItem Padding="12,8">✏  Files &amp; Renaming</ListBoxItem>
                                     <ListBoxItem Padding="12,8">🎨  Artwork &amp; Performance</ListBoxItem>
                                     <ListBoxItem Padding="12,8">🖥  Appearance</ListBoxItem>
                                     <ListBoxItem Padding="12,8">🔍  Duplicates</ListBoxItem>
                                     <ListBoxItem Padding="12,8">📦  Move / Copy</ListBoxItem>
                                     <ListBoxItem Padding="12,8">📚  Library</ListBoxItem>
                                     <ListBoxItem Padding="12,8">⚕  Recovery</ListBoxItem>
                                 </ListBox>
                             </Border>

                             <!-- ── Right content ─────────────────────────── -->
                             <ScrollViewer Grid.Column="1"
                                           VerticalScrollBarVisibility="Auto">
                                 <StackPanel Margin="20,16,20,20" MaxWidth="620">

                                     <TextBlock Text="Settings"
                                                Style="{StaticResource SectionHeader}"
                                                FontSize="20"/>

                                    <!-- ── 0 ──────────────────────────────────────────────── -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsNavList}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                <GroupBox Header="API Keys">
                                    <StackPanel>

                                        <!-- TMDB Key row -->
                                        <TextBlock Text="TMDB API KEY" Style="{StaticResource LabelText}"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding Settings.TmdbApiKey, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding TmdbKeyLocked, Converter={StaticResource InvBool}}"/>
                                            <!-- Flash indicator -->
                                            <Border Grid.Column="1" Width="32" Margin="4,0,0,0"
                                                    CornerRadius="4"
                                                    Visibility="{Binding TmdbKeyValid, Converter={StaticResource NullableBoolVis}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TmdbKeyValid}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TmdbKeyValid}" Value="False">
                                                                <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TmdbKeyValid}" Value="True">
                                                                    <Setter Property="Text" Value="✓"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding TmdbKeyValid}" Value="False">
                                                                    <Setter Property="Text" Value="✗"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <!-- Pencil unlock button (visible when locked) -->
                                            <Button Grid.Column="2"
                                                    Content="✏️"
                                                    Style="{StaticResource IconButton}"
                                                    Command="{Binding UnlockTmdbCommand}"
                                                    Visibility="{Binding TmdbKeyLocked, Converter={StaticResource BoolVis}}"
                                                    ToolTip="Edit TMDB API Key"
                                                    Margin="4,0,0,0" Padding="6"/>
                                        </Grid>
                                        <TextBlock Margin="0,0,0,12" FontSize="11"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   Visibility="{Binding TmdbKeyLocked, Converter={StaticResource BoolVis}}">
                                            ✓ Validated and saved
                                        </TextBlock>

                                        <!-- OMDB Key row -->
                                        <TextBlock Text="OMDB API KEY" Style="{StaticResource LabelText}"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding Settings.OmdbApiKey, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding OmdbKeyLocked, Converter={StaticResource InvBool}}"/>
                                            <!-- Flash indicator -->
                                            <Border Grid.Column="1" Width="32" Margin="4,0,0,0"
                                                    CornerRadius="4"
                                                    Visibility="{Binding OmdbKeyValid, Converter={StaticResource NullableBoolVis}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OmdbKeyValid}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding OmdbKeyValid}" Value="False">
                                                                <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding OmdbKeyValid}" Value="True">
                                                                    <Setter Property="Text" Value="✓"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding OmdbKeyValid}" Value="False">
                                                                    <Setter Property="Text" Value="✗"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <!-- Pencil unlock button -->
                                            <Button Grid.Column="2"
                                                    Content="✏️"
                                                    Style="{StaticResource IconButton}"
                                                    Command="{Binding UnlockOmdbCommand}"
                                                    Visibility="{Binding OmdbKeyLocked, Converter={StaticResource BoolVis}}"
                                                    ToolTip="Edit OMDB API Key"
                                                    Margin="4,0,0,0" Padding="6"/>
                                        </Grid>
                                        <TextBlock Margin="0,0,0,12" FontSize="11"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   Visibility="{Binding OmdbKeyLocked, Converter={StaticResource BoolVis}}">
                                            ✓ Validated and saved
                                        </TextBlock>

                                        <!-- IMDB Key (no validation endpoint — just save) -->
                                        <TextBlock Text="IMDB API KEY (optional)" Style="{StaticResource LabelText}"/>
                                        <TextBox Text="{Binding Settings.ImdbApiKey, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,16"/>

                                        <!-- Validate button + status -->
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="✓ Validate Keys"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding ValidateKeysCommand}"
                                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>
                                            <TextBlock VerticalAlignment="Center" FontSize="12"
                                                       Margin="16,0,0,0"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}">
                                                Get free keys at themoviedb.org · omdbapi.com
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="🎯 Trakt.tv">
                                    <StackPanel>
                                        <!-- Client ID -->
                                        <TextBlock Text="TRAKT CLIENT ID" Style="{StaticResource LabelText}"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding TraktClientIdDisplay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding TraktClientIdLocked, Converter={StaticResource InvBool}}"
                                                     TextChanged="TraktClientId_TextChanged"
                                                     ToolTip="Paste your Trakt Client ID from trakt.tv/oauth/applications"/>
                                            <Button Grid.Column="1" Content="✏️"
                                                    Style="{StaticResource IconButton}"
                                                    Command="{Binding UnlockTraktClientIdCommand}"
                                                    Visibility="{Binding TraktClientIdLocked, Converter={StaticResource BoolVis}}"
                                                    ToolTip="Edit Client ID" Margin="4,0,0,0" Padding="6"/>
                                        </Grid>

                                        <!-- Connected indicator (visible when locked/connected) -->
                                        <TextBlock Margin="0,0,0,8" FontSize="11"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   Visibility="{Binding TraktClientIdLocked, Converter={StaticResource BoolVis}}">
                                            ✓ Keys saved and encrypted
                                        </TextBlock>

                                        <!-- Client Secret -->
                                        <TextBlock Text="TRAKT CLIENT SECRET" Style="{StaticResource LabelText}"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Masked display when locked — shows dots so user knows a value is saved -->
                                            <TextBox Grid.Column="0"
                                                     Text="●●●●●●●●●●●●●●●●●●●●  (saved)"
                                                     IsReadOnly="True"
                                                     IsEnabled="False"
                                                     FontFamily="Consolas" FontSize="11"
                                                     Foreground="{DynamicResource ForegroundMutedBrush}"
                                                     Visibility="{Binding TraktClientSecretLocked, Converter={StaticResource BoolVis}}"
                                                     ToolTip="Client Secret is saved and encrypted. Click ✏ to change."/>
                                            <!-- Editable PasswordBox when unlocked -->
                                            <PasswordBox x:Name="TraktSecretBox"
                                                         Grid.Column="0"
                                                         Visibility="{Binding TraktClientSecretLocked, Converter={StaticResource InvBoolVis}}"
                                                         ToolTip="Paste your Trakt Client Secret"
                                                         PasswordChanged="TraktSecretBox_PasswordChanged"/>
                                            <Button Grid.Column="1" Content="✏️"
                                                    Style="{StaticResource IconButton}"
                                                    Command="{Binding UnlockTraktSecretCommand}"
                                                    Visibility="{Binding TraktClientSecretLocked, Converter={StaticResource BoolVis}}"
                                                    ToolTip="Edit Client Secret" Margin="4,0,0,0" Padding="6"/>
                                        </Grid>

                                        <!-- Connect / Disconnect -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button Content="🔗 Connect Trakt Account"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding TraktConnectCommand}"
                                                    Visibility="{Binding TraktConnected, Converter={StaticResource InvBoolVis}}"
                                                    Padding="12,6" Margin="0,0,8,0"/>
                                            <Button Content="⏳ Waiting for approval…"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding TraktCancelConnectCommand}"
                                                    Visibility="{Binding TraktConnecting, Converter={StaticResource BoolVis}}"
                                                    Padding="12,6" Margin="0,0,8,0"/>
                                            <Button Content="Disconnect"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Foreground="{DynamicResource ErrorBrush}"
                                                    Command="{Binding TraktDisconnectCommand}"
                                                    Visibility="{Binding TraktConnected, Converter={StaticResource BoolVis}}"
                                                    Padding="10,6"/>
                                        </StackPanel>

                                        <!-- PIN display (shown during device flow) -->
                                        <Border Background="{DynamicResource SurfaceVariantBrush}"
                                                CornerRadius="6" Padding="12,10" Margin="0,0,0,8"
                                                Visibility="{Binding TraktConnecting, Converter={StaticResource BoolVis}}">
                                            <StackPanel>
                                                <TextBlock Text="Go to:" FontSize="12"
                                                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                                <TextBlock Text="trakt.tv/activate"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="And enter this code:"
                                                           FontSize="12" Margin="0,6,0,2"
                                                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                                <TextBlock Text="{Binding TraktPinDisplay}"
                                                           FontSize="28" FontWeight="Bold"
                                                           FontFamily="Consolas"
                                                           Foreground="{DynamicResource ForegroundBrush}"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Status -->
                                        <TextBlock Text="{Binding TraktStatusText}"
                                                   FontSize="12" Margin="0,0,0,2"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Text="{Binding TraktLastSyncText}"
                                                   FontSize="11" Margin="0,0,0,2"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                        <TextBlock Text="{Binding TraktTokenExpiryText}"
                                                   FontSize="11" Margin="0,0,0,8"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"/>

                                        <!-- Sync options (enabled only when connected) -->
                                        <StackPanel IsEnabled="{Binding TraktConnected}">
                                            <CheckBox Content="Push watched status to Trakt when marking files"
                                                      IsChecked="{Binding TraktSyncOnMark}"
                                                      Margin="0,0,0,4"/>
                                            <CheckBox Content="Pull Trakt history after library scan"
                                                      IsChecked="{Binding TraktSyncOnScan}"
                                                      Margin="0,0,0,8"/>
                                            <Button Content="🔄 Sync Now"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding TraktSyncNowCommand}"
                                                    HorizontalAlignment="Left" Padding="12,6"/>
                                        </StackPanel>

                                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}">
                                            Create app at trakt.tv/oauth/applications — set Redirect URI
                                            to urn:ietf:wg:oauth:2.0:oob for the device/PIN flow.
                                        </TextBlock>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="🗒 OpenSubtitles">
                                    <StackPanel>
                                        <TextBlock Text="OPENSUBTITLES API KEY" Style="{StaticResource LabelText}"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding OpenSubsKeyDisplay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding OpenSubsKeyLocked, Converter={StaticResource InvBool}}"
                                                     ToolTip="Get a free API key at opensubtitles.com — register, then go to Profile → API Consumer"/>
                                            <Button Grid.Column="1" Content="✏️"
                                                    Style="{StaticResource IconButton}"
                                                    Command="{Binding UnlockOpenSubsKeyCommand}"
                                                    Visibility="{Binding OpenSubsKeyLocked, Converter={StaticResource BoolVis}}"
                                                    ToolTip="Edit API key" Margin="4,0,0,0" Padding="6"/>
                                            <Button Grid.Column="2" Content="✓ Validate"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding ValidateOpenSubsKeyCommand}"
                                                    Visibility="{Binding OpenSubsKeyLocked, Converter={StaticResource InvBoolVis}}"
                                                    Margin="4,0,0,0" Padding="10,6"/>
                                        </Grid>
                                        <!-- Validated indicator -->
                                        <StackPanel Visibility="{Binding OpenSubsKeyValid, Converter={StaticResource NullableBoolVis}}">
                                            <TextBlock FontSize="11" Margin="0,0,0,4">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OpenSubsKeyValid}" Value="True">
                                                                <Setter Property="Text" Value="✓ Validated and saved"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding OpenSubsKeyValid}" Value="False">
                                                                <Setter Property="Text" Value="✗ Invalid key — check and retry"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
