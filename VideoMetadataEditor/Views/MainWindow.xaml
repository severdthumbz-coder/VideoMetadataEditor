                                                    Style="{StaticResource SecondaryButton}"
                                                    Click="DownloadFfmpeg_Click"
                                                    ToolTip="Opens the official ffmpeg download page in your browser. Get a Windows build, extract ffmpeg.exe, and place it in the native\ folder."/>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   Margin="0,6,0,0">
                                            Recommended build: gyan.dev "ffmpeg-release-essentials" (Windows).
                                            After extracting, copy ffmpeg.exe from its bin\ folder into the
                                            app's native\ folder, then click Re-detect.
                                        </TextBlock>
                                    </StackPanel>
                                </GroupBox>

                                    </StackPanel>
                                    <!-- ── 5 ──────────────────────────────────────────────── -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsNavList}" Value="5">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                <GroupBox Header="🗂 Move / Copy — Smart Organisation">
                                    <StackPanel>
                                        <CheckBox Content="Organise by content type (Movies and TV Episodes to separate folders)"
                                                  IsChecked="{Binding SmartOrganiseEnabled}"
                                                  ToolTip="When enabled, TV Episodes are routed to a subfolder automatically. Movies go to the base destination unchanged."/>
                                        <TextBlock FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   Margin="0,6,0,8">
                                            Movies → destination folder as-is.
                                            TV Episodes → destination\TV Shows\Show Name (Year)\Season 01                                            Folders are created automatically if they don't exist.
                                        </TextBlock>

                                        <StackPanel Visibility="{Binding SmartOrganiseEnabled, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="MOVIES SUBFOLDER NAME" Style="{StaticResource LabelText}" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding MoviesFolderName, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,0,8"
                                                     ToolTip="Name of the Movies subfolder. Default: Movies"/>

                                            <TextBlock Text="TV SHOWS SUBFOLDER NAME" Style="{StaticResource LabelText}" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding TvShowsFolderName, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,0,8"
                                                     ToolTip="Name of the TV subfolder created inside the destination. Default: TV Shows"/>

                                            <CheckBox Content="Create Season ## subfolders"
                                                      IsChecked="{Binding CreateSeasonSubfolders}"
                                                      Margin="0,0,0,8"
                                                      ToolTip="Creates Season 01, Season 02 etc. subfolders inside each show folder"/>

                                            <!-- Untagged file handling -->
                                            <TextBlock Text="UNTAGGED FILES" Style="{StaticResource LabelText}" Margin="0,4,0,3"/>
                                            <TextBlock FontSize="11" FontStyle="Italic" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,4">
                                                Files with no metadata (raw torrent files, unprocessed dumps) — choose how to handle them:
                                            </TextBlock>
                                            <ComboBox SelectedValue="{Binding UntaggedFileHandling}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,6">
                                                <ComboBoxItem Tag="SendToUnsorted" Content="Send to Unsorted folder (recommended)"/>
                                                <ComboBoxItem Tag="SendToMovies"   Content="Send to Movies folder (legacy behaviour)"/>
                                                <ComboBoxItem Tag="Skip"           Content="Skip — exclude from copy/move entirely"/>
                                            </ComboBox>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="UNSORTED FOLDER:" Style="{StaticResource LabelText}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Text="{Binding UnsortedFolderName, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="200" VerticalAlignment="Center"
                                                         ToolTip="Folder name for untagged files. Default: Unsorted"/>
                                            </StackPanel>

                                            <TextBlock FontSize="11" FontStyle="Italic"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                                       TextWrapping="Wrap" Margin="0,6,0,0">
                                                Example: D:\Library\ as destination →
                                                Movies go to D:\Library\Movies\
                                                TV Episodes go to D:\Library\TV Shows\Bloodhounds\Season 01\
                                                Untagged files go to D:\Library\Unsorted\ (or skipped)
                                            </TextBlock>

                                            <!-- Excluded patterns for Duplicate Scanner -->
                                            <Separator Margin="0,12,0,8"/>
                                            <TextBlock Text="DUPLICATE SCAN — EXCLUDE PATTERNS" Style="{StaticResource LabelText}"/>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource ForegroundMutedBrush}"
                                                       TextWrapping="Wrap" Margin="0,2,0,4">
                                                One pattern per line. * matches any characters. Case-insensitive.
                                                Files matching any pattern are skipped by both Quick Scan and ♪ Deep Scan.
                                            </TextBlock>
                                            <TextBox Text="{Binding DuplicateExcludedPatterns, UpdateSourceTrigger=LostFocus}"
                                                     AcceptsReturn="True"
                                                     TextWrapping="NoWrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Height="80" FontFamily="Consolas" FontSize="11"
                                                     ToolTip="Examples:&#x0A;*-sample.*&#x0A;*\Trailers\*&#x0A;*\Featurettes\*&#x0A;*\Extras\*"/>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="📄 NFO Export (Kodi / Plex / Jellyfin)">
                                    <StackPanel>
                                        <TextBlock FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   Margin="0,0,0,8">
                                            "📄 Export NFO" writes a Kodi-format .nfo sidecar next to each video
                                            (movie → &lt;movie&gt;, episode → &lt;episodedetails&gt;). The Kodi format is
                                            read by Plex's NFO Agent, Jellyfin, and Emby.
                                        </TextBlock>
                                        <CheckBox Content="Also write tvshow.nfo into each show folder when exporting episodes"
                                                  IsChecked="{Binding WriteTvShowNfo}"
                                                  ToolTip="When exporting NFOs for TV episodes, also writes a series-level tvshow.nfo into each episode's folder (once per folder). Contains the show title, plot, genres, and series IDs. Off by default."/>
                                        <TextBlock FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   Margin="18,2,0,0">
                                            tvshow.nfo is written from the episode's metadata (show title, genres, series IDs).
                                            For best results, place each show's episodes in their own folder.
                                        </TextBlock>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="🖼 Artwork Export">
                                    <StackPanel>
                                        <TextBlock FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   Margin="0,0,0,8">
                                            "🖼 Export Artwork" writes the poster as an image file next to each selected
                                            video, so Plex, Jellyfin, Emby, and Kodi can read it from disk. The poster is
                                            taken from the loaded metadata, the embedded tag, or downloaded via TMDB.
                                        </TextBlock>
                                        <TextBlock Text="Sidecar naming style:" Margin="0,0,0,4"/>
                                        <ComboBox SelectedIndex="{Binding ArtworkNamingStyle}" Width="320" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="Kodi — &lt;video&gt;-poster.jpg (universal, default)"/>
                                            <ComboBoxItem Content="Plex / Jellyfin — poster.jpg in the folder"/>
                                        </ComboBox>
                                        <TextBlock FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   Margin="0,6,0,0">
                                            Kodi style names the image after the video (TV episodes use -thumb.jpg) and works
                                            even when multiple videos share a folder. Folder style writes a single poster.jpg
                                            per folder — best when each movie/show has its own folder.
                                        </TextBlock>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="📦 Move / Copy — Saved Settings">
                                    <StackPanel>
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,8">
                                            Destination folder and conflict mode are saved automatically
                                            each time you change them and restored when the app restarts.
                                            Use the fields below to review or clear the saved values.
                                        </TextBlock>
                                        <TextBlock Text="SAVED DESTINATION FOLDER" Style="{StaticResource LabelText}" Margin="0,0,0,3"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     IsReadOnly="True"
                                                     Text="{Binding SavedCopyDestination}"
                                                     Foreground="{DynamicResource ForegroundMutedBrush}"
                                                     ToolTip="{Binding SavedCopyDestination}"/>
                                            <Button Grid.Column="1"
                                                    Content="{DynamicResource Files.Clear}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding ClearSavedCopyDestCommand}"
                                                    Margin="6,0,0,0" Padding="8,4"/>
                                        </Grid>
                                        <TextBlock Text="SAVED CONFLICT MODE" Style="{StaticResource LabelText}" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding SavedConflictMode}"
                                                   FontSize="12" Margin="0,0,0,8"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <Button Content="💾 Save Current Move/Copy Settings Now"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding SaveCopySettingsCommand}"
                                                HorizontalAlignment="Left"
                                                Padding="12,6"/>
                                    </StackPanel>
                                </GroupBox>

                                    </StackPanel>
                                    <!-- ── 6 ──────────────────────────────────────────────── -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsNavList}" Value="6">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                <GroupBox Header="📚 Library Display">
                                    <StackPanel>
                                        <CheckBox Content="Tabbed library display (one tab per folder)"
                                                  IsChecked="{Binding LibraryTabbedMode}"
                                                  ToolTip="When enabled, each library folder gets its own tab with independent filtering and sorting."/>
                                        <CheckBox Content="📺 TV Shows tree view (Show &#x2192; Season &#x2192; Episodes)"
                                                  IsChecked="{Binding LibraryTvTreeView}"
                                                  Margin="0,6,0,0"
                                                  ToolTip="When a TV Shows tab is active, shows entries in a collapsible tree. Double-click an episode to load it. Movie tabs always use list view."/>
                                        <TextBlock FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   Margin="0,4,0,0">
                                            When multiple folders are added via ➕ Folder, each gets its own
                                            tab above the filter box. Filter, sort, and selection are
                                            independent per tab. Enable this to also show tabs for a single folder.
                                        </TextBlock>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="📚 Library Watch">
                                    <StackPanel>
                                        <CheckBox Content="Watch Library folder for new files"
                                                  IsChecked="{Binding LibraryWatchEnabled}"
                                                  Margin="0,0,0,6"
                                                  ToolTip="Monitors the Library folder and adds new video files to the Library grid automatically — no re-scan required."/>
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8">
                                            When enabled, the Library grid updates automatically when new
                                            video files arrive in the Library folder. Uses the same
                                            FileSystemWatcher + poll approach as Watch Folder.
                                            Only works if a library folder has been selected and scanned.
                                        </TextBlock>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Poll interval (minutes):"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding LibraryWatchPollMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding LibraryWatchEnabled}"
                                                     ToolTip="How often (in minutes) the library folder is polled. Minimum 1."/>
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="⚡ Library Scan Cache">
                                    <StackPanel>
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,8">
                                            After the first scan, file metadata is cached locally. Scan multiple folders (Movies + TV Shows) using ➕ Folder — all results appear in one unified library.
                                            Subsequent scans skip TagLib# for unchanged files —
                                            a 2,000-file library with nothing changed loads in under
                                            3 seconds instead of minutes. Artwork is never cached
                                            (loaded separately to keep cache files small).
                                        </TextBlock>
                                        <TextBlock Text="{Binding LibraryCacheInfo}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <Button Content="🗑 Clear Library Cache"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding ClearLibraryCacheCommand}"
                                                HorizontalAlignment="Left"
                                                Padding="12,6"
                                                ToolTip="Deletes the local cache file. The next scan will read every file from disk and rebuild the cache."/>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="📁 Watch Folder">
                                    <StackPanel>
                                        <CheckBox Content="Enable Watch Folder (monitor loaded folder for new files)"
                                                  IsChecked="{Binding WatchFolderEnabled}"
                                                  Margin="0,0,0,4"
                                                  ToolTip="When enabled, the app watches the last loaded folder for new video files and adds them automatically. New files are highlighted in yellow."/>
                                        <CheckBox Content="Recursive — include subfolders"
                                                  IsChecked="{Binding WatchFolderRecursive}"
                                                  IsEnabled="{Binding WatchFolderEnabled}"
                                                  Margin="18,0,0,6"
                                                  ToolTip="When checked, the watch folder monitors all subfolders recursively. Uncheck to only watch the top-level folder and ignore subfolders."/>
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8">
                                            Uses live file-system events (instant) plus a thread-pool poll timer
                                            that always fires at the configured interval regardless of UI load.
                                            FSW auto-restarts on errors with back-off up to 5 retries.
                                            New files are highlighted yellow so you can distinguish them.
                                        </TextBlock>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Poll interval (minutes):"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding WatchFolderPollMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding WatchFolderEnabled}"
                                                     ToolTip="How often (in minutes) the folder is polled for changes. Minimum 1. Changing this updates the running watcher without restarting it."/>
                                        </Grid>

                                        <Separator Margin="0,0,0,8"/>

                                        <!-- Auto-embed -->
                                        <CheckBox Content="🤖 Auto-embed metadata when new files are detected"
                                                  IsChecked="{Binding AutoEmbedEnabled}"
                                                  IsEnabled="{Binding WatchFolderEnabled}"
                                                  Margin="0,0,0,6"
                                                  ToolTip="Automatically searches TMDB/OMDB and embeds metadata when a new file appears. Files below the confidence threshold are queued for manual processing (yellow)."/>
                                        <StackPanel Margin="18,0,0,0"
                                                    IsEnabled="{Binding AutoEmbedEnabled}">
                                            <TextBlock Text="CONFIDENCE THRESHOLD" Style="{StaticResource LabelText}" Margin="0,0,0,3"/>
                                            <ComboBox SelectedIndex="{Binding AutoEmbedConfidenceLevel}"
                                                      Margin="0,0,0,4" FontSize="12">
                                                <ComboBoxItem Content="Low — 40% title match (embeds aggressively)"/>
                                                <ComboBoxItem Content="Medium — 60% title match"/>
                                                <ComboBoxItem Content="High — 80% title match (recommended)"/>
                                                <ComboBoxItem Content="Exact — only embed on exact title match"/>
                                            </ComboBox>
                                            <TextBlock FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                                       Margin="0,0,0,4">
                                                Files below the threshold are still added to the Files panel
                                                highlighted yellow for manual processing.
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Last auto-embed: " FontSize="11"
                                                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                                <TextBlock Text="{Binding LastAutoEmbedTime}" FontSize="11"
                                                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>

                                    </StackPanel>
                                    <!-- ── 7 ──────────────────────────────────────────────── -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsNavList}" Value="7">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                <GroupBox Header="🗑 Temp File Handling">
                                    <StackPanel>
                                        <TextBlock Text="WHEN TEMP/BACKUP FILES ARE DETECTED"
                                                   Style="{StaticResource LabelText}"/>
                                        <ComboBox SelectedValue="{Binding OrphanTempFilePolicy}"
                                                  SelectedValuePath="Tag"
                                                  Margin="0,4,0,6">
                                            <ComboBoxItem Content="Ask — show Recovery dialog (recommended)"
                                                          Tag="Ask"/>
                                            <ComboBoxItem Content="Auto-Delete — silently remove orphans"
                                                          Tag="AutoDelete"/>
                                            <ComboBoxItem Content="Ignore — skip orphan scan entirely"
                                                          Tag="Ignore"/>
                                        </ComboBox>
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   TextWrapping="Wrap">
                                            Temp files (.vme_tmp_*) contain pending tag changes from
                                            a previous crashed session. Backups (.vme_bak_*) are safe
                                            to delete — the write already succeeded.
                                            "Ask" lets you resume incomplete writes or delete.
                                            "Auto-Delete" cleans all orphans silently on load.
                                            "Ignore" skips the scan — manual cleanup only.
                                        </TextBlock>
                                    </StackPanel>
                                </GroupBox>

                                    </StackPanel>
                                     <!-- Save — always visible regardless of active panel -->
                                     <Button Content="💾 Save Settings"
                                             Style="{StaticResource PrimaryButton}"
                                             Command="{Binding SaveSettingsCommand}"
                                             HorizontalAlignment="Left"
                                             Margin="0,12,0,0"/>

                                 </StackPanel>
                             </ScrollViewer>

                         </Grid>
                     </TabItem>


                    <!-- ══════════════════════════════════════════════════════ -->
                    <!-- TAB — LIBRARY                                         -->
                    <!-- ══════════════════════════════════════════════════════ -->
                    <TabItem Header="{DynamicResource Tab.Library}">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><!-- 0: toolbar -->
                                <RowDefinition Height="Auto"/><!-- 1: extra folders -->
                                <RowDefinition Height="Auto"/><!-- 2: filter bar -->
                                <RowDefinition Height="Auto"/><!-- 3: progress -->
                                <RowDefinition Height="*"/>  <!-- 4: grid -->
                                <RowDefinition Height="Auto"/><!-- 5: status -->
                            </Grid.RowDefinitions>

                            <!-- Toolbar row -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/><!-- 1: Browse -->
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/><!-- 3: Recursive -->
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/><!-- 5: + Folder -->
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/><!-- 7: Scan Library -->
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/><!-- 9: Export CSV -->
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/><!-- 11: Export XLSX -->
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/><!-- 13: Export NFO -->
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/><!-- 15: Load Selected -->
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/><!-- 17: Columns -->
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/><!-- 19: Save Layout -->
                                </Grid.ColumnDefinitions>

                                <!-- Folder path + extra folders pill list -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Folder:"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                        <TextBox x:Name="LibraryFolderBox"
                                                 Grid.Column="1"
                                                 Text="{Binding LibraryFolderDisplay, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 VerticalAlignment="Center"
                                                 ToolTip="{Binding AllLibraryFoldersTooltip}"/>
                                    </Grid>
                                    <!-- Extra folders — shown as removable pills when any exist -->
                                    <ItemsControl ItemsSource="{Binding ExtraLibraryFolders}"
                                                  Margin="0,3,0,0"
                                                  Visibility="{Binding HasExtraFolders, Converter={StaticResource BoolVis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceVariantBrush}"
                                                        CornerRadius="3" Margin="0,0,4,2" Padding="6,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontSize="10" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                                   Text="➕ " />
                                                        <TextBlock Text="{Binding Converter={StaticResource PathToFilenameConverter}}"
                                                                   FontSize="10" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   ToolTip="{Binding}"
                                                                   MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                                                        <Button Content="✕" FontSize="9" Padding="3,1"
                                                                Margin="4,0,0,0"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Command="{Binding DataContext.RemoveExtraLibraryFolderCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Remove this folder from library"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Button Grid.Column="1" Content="📂 Browse"
                                        Command="{Binding BrowseLibraryFolderCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Height="{Binding ActualHeight, ElementName=LibraryFolderBox}"
                                        VerticalAlignment="Top"/>

                                <CheckBox Grid.Column="3"
                                          Content="{DynamicResource Btn.Recursive}"
                                          IsChecked="{Binding Settings.LibraryRecursive}"
                                          VerticalAlignment="Center"
                                          ToolTip="Scan subfolders too"/>

                                <Button Grid.Column="5" Content="➕ Folder"
                                        Height="{Binding ActualHeight, ElementName=LibraryFolderBox}"
                                        VerticalAlignment="Top"
                                        Command="{Binding AddExtraLibraryFolderCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="8,5" FontSize="12"
                                        ToolTip="Add an extra folder to include in library scans"/>

                                <Button Grid.Column="7"
                                        Content="🔍 Scan Library"
                                        Command="{Binding ScanLibraryCommand}"
                                        IsEnabled="{Binding CanScanLibrary}"
                                        Style="{StaticResource PrimaryButton}"
                                        Height="{Binding ActualHeight, ElementName=LibraryFolderBox}"
                                        VerticalAlignment="Top"/>

                                <Button Grid.Column="9" Content="📄 Export CSV"
                                        Height="{Binding ActualHeight, ElementName=LibraryFolderBox}"
                                        VerticalAlignment="Top"
                                        Command="{Binding ExportLibraryCsvCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        ToolTip="Export visible columns to CSV"/>
                                <Button Grid.Column="11" Content="{DynamicResource Lib.ExportXlsx}"
                                        Height="{Binding ActualHeight, ElementName=LibraryFolderBox}"
                                        VerticalAlignment="Top"
                                        Command="{Binding ExportLibraryXlsxCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="10,5" FontSize="12"
                                        ToolTip="Export library to Excel (.xlsx) — opens in Excel, LibreOffice Calc, or Google Sheets"/>

                                <!-- Export all NFO sidecars for Kodi/Jellyfin/Plex -->
                                <Button Grid.Column="13" Content="📄 NFO"
                                        Height="{Binding ActualHeight, ElementName=LibraryFolderBox}"
                                        VerticalAlignment="Top"
                                        Command="{Binding ExportLibraryNfoCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="10,5" FontSize="12"
                                        ToolTip="Export .nfo sidecar files for all library entries — compatible with Kodi, Jellyfin, and Plex"/>

                                <!-- Load selected rows into Files panel (multi-select) -->
                                <Button Grid.Column="15"
                                        Height="{Binding ActualHeight, ElementName=LibraryFolderBox}"
                                        VerticalAlignment="Top"
                                        Content="{DynamicResource Lib.LoadSelected}"
                                        x:Name="LoadSelectedBtn"
                                        Click="LoadSelectedBtn_Click"
                                        Style="{StaticResource SecondaryButton}"
                                        ToolTip="Load all selected rows into the Files panel (Ctrl+Click or Shift+Click to select multiple)"/>

                                <Button Grid.Column="17" Content="⚙ Columns"
                                        Height="{Binding ActualHeight, ElementName=LibraryFolderBox}"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource SecondaryButton}"
                                        x:Name="ColChooserBtn"
                                        Click="ColChooserBtn_Click"
                                        ToolTip="Show/hide columns"/>
                                <Button Grid.Column="19"
                                        Height="{Binding ActualHeight, ElementName=LibraryFolderBox}"
                                        VerticalAlignment="Top"
                                        Content="{DynamicResource Lib.SaveLayout}"
                                        Command="{Binding SaveLibraryColumnLayoutCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="8,5" FontSize="12"
                                        ToolTip="Save the current column layout (visibility, order, widths) for this tab type. Movies and TV Shows saved independently. Restored on next launch."/>
                            </Grid>

                            <!-- Library folder tabs — ListBox handles selection natively -->
                            <ListBox Grid.Row="1"
                                     x:Name="LibraryTabList"
                                     ItemsSource="{Binding LibraryTabs}"
                                     SelectedItem="{Binding SelectedLibraryTab, Mode=TwoWay}"
                                     Margin="0,0,0,6"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     Visibility="{Binding HasMultipleTabs, Converter={StaticResource BoolVis}}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,4,0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="TabBorder"
                                                            Padding="10,5"
                                                            CornerRadius="4,4,0,0"
                                                            BorderThickness="1"
                                                            Background="{DynamicResource SurfaceAltBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            Cursor="Hand">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📁 " FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                            <TextBlock Text="{Binding Header}" FontSize="11"
                                                       VerticalAlignment="Center" MaxWidth="160"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ToolTipPath}"/>
                                            <Button Content="✕" Margin="8,0,0,0"
                                                    Padding="3,1" FontSize="10"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding DataContext.CloseLibraryTabCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Remove this library folder from view"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Filter bar -->
                            <Grid Grid.Row="2" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding LibraryFilterText, UpdateSourceTrigger=PropertyChanged}"
                                         conv:WatermarkHelper.Watermark="🔎  Filter by title, genre, director, year, cast…"
                                         Padding="8,5"/>
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                           Text="{Binding LibraryFilterCount}"
                                           Visibility="{Binding LibraryFilterText, Converter={StaticResource NullVis}}"/>
                            </Grid>

                            <!-- Progress row -->
                            <Grid Grid.Row="3" Margin="0,0,0,6"
                                  Visibility="{Binding IsLibraryScanning, Converter={StaticResource BoolVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding LibraryScanStatus}"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <ProgressBar Grid.Column="2"
                                             Value="{Binding LibraryScanProgress, Mode=OneWay}"
                                             Maximum="100" Height="8"
                                             VerticalAlignment="Center"/>
                            </Grid>



                            <!-- Library DataGrid -->
                            <!-- TV Tree View — filter/sort bar + tree with context menus -->
                            <Grid Grid.Row="4"
                                  Visibility="{Binding LibraryShowTreeView, Converter={StaticResource BoolVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Filter + Sort bar -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Filter box with inline placeholder (no AdornerLayer — adorners don't
                                         collapse with parent Visibility and bleed onto other tabs) -->
                                    <Grid Grid.Column="0" Margin="0,0,8,0">
                                        <TextBox x:Name="TvTreeFilterBox"
                                                 Text="{Binding TvTreeFilter, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="{DynamicResource SurfaceBrush}"
                                                 Foreground="{DynamicResource ForegroundBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}"
                                                 Padding="6,4"
                                                 FontSize="12"/>
                                        <TextBlock Text="🔎 Filter shows…"
                                                   IsHitTestVisible="False"
                                                   Padding="8,4" FontSize="12"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TvTreeFilter}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TvTreeFilter}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <ComboBox Grid.Column="1"
                                              SelectedValue="{Binding TvTreeSort}"
                                              SelectedValuePath="Tag"
                                              FontSize="12" MinWidth="140"
                                              ToolTip="Sort TV shows">
                                        <ComboBoxItem Tag="AZ"           Content="A → Z"/>
                                        <ComboBoxItem Tag="EpisodeCount" Content="Episode count"/>
                                        <ComboBoxItem Tag="RecentlyAdded" Content="Recently added"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Tree View -->
                                <TreeView Grid.Row="1"
                                          x:Name="LibraryTreeView"
                                          MouseDoubleClick="LibraryTree_DoubleClick"
                                          ItemsSource="{Binding TvShowTree}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          KeyDown="LibraryTree_KeyDown"
                                          VirtualizingPanel.IsVirtualizing="True">
                                    <TreeView.Resources>
                                        <!-- ── Show level ── -->
                                        <HierarchicalDataTemplate DataType="{x:Type models:TvShowNode}"
                                                                  ItemsSource="{Binding Seasons}">
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,3"
                                                        ToolTip="{Binding TooltipText}">
                                                <StackPanel.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="▶ Load all episodes into Files panel"
                                                                  Command="{Binding DataContext.TreeLoadShowCommand, Source={x:Reference LibraryTreeView}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="✓ Mark all watched"
                                                                  Command="{Binding DataContext.TreeMarkWatchedCommand, Source={x:Reference LibraryTreeView}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Header="○ Mark all unwatched"
                                                                  Command="{Binding DataContext.TreeMarkUnwatchedCommand, Source={x:Reference LibraryTreeView}}"
                                                                  CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </StackPanel.ContextMenu>
                                                <Border Width="36" Height="52" CornerRadius="3"
                                                        Background="{DynamicResource SurfaceVariantBrush}"
                                                        Margin="0,0,8,0" SnapsToDevicePixels="True">
                                                    <Image Source="{Binding CoverSource}"
                                                           Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ShowTitle}"
                                                               FontWeight="SemiBold" FontSize="13"
                                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                                    <TextBlock Text="{Binding EpisodeSummary}"
                                                               FontSize="11" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>

                                        <!-- ── Season level ── -->
                                        <HierarchicalDataTemplate DataType="{x:Type models:TvSeasonNode}"
                                                                  ItemsSource="{Binding Episodes}">
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                <StackPanel.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="▶ Load season into Files panel"
                                                                  Command="{Binding DataContext.TreeLoadSeasonCommand, Source={x:Reference LibraryTreeView}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="✓ Mark season watched"
                                                                  Command="{Binding DataContext.TreeMarkWatchedCommand, Source={x:Reference LibraryTreeView}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Header="○ Mark season unwatched"
                                                                  Command="{Binding DataContext.TreeMarkUnwatchedCommand, Source={x:Reference LibraryTreeView}}"
                                                                  CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </StackPanel.ContextMenu>
                                                <TextBlock Text="{Binding Label}"
                                                           FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                                <TextBlock Text="{Binding WatchedLabel}"
                                                           FontSize="11" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>

                                        <!-- ── Episode level ── -->
                                        <DataTemplate DataType="{x:Type models:LibraryEntry}">
                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                                <StackPanel.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="▶ Load into Files panel"
                                                                  Command="{Binding DataContext.TreeLoadEpisodeCommand, Source={x:Reference LibraryTreeView}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Header="📂 Open file location"
                                                                  Command="{Binding DataContext.TreeOpenLocationCommand, Source={x:Reference LibraryTreeView}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Header="📋 Copy path"
                                                                  Command="{Binding DataContext.TreeCopyPathCommand, Source={x:Reference LibraryTreeView}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="✓ Mark watched"
                                                                  Command="{Binding DataContext.TreeMarkWatchedCommand, Source={x:Reference LibraryTreeView}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Header="○ Mark unwatched"
                                                                  Command="{Binding DataContext.TreeMarkUnwatchedCommand, Source={x:Reference LibraryTreeView}}"
                                                                  CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </StackPanel.ContextMenu>
                                                <!-- Missing episode indicator -->
                                                <TextBlock Text="⚠"
                                                           FontSize="11" Margin="0,0,4,0"
                                                           Foreground="#E0A020"
                                                           ToolTip="Episode file not found in library">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMissingEpisode}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- Watched indicator -->
                                                <TextBlock Text="✓"
                                                           FontSize="11" Margin="0,0,4,0"
                                                           Foreground="{DynamicResource AccentBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWatched}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding EpisodeCodeDisplay}"
                                                           FontSize="12" Margin="0,0,6,0"
                                                           Foreground="{DynamicResource ForegroundMutedBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMissingEpisode}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding EpisodeTitle}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource ForegroundBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMissingEpisode}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.4"/>
                                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsWatched}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.65"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </TreeView.Resources>
                                </TreeView>
                            </Grid>

                            <DataGrid Grid.Row="4"
                                      x:Name="LibraryGrid"
                                      Visibility="{Binding LibraryShowDataGrid, Converter={StaticResource BoolVis}}"
                                      ItemsSource="{Binding LibraryView}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserReorderColumns="True"
                                      CanUserResizeColumns="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ColumnWidth="SizeToCells"
                                      CanUserSortColumns="True"
                                      GridLinesVisibility="None"
                                      VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                                      HeadersVisibility="Column"
                                      SelectionMode="Extended"
                                      RowHeight="52"
                                      FontSize="12"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.IsDeferredScrollingEnabled="False"
                                      MouseDoubleClick="LibraryGrid_MouseDoubleClick"
                                      ColumnReordered="LibraryGrid_ColumnReordered"
                                      Background="Transparent"
                                      BorderThickness="1"
                                      BorderBrush="{DynamicResource BorderBrush}"
                                      AlternationCount="2">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                        <!-- Subtle right border on each header to align with cell separators -->
                                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                    </Style>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="AlternationIndex" Value="1">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                                <Setter Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#3007A7E3"/>
                                                <Setter Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="8,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <!-- Thin right border creates the column divider line -->
                                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <!-- Cover art -->
                                    <DataGridTemplateColumn Header="Cover" Width="44" CanUserSort="False" x:Name="ColCover">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Image Width="32" Height="48"
                                                       Source="{Binding CoverSource}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="LowQuality"
                                                       SnapsToDevicePixels="True"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Title"      Binding="{Binding Title}"          Width="200" x:Name="ColTitle"/>
                                    <DataGridTextColumn Header="Year"       Binding="{Binding Year}"           Width="55"  x:Name="ColYear"/>
                                    <DataGridTextColumn Header="Genre"      Binding="{Binding Genre}"          Width="110" x:Name="ColGenre"/>
                                    <DataGridTextColumn Header="Director"   Binding="{Binding Director}"       Width="130" x:Name="ColDirector"/>
                                    <DataGridTextColumn Header="Cast"       Binding="{Binding Cast}"           Width="180" x:Name="ColCast"/>
                                    <DataGridTextColumn Header="Rating"     Binding="{Binding RatingDisplay}"  Width="60"  x:Name="ColRating"/>
                                    <DataGridTextColumn Header="MPA"        Binding="{Binding MpaRatingDisplay}" Width="55"  x:Name="ColMpa"/>
                                    <DataGridTextColumn Header="Duration"   Binding="{Binding Duration}"       Width="70"  x:Name="ColDuration"/>
                                    <DataGridTextColumn Header="Size"       Binding="{Binding FileSizeDisplay}" Width="75" x:Name="ColSize"/>
                                    <DataGridTextColumn Header="Format"     Binding="{Binding Format}"         Width="58"  x:Name="ColFormat"/>
                                    <DataGridTextColumn Header="Resolution" Binding="{Binding Resolution}"     Width="90"  x:Name="ColRes"/>
                                    <DataGridTextColumn Header="Added"      Binding="{Binding DownloadDateDisplay}" Width="90" x:Name="ColDate"/>
                                    <DataGridTextColumn Header="IMDB ID"    Binding="{Binding ImdbId}"         Width="90"  x:Name="ColImdb"/>
                                    <DataGridTextColumn Header="Subtitles"  Binding="{Binding SubtitleSummary}" Width="130" x:Name="ColSubs"
                                                                        Visibility="Collapsed"
                                                                        ElementStyle="{StaticResource BaseText}"/>
                                    <DataGridTextColumn Header="Synopsis"   Binding="{Binding Description}"    Width="220" x:Name="ColDesc"/>
                                    <!-- TV-specific columns — hidden by default, shown when TV tab is active -->
                                    <DataGridTextColumn Header="Show Title"    Binding="{Binding ShowTitle}"     Width="180" x:Name="ColShow"     Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="Season"        Binding="{Binding SeasonDisplay}" Width="60"  x:Name="ColSeason"  Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="Episode"       Binding="{Binding EpisodeDisplay}" Width="65" x:Name="ColEpNum"   Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="Episode Title" Binding="{Binding EpisodeTitle}"  Width="200" x:Name="ColEpTitle" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="Aired"         Binding="{Binding AiredDate}"     Width="90"  x:Name="ColAired"   Visibility="Collapsed"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Bottom hint + watch status + file count -->
                            <Grid Grid.Row="5" Margin="0,4,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- File count + scan status (top row) -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           FontSize="12" Margin="0,0,0,4"
                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                           Visibility="{Binding IsLibraryScanning, Converter={StaticResource InvBoolVis}}">
                                    <Run Text="{Binding LibraryEntries.Count, Mode=OneWay}"/>
                                    <Run Text=" file(s) in library  ·  "/>
                                    <Run Text="{Binding LibraryScanStatus, Mode=OneWay}"/>
                                </TextBlock>

                                <!-- Hint text (bottom row) -->
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           FontSize="11"
                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                           TextWrapping="Wrap">
                                    Double-click a row to load into Files panel. Ctrl+Click or Shift+Click + 📥 Load Selected for multi-select.
                                    Sort by clicking column headers. Drag to reorder. ⚙ Columns to show/hide.
                                </TextBlock>
                                <Border Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" Padding="8,3" CornerRadius="4"
                                        Background="#1A4CAF50" BorderBrush="#4CAF50" BorderThickness="1"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding LibraryWatchEnabled, Converter={StaticResource BoolVis}}"
                                        ToolTip="Library Watch active — new files added to this folder appear in the grid automatically.">
                                    <TextBlock Text="👁 Watching" FontSize="11" Foreground="#2E7D32"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- ══════════════════════════════════════════════════════ -->
                    <!-- TAB 4 — HELP -->
                    <!-- ══════════════════════════════════════════════════════ -->
                    <TabItem Header="🔍 DUPLICATES"
                             Visibility="{Binding DuplicatesTabVisible}">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header row -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="Duplicate File Scanner"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,2,0,0">
                                    Scans for duplicate video files by size, metadata, content hash, and alternate versions.
                                    Finds same-title files at different quality (different file sizes), TV episode duplicates,
                                    and exact copies. Select a group and use Compare Side-by-Side to visually identify which to keep.
                                </TextBlock>
                            </StackPanel>

                            <!-- Folder + controls row -->
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- Row 0: labels  ·  Row 1: folder textboxes + scan buttons  ·
                                     Row 2: deep-scan progress bar  ·  Row 3: smart-select & auto-resolve toolbar  ·
                                     Row 4: include-subfolders + move-instead-of-delete options -->

                                <!-- Labels -->
                                <Grid Grid.Row="0" Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SOURCE FOLDER"
                                               Style="{StaticResource LabelText}"/>
                                    <TextBlock Grid.Column="2" Text="DESTINATION FOLDER (optional — for Move, or to compare two folders)"
                                               Style="{StaticResource LabelText}"
                                               ToolTip="Leave empty to scan only the Source folder. Set this only if you want to compare two different folders, or use Move-to-Destination instead of Delete."/>
                                </Grid>

                                <!-- Input row — Scan button aligned exactly with the textboxes -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Source -->
                                    <Grid Grid.Column="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" IsReadOnly="True"
                                                 Text="{Binding DuplicatesVM.SourceFolder}"
                                                 ToolTip="{Binding DuplicatesVM.SourceFolder}"/>
                                        <Button Grid.Column="1" Content="📂 Browse"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DuplicatesVM.BrowseSourceCommand}"
                                                Margin="4,0,0,0"/>
                                        <Button Grid.Column="2" Content="✕ Clear"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DuplicatesVM.ClearSourceCommand}"
                                                Margin="4,0,0,0" Padding="10,0"
                                                ToolTip="Clear the Source folder path (the textbox is read-only by design — use this button to clear it)"/>
                                    </Grid>

                                    <!-- Destination -->
                                    <Grid Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" IsReadOnly="True"
                                                 Text="{Binding DuplicatesVM.DestinationFolder}"
                                                 ToolTip="{Binding DuplicatesVM.DestinationFolder}"/>
                                        <Button Grid.Column="1" Content="📂 Browse"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DuplicatesVM.BrowseDestinationCommand}"
                                                Margin="4,0,0,0"/>
                                        <Button Grid.Column="2" Content="✕ Clear"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DuplicatesVM.ClearDestinationCommand}"
                                                Margin="4,0,0,0" Padding="10,0"
                                                ToolTip="Clear the Destination folder path (leave empty to scan only the Source folder)"/>
                                    </Grid>

                                    <!-- Scan + Cancel — same row, same height as textboxes -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                VerticalAlignment="Stretch">
                                        <Button Content="🔍 Scan for Duplicates"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding DuplicatesVM.ScanCommand}"
                                                Margin="0,0,6,0"/>
                                        <Button Content="✕ Cancel"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DuplicatesVM.CancelScanCommand}"
                                                Visibility="{Binding DuplicatesVM.IsScanning, Converter={StaticResource BoolVis}}"/>

                                        <!-- Deep Scan separator -->
                                        <Separator Margin="8,4" Width="1"
                                                   Background="{DynamicResource BorderBrush}"/>

                                        <!-- Deep Scan button — enabled only when fpcalc.exe is present -->
                                        <Button Margin="0,0,4,0"
                                                Command="{Binding DuplicatesVM.DeepScanCommand}"
                                                IsEnabled="{Binding DuplicatesVM.ChromaprintAvailable}"
                                                ToolTip="Audio fingerprint scan — finds duplicates at different quality/size. ~3s per file.">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                    <Setter Property="Content" Value="♪ Deep Scan"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DuplicatesVM.IsDeepScanning}" Value="True">
                                                            <Setter Property="Content" Value="♪ Scanning…"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <!-- Version label when installed -->
                                        <TextBlock Text="{Binding DuplicatesVM.FpcalcVersion}"
                                                   VerticalAlignment="Center" FontSize="10"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   Margin="0,0,6,0"
                                                   Visibility="{Binding DuplicatesVM.ChromaprintAvailable, Converter={StaticResource BoolVis}}"/>
                                        <!-- Install/Update button when missing or outdated -->
                                        <Button Margin="0,0,4,0"
                                                Command="{Binding DuplicatesVM.InstallFpcalcCommand}"
                                                ToolTip="Download and install fpcalc.exe from github.com/acoustid/chromaprint (auto-detects latest version)">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                    <Setter Property="Content" Value="⬇ Install fpcalc"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DuplicatesVM.ChromaprintAvailable}" Value="True">
                                                            <Setter Property="Content" Value="⬆ Check Update"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DuplicatesVM.IsInstallingFpcalc}" Value="True">
                                                            <Setter Property="Content" Value="⬇ Installing…"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="⬛ Stop"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DuplicatesVM.CancelDeepScanCommand}"
                                                Visibility="{Binding DuplicatesVM.IsDeepScanning, Converter={StaticResource BoolVis}}"/>

                                        <!-- Reference scan + cache management -->
                                        <Separator Margin="8,4" Width="1"
                                                   Background="{DynamicResource BorderBrush}"/>
                                        <Button Content="🔎 Find Duplicates of File…"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DuplicatesVM.FindByReferenceFileCommand}"
                                                Padding="10,6" Margin="0,0,4,0"
                                                ToolTip="Pick a single reference file. The library is scanned for any file with matching audio fingerprint. O(n) — much faster than full Deep Scan."/>
                                        <Button Content="💾"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DuplicatesVM.ExportFingerprintCacheCommand}"
                                                Padding="8,6" Margin="0,0,2,0"
                                                ToolTip="Export fingerprint cache to a .json backup file"/>
                                        <Button Content="📂"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DuplicatesVM.ImportFingerprintCacheCommand}"
                                                Padding="8,6" Margin="0,0,0,0"
                                                ToolTip="Import a previously-exported fingerprint cache. Restart required."/>
                                    </StackPanel>
                                </Grid>

                                <!-- Deep Scan progress — Row 2, OUTSIDE the column grid so it spans full width -->
                                <StackPanel Grid.Row="2" Margin="0,6,0,0"
                                            Visibility="{Binding DuplicatesVM.IsDeepScanning,
                                                Converter={StaticResource BoolVis}}">
                                    <ProgressBar Value="{Binding DuplicatesVM.DeepScanProgress, Mode=OneWay}"
                                                 Minimum="0" Maximum="100"
                                                 Height="6" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding DuplicatesVM.DeepScanStatus}"
                                               FontSize="11"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <!-- Status after completion — shown when not scanning -->
                                <TextBlock Grid.Row="2"
                                           Text="{Binding DuplicatesVM.DeepScanStatus}"
                                           FontSize="11" Margin="0,4,0,0"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Visibility="{Binding DuplicatesVM.IsDeepScanning,
                                               Converter={StaticResource InvBoolVis}}"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Smart Selection & Auto-Resolve toolbar (Grid.Row 3) -->
                                <Border Grid.Row="3" Margin="0,8,0,4"
                                        Background="{DynamicResource SurfaceVariantBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,1,0,1" Padding="6,4"
                                        Visibility="{Binding DuplicatesVM.HasGroups, Converter={StaticResource BoolVis}}">
                                    <WrapPanel Orientation="Horizontal">
                                        <TextBlock Text="Smart Select:" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" FontSize="11" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <Button Content="🅢 Smaller" Padding="8,3" Margin="0,0,4,0"
                                                Command="{Binding DuplicatesVM.SelectSmallerEverywhereCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                ToolTip="Select the smaller file in every group (likely the lower-quality copy)"/>
                                        <Button Content="🅛 Larger" Padding="8,3" Margin="0,0,4,0"
                                                Command="{Binding DuplicatesVM.SelectLargerEverywhereCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                ToolTip="Select the larger file in every group"/>
                                        <Button Content="🅤 Untagged" Padding="8,3" Margin="0,0,4,0"
                                                Command="{Binding DuplicatesVM.SelectUntaggedEverywhereCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                ToolTip="Select the file with no embedded title/metadata in every group"/>
                                        <Button Content="📁 In Unsorted" Padding="8,3" Margin="0,0,12,0"
                                                Command="{Binding DuplicatesVM.SelectInUnsortedCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                ToolTip="Select files located in any \Unsorted\ folder"/>

                                        <TextBlock Text="Auto-Resolve:" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" FontSize="11" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <Button Content="⚙ Keep Largest" Padding="8,3" Margin="0,0,4,0"
                                                Command="{Binding DuplicatesVM.AutoResolveKeepLargestCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                ToolTip="For each group: keep the largest file, mark all others for deletion"/>
                                        <Button Content="⚙ Keep Newest" Padding="8,3" Margin="0,0,4,0"
                                                Command="{Binding DuplicatesVM.AutoResolveKeepNewestCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                ToolTip="For each group: keep the most recently created file, mark older copies for deletion"/>
                                        <Button Content="⚙ Keep Tagged" Padding="8,3" Margin="0,0,12,0"
                                                Command="{Binding DuplicatesVM.AutoResolveKeepTaggedCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                ToolTip="For each group: keep files with embedded metadata, mark untagged copies for deletion"/>

                                        <Button Content="✕ Clear Selections" Padding="8,3" Margin="0,0,12,0"
                                                Command="{Binding DuplicatesVM.ClearAllSelectionsCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                ToolTip="Deselect all files in all groups"/>

                                        <!-- Bulk delete — operates on every IsSelected=true file across all groups -->
                                        <Button Padding="10,3" Margin="0,0,12,0"
                                                Command="{Binding DuplicatesVM.DeleteAllSelectedCommand}"
                                                ToolTip="Delete (or Move) every selected file across all groups in one action. Files go to Recycle Bin by default.">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                    <Setter Property="Content" Value="🗑 Delete Selected"/>
                                                    <Setter Property="Background" Value="#C62828"/>
                                                    <Setter Property="BorderBrush" Value="#B71C1C"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DuplicatesVM.MoveInsteadOfDelete}" Value="True">
                                                            <Setter Property="Content" Value="📤 Move Selected"/>
                                                            <Setter Property="Background" Value="#1976D2"/>
                                                            <Setter Property="BorderBrush" Value="#0D47A1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Live selection summary — disk space reclaim preview -->
                                        <Border Background="{DynamicResource AccentBrush}" Padding="8,3" CornerRadius="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DuplicatesVM.SelectedFileCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock VerticalAlignment="Center" Foreground="White" FontSize="11">
                                                <Run Text="📊 "/>
                                                <Run Text="{Binding DuplicatesVM.SelectedFileCount, Mode=OneWay}"/>
                                                <Run Text=" selected · "/>
                                                <Run Text="{Binding DuplicatesVM.SelectedFilesSize, Mode=OneWay}"/>
                                                <Run Text=" to recover"/>
                                            </TextBlock>
                                        </Border>
                                    </WrapPanel>
                                </Border>

                                <!-- Options row -->
                                <WrapPanel Grid.Row="4" Orientation="Horizontal">
                                    <CheckBox Content="Include subfolders"
                                              IsChecked="{Binding DuplicatesVM.IncludeSubfolders}"
                                              VerticalAlignment="Center" Margin="0,0,20,0"/>
                                    <CheckBox Content="Move to Destination instead of Delete"
                                              IsChecked="{Binding DuplicatesVM.MoveInsteadOfDelete}"
                                              VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <TextBlock FontSize="11" VerticalAlignment="Center"
                                               Margin="0,0,16,0"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                               Visibility="{Binding DuplicatesVM.MoveInsteadOfDelete, Converter={StaticResource BoolVis}}">
                                        <Run Text="Engine: "/>
                                        <Run Text="{Binding DuplicatesVM.ActiveEngineLabel, Mode=OneWay}"
                                             FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding DuplicatesVM.ScanSummaryLine}"
                                               FontSize="11" FontStyle="Italic"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                               VerticalAlignment="Center"/>
                                </WrapPanel>
                            </Grid>

                            <!-- Progress bar -->
                            <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="0,0,0,8"
                                        Visibility="{Binding DuplicatesVM.IsScanning, Converter={StaticResource BoolVis}}">
                                <ProgressBar Height="6" Value="{Binding DuplicatesVM.ScanProgress}"
                                             Maximum="100" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding DuplicatesVM.ScanStatus}"
                                           FontSize="11" Foreground="{DynamicResource ForegroundMutedBrush}"/>
                            </StackPanel>

                            <!-- Results split panel -->
                            <Grid Grid.Row="2"
                                  Visibility="{Binding DuplicatesVM.IsIdle, Converter={StaticResource BoolVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="300"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*" MinWidth="320"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: groups + files tree -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Groups header + count -->
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="DUPLICATE GROUPS"
                                                   Style="{StaticResource LabelText}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DuplicatesVM.GroupCountLabel}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Groups list with empty state overlay -->
                                    <Grid Grid.Row="1">
                                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                Visibility="{Binding DuplicatesVM.HasNoGroups, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding DuplicatesVM.EmptyGroupsHint}"
                                                       FontSize="12" FontStyle="Italic"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap" Margin="12" MaxWidth="220"
                                                       TextAlignment="Center"/>
                                        </Border>
                                        <ListBox ItemsSource="{Binding DuplicatesVM.Groups}"
                                                 SelectedItem="{Binding DuplicatesVM.SelectedGroup}"
                                                 BorderBrush="{DynamicResource BorderBrush}"
                                                 BorderThickness="1"
                                                 Visibility="{Binding DuplicatesVM.HasGroups, Converter={StaticResource BoolVis}}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="4,3">
                                                        <TextBlock Text="{Binding GroupSizeLabel}"
                                                                   FontWeight="SemiBold" FontSize="12"
                                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                                        <TextBlock Text="{Binding Reason}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>

                                    <!-- Files in group header + quick-select buttons -->
                                    <Grid Grid.Row="2" Margin="0,8,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="FILES IN GROUP"
                                                   Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Oldest"
                                                Style="{StaticResource SecondaryButton}"
                                                FontSize="10" Padding="6,2"
                                                Command="{Binding DuplicatesVM.SelectOldestCommand}"
                                                ToolTip="Select the file with the earliest creation date"
                                                Visibility="{Binding DuplicatesVM.HasSelectedGroup, Converter={StaticResource BoolVis}}"/>
                                        <Button Grid.Column="3" Content="Newest"
                                                Style="{StaticResource SecondaryButton}"
                                                FontSize="10" Padding="6,2"
                                                Command="{Binding DuplicatesVM.SelectNewestCommand}"
                                                ToolTip="Select the file with the latest creation date"
                                                Visibility="{Binding DuplicatesVM.HasSelectedGroup, Converter={StaticResource BoolVis}}"/>
                                    </Grid>

                                    <!-- Files list -->
                                    <ListBox Grid.Row="3"
                                             ItemsSource="{Binding DuplicatesVM.SelectedGroup.Files}"
                                             SelectedItem="{Binding DuplicatesVM.SelectedFile}"
                                             BorderBrush="{DynamicResource BorderBrush}"
                                             BorderThickness="1">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- IsSelected checkbox — for Smart Select / Auto-Resolve / Delete Selected workflow -->
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,8,0"
                                                              ToolTip="Mark this file for batch deletion. Use Smart Select or Auto-Resolve buttons above to set across all groups."/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding FileName}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding FilePath}"
                                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                                        <TextBlock FontSize="11"
                                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding FileSizeDisplay, Mode=OneWay}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding CreatedDisplay, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding FolderPath}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding FolderPath}"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Padding="4,2" Margin="4,0,0,0"
                                                            CornerRadius="3" VerticalAlignment="Top"
                                                            Background="{Binding FolderBadgeColor}">
                                                        <TextBlock Text="{Binding FolderBadgeLabel}"
                                                                   FontSize="10" FontWeight="Bold"
                                                                   Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>

                                <!-- Splitter -->
                                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                                              Background="{DynamicResource BorderBrush}"/>

                                <!-- Right: file details -->
                                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding DuplicatesVM.HasSelectedFile, Converter={StaticResource BoolVis}}">
                                    <StackPanel Margin="12,0,0,0">
                                        <TextBlock Text="FILE DETAILS"
                                                   Style="{StaticResource LabelText}" Margin="0,0,0,8"/>

                                        <!-- File identity -->
                                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DuplicatesVM.SelectedFile.FileName}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                                <TextBlock Text="{Binding DuplicatesVM.SelectedFile.FolderPath}"
                                                           FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- File system info -->
                                        <TextBlock Text="FILE SYSTEM" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Size:" Style="{StaticResource LabelText}" FontSize="11"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DuplicatesVM.SelectedFile.FileSizeDisplay}" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Format:" Style="{StaticResource LabelText}" FontSize="11"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DuplicatesVM.SelectedFile.Format}" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Created:" Style="{StaticResource LabelText}" FontSize="11"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DuplicatesVM.SelectedFile.CreatedDisplay}" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Modified:" Style="{StaticResource LabelText}" FontSize="11"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DuplicatesVM.SelectedFile.ModifiedDisplay}" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                                        </Grid>

                                        <!-- Technical info -->
                                        <TextBlock Text="TECHNICAL" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Resolution:" Style="{StaticResource LabelText}" FontSize="11"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DuplicatesVM.SelectedFile.Resolution}" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Video Codec:" Style="{StaticResource LabelText}" FontSize="11"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DuplicatesVM.SelectedFile.VideoCodec}" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Audio Codec:" Style="{StaticResource LabelText}" FontSize="11"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DuplicatesVM.SelectedFile.AudioCodec}" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Duration:" Style="{StaticResource LabelText}" FontSize="11"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DuplicatesVM.SelectedFile.Duration}" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                                        </Grid>

                                        <!-- Metadata -->
                                        <TextBlock Text="EMBEDDED METADATA" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Title:" Style="{StaticResource LabelText}" FontSize="11"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DuplicatesVM.SelectedFile.Title}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundBrush}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Year:" Style="{StaticResource LabelText}" FontSize="11"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DuplicatesVM.SelectedFile.Year}" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="IMDB:" Style="{StaticResource LabelText}" FontSize="11"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DuplicatesVM.SelectedFile.ImdbId}" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Rating:" Style="{StaticResource LabelText}" FontSize="11"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DuplicatesVM.SelectedFile.RatingDisplay}" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Director:" Style="{StaticResource LabelText}" FontSize="11"/>
                                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DuplicatesVM.SelectedFile.Director}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundBrush}"/>
                                        </Grid>

                                        <!-- Action buttons -->
                                        <Separator Margin="0,0,0,10"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Button Content="🎬 Compare Side-by-Side"
                                                    Padding="12,6" Margin="0,0,10,0"
                                                    Command="{Binding DuplicatesVM.PreviewGroupCommand}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    ToolTip="Open side-by-side video comparison for the selected duplicate group. Both files play together — delete the one you don&#x27;t want."/>
                                            <Button Content="{Binding DuplicatesVM.DeleteButtonLabel}"
                                                    Padding="10,6" Background="#C62828" Foreground="White" BorderBrush="#B71C1C" BorderThickness="1"
                                                    Command="{Binding DuplicatesVM.DeleteSelectedCommand}"
                                                    Margin="0,0,8,0"/>
                                        </StackPanel>
                                        <TextBlock FontSize="11" FontStyle="Italic"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   TextWrapping="Wrap">
                                            You will be asked to confirm before any file is removed.
                                            Deletes are permanent. Enable "Move to Destination" above to
                                            send duplicates to a folder instead.
                                        </TextBlock>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Empty state -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding DuplicatesVM.HasSelectedFile, Converter={StaticResource InvBoolVis}}">
                                    <TextBlock Text="Select a file from the list" FontSize="14"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="to see its details here" FontSize="14"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Status bar -->
                            <TextBlock Grid.Row="3" Margin="0,8,0,0"
                                       Text="{Binding DuplicatesVM.ScanStatus}"
                                       FontSize="11"
                                       Foreground="{DynamicResource ForegroundMutedBrush}"/>
                        </Grid>
                    </TabItem>

                    <!-- ═══ MEDIA HEALTH CHECK ═══ -->
                    <TabItem Header="📋 HEALTH CHECK">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Intro -->
                            <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Foreground="{DynamicResource ForegroundMutedBrush}" FontSize="12">
                                Scans files for compliance problems that cause metadata-embed failures,
                                playback issues, or slow seeking. Detection is read-only. Stage 2 fixes
                                (faststart / remux) use ffmpeg and are lossless stream-copies — no re-encode.
                            </TextBlock>

                            <!-- Folder picker -->
                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" IsReadOnly="True"
                                         Text="{Binding MediaHealthVM.Folder}"
                                         ToolTip="{Binding MediaHealthVM.Folder}"/>
                                <Button Grid.Column="1" Content="📂 Browse"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="4,0,0,0"
                                        Click="BrowseHealthFolder_Click"/>
                                <Button Grid.Column="2" Content="✕ Clear"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="4,0,0,0" Padding="10,0"
                                        Command="{Binding MediaHealthVM.ClearFolderCommand}"
                                        ToolTip="Clear the selected folder and results"/>
                                <CheckBox Grid.Column="3" Content="Include subfolders"
                                          IsChecked="{Binding MediaHealthVM.IncludeSubfolders}"
                                          VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>

                            <!-- Controls -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="📋 Scan for Problems"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding MediaHealthVM.ScanCommand}"
                                        Margin="0,0,6,0"/>
                                <Button Content="✕ Cancel"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding MediaHealthVM.CancelCommand}"
                                        Margin="0,0,6,0"
                                        Visibility="{Binding MediaHealthVM.IsScanning, Converter={StaticResource BoolVis}}"/>
                                <Button Content="📋 Copy Report"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding MediaHealthVM.CopyReportCommand}"
                                        Margin="0,0,16,0"/>

                                <!-- Stage 2 fix -->
                                <Button Style="{StaticResource SecondaryButton}"
                                        Command="{Binding MediaHealthVM.FixAllFaststartCommand}"
                                        ToolTip="Losslessly add faststart (move moov atom to front) to all flagged MP4s using ffmpeg. No re-encode.">
                                    <Button.Content>
                                        <TextBlock>
                                            <Run Text="⚡ Fix All Faststart ("/>
                                            <Run Text="{Binding MediaHealthVM.FaststartFixableCount, Mode=OneWay}"/>
                                            <Run Text=")"/>
                                        </TextBlock>
                                    </Button.Content>
                                </Button>

                                <!-- Fix all auto-fixable issues in sequence -->
                                <Button Content="🔧 Fix All Issues"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="12,6"
                                        Command="{Binding MediaHealthVM.FixAllIssuesCommand}"
                                        ToolTip="Auto-fix all fixable issues in sequence: rename extension mismatches, then fix faststart. ZeroBytes and unreadable files are skipped — they require manual intervention."/>
                                <Button Padding="12,6"
                                        Command="{Binding MediaHealthVM.ReembedSemicolonCommand}"
                                        ToolTip="Loads files flagged for a semicolon in their stored comment into the FILES panel so you can re-fetch metadata and Embed cleanly on this build. Semicolon files are not touched by Fix All Issues because the remedy is re-embedding, not remuxing.">
                                    <TextBlock>
                                        <Run Text="📝 Re-embed Semicolon Files ("/><Run Text="{Binding MediaHealthVM.SemicolonFlaggedCount, Mode=OneWay}"/><Run Text=")"/>
                                    </TextBlock>
                                </Button>
                            </StackPanel>

                            <!-- Progress + summary + ffmpeg status -->
                            <StackPanel Grid.Row="3" Margin="0,0,0,8">
                                <!-- Prominent warning while files are being mutated -->
                                <Border Background="#C62828" CornerRadius="4" Padding="10,6" Margin="0,0,0,6"
                                        Visibility="{Binding MediaHealthVM.IsFixing, Converter={StaticResource BoolVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠" FontSize="16" Foreground="White"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Foreground="White" FontWeight="SemiBold" FontSize="12"
                                                   VerticalAlignment="Center" TextWrapping="Wrap">
                                            Fixing files — please don't close the app until this finishes.
                                            Closing now can leave incomplete .faststart.tmp files behind.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <ProgressBar Value="{Binding MediaHealthVM.Progress, Mode=OneWay}"
                                             Minimum="0" Maximum="100" Height="6" Margin="0,0,0,4"
                                             Visibility="{Binding MediaHealthVM.IsScanning, Converter={StaticResource BoolVis}}"/>
                                <TextBlock Text="{Binding MediaHealthVM.Status}" FontSize="11"
                                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                <TextBlock Text="{Binding MediaHealthVM.SummaryLine}" FontSize="12"
                                           FontWeight="SemiBold" Margin="0,2,0,0"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding MediaHealthVM.FfmpegStatus}" FontSize="11"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                            </StackPanel>

                            <!-- Results -->
                            <DataGrid Grid.Row="4"
                                      ItemsSource="{Binding MediaHealthVM.Results}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      CanUserResizeColumns="True" CanUserSortColumns="True"
                                      x:Name="HealthGrid">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="✏ Fix Extension (rename only — no remux needed)"
                                                  Click="HealthFixExtension_Click"/>
                                        <MenuItem Header="🔧 Remux to .mkv (fix tagging issues)"
                                                  Click="RemuxToMkv_Click"/>
                                        <MenuItem Header="🔧 Remux to .mp4 (fix + faststart)"
                                                  Click="RemuxToMp4_Click"/>
                                        <Separator/>
                                        <MenuItem Header="📂 Open containing folder"
                                                  Click="HealthOpenFolder_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="36">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock HorizontalAlignment="Center" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="✓"/>
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                    <Setter Property="Text" Value="⚠"/>
                                                                    <Setter Property="Foreground" Value="#F9A825"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                    <Setter Property="Text" Value="✕"/>
                                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*"/>
                                    <DataGridTextColumn Header="Ext" Binding="{Binding Extension}" Width="60"/>
                                    <DataGridTextColumn Header="Container" Binding="{Binding DetectedContainer}" Width="90"/>
                                    <DataGridTextColumn Header="Issue" Binding="{Binding Detail}" Width="3*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Suggested Fix" Binding="{Binding SuggestedFix}" Width="3*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{DynamicResource Tab.Help}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="24" MaxWidth="700">

                                <!-- Version info -->
                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        CornerRadius="8" Padding="16" Margin="0,0,0,20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Video Metadata Editor"
                                                       FontSize="18" FontWeight="Bold"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                            <TextBlock Text="{Binding AppVersionFull, Mode=OneTime}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                       Margin="0,4,0,2"/>
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}">
                                                Self-contained portable application · Windows x64
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="🎬" FontSize="40"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Features -->
                                <TextBlock Text="Features" Style="{StaticResource SectionHeader}"/>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,4">📝 Metadata</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Reads all embedded tags on load — artwork lazy-loaded per file in FILES panel</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• TMDB + OMDB search with 3× retry, back-off, session cache; batch search skips poster downloads</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Direct lookup by IMDB ID (tt…) or TMDB numeric ID</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Embeds title, year, genre, director, cast, IMDb rating, MPA rating, description, IDs, artwork</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Write engine: temp-copy → tag write → atomic File.Replace → backup cleanup</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Artwork preserved in batch for files never manually selected</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Undo Last Embed — restores previous tags and filename in one click</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Export .nfo sidecar (Kodi format, read by Plex/Jellyfin/Emby) — movie, episode, and optional tvshow.nfo; multi-episode blocks; &lt;uniqueid&gt; (tmdb/imdb/tvdb), &lt;ratings&gt; with votes, &lt;actor&gt; order, &lt;mpaa&gt;</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Import .nfo sidecar (📥 Import NFO) — reads movie/episode/tvshow NFOs (modern + legacy ID and rating formats) into the editable fields for review; nothing written until you Apply + Embed; single + batch</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Batch Edit Fields (✎) — apply shared Genre, Cast (Replace or Append, de-duplicated), Director, MPA, Year, Show title, or Watched across all selected files at once; per-file-unique fields excluded; reversible via Undo Batch; fields that don't apply to the selection are greyed</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Export Artwork (🖼) — writes the poster as a sidecar image next to each file (Kodi &lt;video&gt;-poster.jpg or Plex/Jellyfin folder poster.jpg, chosen in Settings); source chain in-memory → embedded → TMDB</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,8,0,4">📁 File Management</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Rename tokens: {Title} {Year} {Genre} {Director} {Cast} {Rating} {MPA} {ImdbId} {TmdbId} {Resolution} {Format} {Season} {Episode} {AbsoluteEpisode} {ShowTitle} {EpisodeTitle}</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Rename grammar: conditional blocks &lt; &gt; (dropped if any token inside is empty), zero-padding {Episode:00}, multi-episode range expansion (S01E01-E03), and {AbsoluteEpisode} for anime (filename-first, AniList fallback)</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Colon → " - " (Mission: Impossible → Mission - Impossible)</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Move/Copy: FastCopy or multi-threaded Custom Fast; disk space check; conflict modes; destination and conflict mode auto-saved; Smart Organisation routes Movies and TV Episodes to separate subfolders automatically</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Lock/Unlock read-only attribute; Delete with confirmation</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,8,0,4">⚡ Batch Processing</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Auto-searches then embeds + renames all selected files concurrently</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Drive-tuned workers: NVMe=8, SSD=6, USB=4, HDD=2, Network=1</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Cancel works for all operations; Bulk Artwork Download; ⚠ Next Error button for batch failures</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,8,0,4">📚 Library</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Three-tier scan cache (sub-3s rescan); MPA + TV columns (Show, S/Ep, Episode Title, Aired, Type) — hidden by default, show via ⚙ Columns</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Sortable, resizable, reorderable columns — layout saved; Export CSV and Export XLSX; scan status shows cache vs disk reads</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Double-click or multi-select Load Selected; separator rows on mixed loads</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Library entry syncs in-place after embed — no re-scan required</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,8,0,4">📁 Watch Folder · Library Watch</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• FILES panel: FileSystemWatcher (instant) + background poll; FSW auto-restarts on error; monitors every folder your loaded files came from (not just one), so new files in any source folder are detected</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• New files highlighted yellow; clears after embed; .vme_tmp_* always hidden</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Library Watch: monitors Library folder — new files added to grid automatically</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Library Watch builds full LibraryEntry (tags + codec + artwork) without re-scan</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• "👁 Watching" badge in Library tab footer when Library Watch is active</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,8,0,4">🛡 Recovery</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Detects .vme_tmp_* (incomplete write) and .vme_bak_* (stale backup)</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Resume (apply pending tags) or Delete per orphan; cross-volume safe</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Policy: Ask / Auto-Delete / Ignore (Settings → Temp File Handling)</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,8,0,4">🔍 Duplicates</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Enable via Settings → Duplicates Tab; shows 🔍 DUPLICATES tab</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Scans Source + optional Destination folder (Destination optional — leave blank to scan one folder); Include Subfolders toggle</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Quick Scan stages: file size → title/IMDB/TMDB ID → partial SHA-256 hash → alternate-version (same identity, different size)</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• ♪ Deep Scan — Chromaprint audio fingerprinting via fpcalc.exe. Finds duplicates at different quality/size/container even with no metadata. Multi-core parallel (ProcessorCount−1 workers); ~35 min for 5,000 files on 8 cores</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• ⬇ Install fpcalc — one-click download/extract from official Chromaprint releases; ⬆ Check Update; version-checked</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Fingerprint cache (fingerprints.json) — files fingerprinted once; 💾 Export / 📂 Import to back up or migrate</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• 🔎 Find Duplicates of File — O(n) reference scan: pick one file, sweep the library for audio matches in seconds</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Smart Select (Smaller / Larger / Untagged / In Unsorted) and Auto-Resolve (Keep Largest / Newest / Tagged) across all groups</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Per-file checkboxes; live "📊 N selected · X GB to recover" badge; 🗑 Delete Selected (Recycle Bin) / 📤 Move Selected</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• 🎬 Compare Side-by-Side — synced dual playback; larger file gets a green border</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Exclude patterns (Settings) — wildcard skip list (samples, Trailers, Featurettes, Extras)</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• SRC / DST colour badges; group count; scan summary; delete with confirmation</TextBlock>

                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,8,0,4">📋 Media Health Check</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Scans a folder for compliance problems that cause metadata-embed failures, playback issues, or slow seeking</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Detects TRUE container from file header (magic bytes) and compares against the extension — catches misnamed files (e.g. .mp4 that is actually Matroska)</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Flags MP4 no-faststart (moov atom at end), zero-byte/truncated files, unreadable headers, unknown containers</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Each result shows a plain-English issue and suggested fix; 📋 Copy Report to clipboard; ✕ Clear button</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Stage 2 (needs ffmpeg): ⚡ Fix All Faststart — lossless stream-copy remux, moves moov atom to front, preserves timestamps. No re-encode. Parallel (ProcessorCount−1 workers); completion summary dialog</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Right-click any Health Check row → 🔧 Remux to .mkv or 🔧 Remux to .mp4 — losslessly rebuilds the container from clean streams to fix files that refuse metadata embedding. Original kept</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Right-click any file in the FILES panel → 🔧 Remux to .mkv / .mp4, 🔧 Open in fallback app (e.g. TagScanner), or 📂 Open containing folder — the genuine fix when metadata writes fail after all attempts</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Remux to .mp4 keeps the MP4 format (adds faststart in the same pass); Remux to .mkv uses the most tag-permissive container. New file is created alongside the original (named "(1)" if the name is taken)</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• ffmpeg detection in Settings → External Tools; place ffmpeg.exe in native\ folder or on PATH; 🌐 Download link provided</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Detection is read-only and parallel (ProcessorCount−1 workers); reads only the first ~64 KB of each file</TextBlock>

                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,8,0,4">⚠ Write Error Diagnostics</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Verbose Write Errors (Settings): shows a detailed dialog on every write failure</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Fallback Application (Settings → Write Error Diagnostics): select any EXE or file</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• When set, an "🔧 Open in [AppName]" button appears on every write/rename error dialog</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• EXEs receive the failed file path as their first argument (e.g. TagScanner, MediaInfo Lite)</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Non-EXE files opened via Windows shell association (e.g. .xlsx report template)</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Fallback app path persisted in config.json; cleared with the ✕ button in Settings</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Remux-to-fix suggestion — when a single-file write fails at the container level (not a read-only/locked/permission/network issue) on an MP4-family file, the app offers a lossless remux and, on success, retries the write automatically. Requires ffmpeg</TextBlock>

                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,8,0,4">📺 TV Shows Library Tree View</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Toggle in Settings → Library Display — switches TV Shows tab to a collapsible tree</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Grouped Show → Season → Episode with cover art thumbnail on each show node</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• ✓ watched badges per episode; season shows X/Y watched count; all-watched ✓ indicator</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• ⚠ Missing episode detection — gaps in episode numbers highlighted in amber</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Filter bar (live search) and Sort (A→Z / Episode count / Recently added) above the tree</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Context menus at show, season, and episode level — load, mark watched, open location, copy path</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Double-click show → loads all episodes; double-click season → loads that season; Enter / Space keyboard shortcuts</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Tooltip on show node: total runtime · total size · watched progress</TextBlock>

                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,8,0,4">🌐 Language (Partial)</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Settings → Language — 19 languages supported; changes take effect immediately</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Tab headers, toolbar buttons, Files panel, Library toolbar and Settings section headings are translated</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Date, number and calendar formats update live to match the selected locale</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• RTL layout (Right-to-Left) applied automatically for Arabic, Hebrew, Persian, Urdu</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Coverage note: body text, tooltips, status messages and help content remain in English in this release. Additional strings will be translated in future updates.</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• The application name Video Metadata Editor is not translated in any language</TextBlock>

                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,8,0,4">🔧 Other</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Preview player with popout window; technical codec/resolution/audio info panel</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Atomic write pipeline: temp-copy → tag write → File.Replace → backup cleanup</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Atomic config saves (SemaphoreSlim lock; temp-file swap); no partial writes</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Portable single-EXE — config.json in app folder, no registry, no installer</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• MKV artwork via MKVPropEdit — writes proper Matroska cover.jpg attachment recognised by Plex, Jellyfin, Emby, VLC. Falls back to TagLib# if MKVToolNix not installed</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Add Folder Recursive toggle (next to button in toolbar and in Settings) — control whether subfolders are included</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Watch Folder Recursive toggle — separately controls whether the watch monitors subfolders</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Post-write verification — after every TagLib# write, the file is re-read and the Title tag compared. Silent write failures (AVI, WMV, WebM) surface as explicit errors in the Processing Log</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Format capability warnings — before writing AVI, WMV or WebM, a warning is logged explaining which fields may not persist in that container format</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• NFO Export — 📄 Export NFO button in Retrieved Data tab and Files panel context menu generates Kodi-compatible .nfo sidecar files. Opens containing folder in Explorer after export</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Hybrid search — typing a show name in Movie mode automatically searches both TMDB movie and TV endpoints simultaneously. Results are labelled 🎬 Movie or 📺 TV Show so you always find what you need regardless of the mode switch</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Direct S##E## episode entry — type S01E02 or just "2" in the Jump to Episode box in the TV picker to jump directly without scrolling through a long dropdown</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• Metadata write timeout — 30-second guard on all tag write operations; files on slow or unresponsive network shares fail gracefully rather than blocking indefinitely</TextBlock>
                                </StackPanel>

                                <Separator/>

                                <!-- Supported Formats -->
                                <TextBlock Text="Supported Video Formats" Style="{StaticResource SectionHeader}"/>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Style="{StaticResource BaseText}">• MP4 — Full metadata + artwork support</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• MKV — Full metadata + artwork support</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• M4V — Full metadata + artwork support</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• MOV — Full support (compatibility varies by player)</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• WMV — Basic metadata, limited field support</TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}">• WebM — Limited tag support; artwork not embedded</TextBlock>
                                </StackPanel>

                                <Separator/>

                                <!-- Workflow -->
                                <TextBlock Text="Recommended Workflow" Style="{StaticResource SectionHeader}"/>
                                <StackPanel Margin="0,0,0,16">

                                    <!-- Topic selector -->
                                    <ComboBox x:Name="WorkflowTopicSelector"
                                              SelectedIndex="0"
                                              Margin="0,0,0,12"
                                              ToolTip="Select a workflow topic">
                                        <ComboBoxItem>📝  Standard single-file workflow</ComboBoxItem>
                                        <ComboBoxItem>⚡  Batch workflow (fastest)</ComboBoxItem>
                                        <ComboBoxItem>📚  Library workflow</ComboBoxItem>
                                        <ComboBoxItem>👁  Watch Folder workflow</ComboBoxItem>
                                        <ComboBoxItem>📦  Move / Copy workflow</ComboBoxItem>
                                        <ComboBoxItem>🔍  Duplicates workflow</ComboBoxItem>
                                        <ComboBoxItem>📋  Media Health Check workflow</ComboBoxItem>
                                        <ComboBoxItem>🗒  Subtitles, Trakt &amp; NFO</ComboBoxItem>
                                        <ComboBoxItem>⚕  Recovery workflow</ComboBoxItem>
                                    </ComboBox>

                                    <!-- ── 0: Standard single-file ─────────────────────────────── -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkflowTopicSelector}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Style="{StaticResource BaseText}">1. Add files via Add Files / Add Folder / drag-and-drop</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">2. Click a file in the FILES panel to select it — RAW DATA tab shows embedded tags</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">3. Go to RETRIEVED DATA tab — search auto-runs; or type a title and press Search</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">4. Click the correct result → click "⬇ Apply to Raw Data Tab" to copy into the editor fields</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">5. Review fields in RAW DATA, adjust if needed, then click "Apply + Embed + Rename"</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}" TextWrapping="Wrap">6. ✅ row = success. ❌ row (pink) = write failed — hover for reason. On a container-level failure for an MP4-family file the app now offers to remux and retry the write automatically; you can also right-click → Remux → .mp4 or .mkv to fix persistent write failures manually</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">7. After a successful embed, "↺ Undo Last Embed" becomes active — click it to restore the file's previous tags and filename in one step</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}" TextWrapping="Wrap">8. Already have a .nfo next to the file (from Kodi, TinyMediaManager, etc.)? Click "📥 Import NFO" to load it into the editor for review, then Apply + Embed. Or click "📄 Export NFO" / "🖼 Export Artwork" to write sidecars for your existing tags</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">9. To download subtitles: RETRIEVED DATA tab → expand 🗒 Subtitles → Search → select result → ⬇ Download Selected. Requires OpenSubtitles API key in Settings</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">10. To mark as watched: click the "Watched / Unwatched" toggle in RAW DATA. If Trakt is connected, this syncs automatically</TextBlock>
                                    </StackPanel>

                                    <!-- ── 1: Batch workflow ────────────────────────────────────── -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkflowTopicSelector}" Value="1">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Style="{StaticResource BaseText}">1. Add Folder — all files load into the FILES panel</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">2. Select all (All button) or cherry-pick with checkboxes</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">3. Click Batch Process — auto-searches metadata for all selected, then embeds + renames</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">4. Progress bar: 0–50% = search phase, 50–100% = write phase</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">5. Cancel stops at the next safe point — never mid-write</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">6. Review failures in the completion banner; retry individually if needed</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}" TextWrapping="Wrap">7. After batch completes, click "↩ Undo Batch" (in the completion banner chip OR the permanent button in the RAW DATA tab) to revert ALL files that succeeded — restores tags and renames. Only available until the next batch run</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}" TextWrapping="Wrap">8. For files that failed to write (pink rows): click the pink row to select it, then right-click or use the write failure popup to Remux → .mp4 or .mkv — this fixes most container-related write failures without re-encoding</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}" TextWrapping="Wrap">9. To set a shared value across many files (e.g. tag a whole season's Genre or Show title, or mark all Watched): select them, click "✎ Batch Edit Fields", tick only the fields to change, Apply. Reversible with ↩ Undo Batch. Fields that don't fit the selection are greyed</TextBlock>
                                    </StackPanel>

                                    <!-- ── 2: Library workflow ──────────────────────────────────── -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkflowTopicSelector}" Value="2">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Style="{StaticResource BaseText}">1. LIBRARY tab → Browse to your movies folder → Scan Library</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">2. First scan builds a cache; subsequent scans use it — much faster</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">3. Browse all films by title, rating, year, genre, size. Click ⚙ Columns to customise</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">4. Double-click a row to load it into the Files panel and switch to RAW DATA</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">5. Ctrl+Click or Shift+Click to select multiple rows, then 📥 Load Selected</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">6. Separator rows distinguish Library-loaded files from existing Files panel files</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">7. After embedding, the Library grid updates in-place — no re-scan needed</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">8. Cache auto-prunes entries for files moved or deleted outside VME on each scan</TextBlock>
                                    </StackPanel>

                                    <!-- ── 3: Watch Folder ──────────────────────────────────────── -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkflowTopicSelector}" Value="3">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Style="{StaticResource BaseText}">1. Enable Watch Folder in SETTINGS — monitors every folder your loaded files came from (Add Files or multiple folders all count), so a new arrival in any of them is caught</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">2. New files appear highlighted yellow in the FILES panel; existing files are never re-reported</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">3. Temp files (.vme_tmp_*) are hidden automatically — they won't appear as false positives</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">4. Process yellow-highlighted files like any other file — select, search, embed</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">5. If the watcher misses a file (network path, slow drive), it catches it on the next poll interval</TextBlock>
                                    </StackPanel>

                                    <!-- ── 4: Move / Copy ───────────────────────────────────────── -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkflowTopicSelector}" Value="4">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Style="{StaticResource BaseText}">1. Select files in the FILES panel → MOVE / COPY tab</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">2. Destination folder is restored from the last session; Browse to change it</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}" TextWrapping="Wrap">3. Enable Smart Organisation in Settings to route Movies and TV Episodes to separate subfolders automatically — untagged files with S##E## filenames are also rescued to TV Shows</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">4. Choose conflict resolution: Overwrite / Skip / Rename → Copy or Move</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">5. After a Move, the FILES panel reloads from the destination folder automatically</TextBlock>
                                    </StackPanel>

                                    <!-- ── 5: Duplicates ────────────────────────────────────────── -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkflowTopicSelector}" Value="5">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Style="{StaticResource BaseText}">1. Enable Duplicates Tab in Settings — the 🔍 DUPLICATES tab appears in the tab bar</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">2. Set Source Folder; leave Destination blank to scan one folder, or set it to compare two</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">3. 🔍 Scan for Duplicates — fast size/metadata/hash scan (respects excluded patterns from Settings)</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">4. For renamed / re-encoded / untagged copies: click ⬇ Install fpcalc (once), then ♪ Deep Scan to match by audio fingerprint regardless of filename or tags</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">5. Export your fingerprint cache (⬆ Export Cache) to back it up or share with another machine</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">6. Import a cache (⬇ Import Cache) → choose Merge (add to existing) or Replace. No restart needed</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">7. After results appear, click ⚙ Keep Tagged / Keep Largest / Keep Newest to auto-select across all groups</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">8. Watch the "📊 N selected · X GB" badge; tick/untick individual checkboxes to adjust</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">9. Use 🎬 Compare Side-by-Side on any uncertain group, then 🗑 Delete Selected (Recycle Bin) or 📤 Move Selected</TextBlock>
                                    </StackPanel>

                                    <!-- ── 6: Media Health Check ────────────────────────────────── -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkflowTopicSelector}" Value="6">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Style="{StaticResource BaseText}">1. Open the 📋 HEALTH CHECK tab → Browse to a folder → 📋 Scan for Problems</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">2. Each row shows the detected container, the issue, and a suggested fix; 📋 Copy Report exports the full list</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}" TextWrapping="Wrap">3. To fix MP4 no-faststart in bulk: install ffmpeg (Settings → External Tools → 🌐 Download, drop ffmpeg.exe in native\), then click ⚡ Fix All Faststart. A red warning banner appears while files are being modified — don't close the app until it finishes</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">4. Faststart fixes are lossless (no re-encode) and preserve timestamps; fixed rows update in-place</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">5. Extension/container mismatch (e.g. .mp4 containing Matroska bytes): right-click → ✏ Fix Extension renames instantly — no remux, no re-encode, no quality loss</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}" TextWrapping="Wrap">6. If a metadata write keeps failing: right-click → 🔧 Remux to .mp4 or 🔧 Remux to .mkv for a lossless container rebuild. The original file is untouched</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">7. After remuxing, the clean copy loads in the FILES panel marked REMUXED. Use the buttons under the Preview panel: ✓ Replace Original or ↩ Restore Original — nothing is deleted until you choose</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}" TextWrapping="Wrap">8. For proper MKV artwork embedding (Plex/Jellyfin/Emby): install MKVToolNix — drop mkvpropedit.exe into the native\ folder, or install normally and click 🔄 Re-detect in Settings → MKV Artwork Engine. Without it, TagLib# handles MKV artwork as a fallback</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}" TextWrapping="Wrap">9. The scan also flags any file whose stored comment contains a semicolon (⚠ Warning). These may hold metadata truncated by a pre-Build-105 write — their embedded IDs/ratings could be incomplete. This is informational; it is intentionally excluded from ⚡ Fix All / Fix All Issues because the remedy is re-embedding, not remuxing</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}" TextWrapping="Wrap">10. To repair them, click 📝 Re-embed Semicolon Files (n) — it loads every flagged file into the FILES panel and switches there so you can re-fetch metadata and Embed on the current build, which writes a clean comment. Tags already lost to truncation are restored by re-fetching from the provider, not from the file itself</TextBlock>
                                    </StackPanel>

                                    <!-- ── 7: Subtitles, Trakt and NFO ─────────────────────────── -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkflowTopicSelector}" Value="7">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,4">Subtitles</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">1. Settings → OpenSubtitles API key (free account at opensubtitles.com)</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">2. Select a file → RETRIEVED DATA tab → Subtitles section — search runs automatically</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">3. Click a result to download — the .srt/.ass file saves alongside the video, named Video.en.srt</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}" Margin="0,0,0,8">4. Free tier limit: 5 downloads/day. The app shows remaining downloads after each one</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,4">Trakt</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">5. Settings → Trakt.tv → Connect → authorise in your browser (device code flow)</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">6. The ♥ Watched toggle on each file syncs to Trakt in real time</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}" Margin="0,0,0,8">7. Trakt → Sync Now pulls your full watch history in bulk. Token auto-refreshes before expiry</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,4">NFO &amp; artwork sidecars (Kodi / Plex / Jellyfin)</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">8. Select files → 📄 Export NFO generates Kodi-format .nfo sidecars (movie / episode); enable tvshow.nfo in Settings → NFO Export to also write a series file per show folder</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">9. Sidecars include &lt;uniqueid&gt; (tmdb/imdb/tvdb), &lt;ratings&gt; with votes, cast and MPAA — useful when the media server prefers sidecars over embedded tags</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">10. 🖼 Export Artwork writes the poster next to each file — Kodi &lt;video&gt;-poster.jpg or Plex/Jellyfin folder poster.jpg (choose in Settings → Artwork Export)</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">11. 📥 Import NFO reads an existing .nfo (from Kodi, TinyMediaManager, MediaElch, etc.) back into the editable fields for review — modern and legacy ID/rating formats both supported. Nothing is written until you Apply + Embed</TextBlock>
                                    </StackPanel>

                                    <!-- ── 8: Recovery ──────────────────────────────────────────── -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkflowTopicSelector}" Value="8">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Style="{StaticResource BaseText}">1. On every launch the app scans the last-used folder and Library folder for crash orphans</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">2. If orphans are found, the Recovery dialog opens automatically after the main window loads</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">3. INCOMPLETE WRITE (.vme_tmp_*): Resume applies pending tags; Delete discards the temp file</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">4. STALE BACKUP (.vme_bak_*): the write already succeeded — just Delete the redundant backup</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}" TextWrapping="Wrap">5. Interrupted remux or faststart fix leaves .remux.* or .faststart.tmp.* files — the startup sweep offers to clean them up; your originals are always intact</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}">6. Change behaviour in Settings → Temp File Handling: Ask / Auto-Delete / Ignore</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,10,0,2" TextWrapping="Wrap">Persistent write failure on a specific file</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}" TextWrapping="Wrap">7. First try the write-failure popup's Remux → .mp4 (fix + faststart) → then Replace Original. This rebuilds the container and fixes most stubborn files</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}" TextWrapping="Wrap">8. If a file embeds but the values revert after a Library rescan, re-embed it once on the current build — older builds could silently drop tokens (see Build 105 in Revision History)</TextBlock>
                                        <TextBlock Style="{StaticResource BaseText}" TextWrapping="Wrap">9. For a write problem that none of the above resolves, enable Settings → Write Error Diagnostics → "Enable full diagnostic dump". This (a) makes every embed write a report to %TEMP%\vme_artdump\&lt;filename&gt;.diag.txt, and (b) reveals a "🩺 Run Full Write Diagnostic on a File…" button. That button runs all 16 write checks against a file you pick — on a safe copy, your original is never touched — showing a green check or red cross per step, then lets you export the full log to a location of your choice. Send that log in so the issue can be pinpointed and fixed in a future build. Turn the setting back OFF when done</TextBlock>
                                    </StackPanel>

                                </StackPanel>

                                <!-- Revision history -->
                                <TextBlock Text="Revision History" Style="{StaticResource SectionHeader}"/>
                                <StackPanel>

                                                                        <!-- ═══ Recent builds — v1.4.0 Builds 46–90 ═══════════════ -->

                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 143 — Fix (part 1): stop the redundant second search behind duplicate watch entries
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        The logs traced the duplicate Files-panel row to its real cause: a watched file ran TWO independent TMDB searches — the background pre-warm search and auto-embed's own search. Auto-embed embedded + verified + renamed the file (green) using its result; the separate pre-warm search finished later and wrote its result onto the entry after the rename, creating a divergent second row (yellow, unverified, sometimes carrying a series-level rating). Build 142's canonical-path guard didn't help because this was never a path-comparison problem. Fix: when auto-embed is enabled, the redundant pre-warm search is no longer scheduled for watched files (auto-embed already searches and embeds them) — one flow, one entry, and half the TMDB calls. When auto-embed is disabled the pre-warm still runs, so manual workflows keep their ready-results. Part 1 of two; part 2 will make the auto-embedded TV rating fall back to the series rating so the single verified entry is also the richer one.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 142 — Fix: duplicate Files-panel entry for one file after watch-detect + auto-embed rename
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        A watched file could show two rows for the same file — one green (verified) and one yellow (unverified, sometimes with later-fetched metadata such as a rating). Cause: when auto-embed renames the file, the rename's File.Move fires a FileSystemWatcher event for the new name before that name is registered as known, so the watch re-detects the file and adds a second entry; and the dedup guards compared raw path strings, which could also miss a duplicate when paths differed only in form. Fix: the watch duplicate guards (and the post-add entry lookup) now compare by canonical full path (Path.GetFullPath) instead of raw string, so two forms of the same file are treated as one — closing the duplicate from both the rename-event timing window and any path-form mismatch, with the at-add-time re-check covering a concurrent add. Build 141's stale-entry sweep stays as a backstop for the different case of an entry whose file is genuinely gone. Beyond cosmetics: a duplicate row pointing at a file another operation is about to move/rename could make that operation act on the wrong location; preventing the duplicate removes that risk.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 141 — Fix: stale Files-panel entry left after watch-detect + auto-rename
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        When Watch Folder detected a freshly-downloaded file it added a panel entry for that name; the file was then auto-renamed to its correct name, leaving the old entry (pointing at a now-gone path) in the panel beside the renamed one. Refresh cleared it, but that shouldn't be manual. After a successful auto-rename the panel now drops any entry whose file no longer exists on disk — a lightweight version of what Refresh already does. Safe for undo: an entry is removed only when its file is gone AND it holds no undo state, so the live renamed entry (which carries the undo snapshot) is never touched; the collection change is marshalled to the UI thread. Toggle in Settings → Behaviour → "Auto-clean stale Files-panel entries after rename" (default on) to disable without a rebuild. Cosmetic only — the file was always correctly renamed and embedded.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 140 — Core write path now under automated CI test
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        The metadata write-and-read-back tests — the app's fundamental function — had been skipped in CI because a hand-built minimal MP4 stub didn't reliably initialise TagLib#'s tag layer for writing, so the core write path had no automated verification. Added a real MP4 fixture (a 1-second libx264 clip generated with ffmpeg and verified writable in the app) and un-skipped the 8 write tests: each starts from a fresh untagged copy and verifies title, core fields, TV-episode fields, invariant-decimal rating, watched flag, overwrite-existing-tags, temp-file cleanup, and non-destruction on success. Test-only change — no application code touched. Closes the biggest gap in the safety net: the write round-trip is now checked on every push.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 139 — Fix: build 138 didn't compile
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Build 138's Watch Folder fix had a compile error caught by CI: the in-flight cleanup called _inFlight.TryRemove(path, out _) inside a ContinueWith(_ => …) whose lambda parameter was also named _, so the out discard bound to the Task parameter instead (CS1503). Changed to an explicit typed discard, out byte _. No logic change — build 138's fix is otherwise intact; this just makes it compile.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 138 — Fix: Watch Folder could permanently miss files not ready on first detection
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Watch Folder sometimes didn't pick up files, and the only reliable fix was to re-run Add Folder. Cause: the watch marked a file "known" the moment it was detected — before it was loaded. FileSystemWatcher fires as soon as a file appears, often before a large copy or download has finished writing, so the load could fail (file still locked/incomplete) while the path was already recorded as seen; the periodic poll fallback then skipped it forever. Fix: the "known" set is now populated only on a successful load (which the app already did on the success path), and detection uses a short-lived in-flight guard that clears after a few seconds — so a file that wasn't ready on first detection is retried on the next poll instead of being suppressed permanently. Files arriving mid-copy, over network paths, or in bulk (where FileSystemWatcher can drop events) are now reliably caught by the poll. No change for files ready immediately — they still load on the instant FSW event.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 137 — Fix: build 136 broke anime absolute-episode detection
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Build 136 taught the parser to recognise a bare E## code for episode-only TV filenames. CI caught a side effect: ParseAbsoluteEpisode (anime absolute numbering, for the {AbsoluteEpisode} token) used the episode regex as a gate to skip season-relative codes, and a bare E153 now tripped that gate — so absolute detection stopped recognising E153 as absolute 153. Fixed by bailing only on season-bearing codes (S01E05, 1x05, Season 1 Episode 5), not the bare E## alternative. Both readings now coexist: E153 parses as a season-style episode for renaming and as absolute 153 for the token. Regression tests added in both directions. No change to the 136 fix itself — episode-only filenames still rename correctly as TV.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 136 — Fix: episode-only filenames (E##) renamed as movies in batch
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Batch Process renamed a whole TV series with the movie pattern when files used a bare episode number and no season (e.g. Monster.E05.The.Girl.of.Heidelberg), even though single-file Apply handled them correctly. The parser (ParseEpisode) only recognised S01E05 / 1x05 / Season 1 Episode 5 — a bare E05 matched none, so the batch's type-mismatch guard saw "episode metadata but no episode code in the filename", assumed TMDB mis-matched a movie to a series, and forced the movie pattern (the log showed repeated "Type mismatch: … has no episode code"). ParseEpisode now also recognises a standalone E## token (season defaults to 1), word-boundary guarded so WALL-E, E.T. and Escape don't match — verified against many movie filenames to avoid false positives, with the type-mismatch guard remaining a backstop. Separately, "Apply to Raw Data Tab" now syncs the file's stored RetrievedMetadata too, so a file searched-and-applied before a batch carries the correct IsEpisode state (the batch renames from RetrievedMetadata ?? PendingMetadata, and previously only the latter was updated). New parser tests cover the episode-only codes and a set of movies that must not be misread.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 135 — Faster TV tree view
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        The Library TV tree could lag when displaying or refreshing, especially with many shows. The tree is a computed property rebuilt every time it's raised — on filter, sort, watched-state toggle, tab switch, and once per background artwork load during a scan — and each rebuild re-walked every season folder on disk (Directory.EnumerateFiles plus a per-filename regex) to spot episodes present on disk but missing from the library. That repeated disk scan was the stall. The folder scan is now cached: disk is read once per folder and reused across rebuilds, with the cache invalidated only when files may actually have changed (after a library scan, and after a file's on-disk metadata is written). The missing-episode gaps and untagged-on-disk warnings are unchanged — the tree just no longer hits the disk on every refresh.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 134 — Minimise to system tray
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        The app can now collapse to the notification area and keep watching folders in the background — the natural companion to Watch Folder, which previously meant leaving the window open. Enable it in Settings → Behaviour → "Minimise to system tray" (off by default). Closing or minimising then hides to the tray instead of quitting, with a one-time balloon so the window vanishing doesn't look like a crash; double-click the icon to restore. The tray menu offers Restore window, Rescan watched folder(s), Watching on/off, Start with Windows, and Exit — deliberately limited to actions that make sense with no window on screen. Exit runs the full teardown (unsubscribe, cancel in-flight work, dispose the watchers, flush the library cache); hiding skips it entirely, since disposing the watchers is precisely what must not happen when the point is to keep watching. Start with Windows uses a per-user Run entry (no admin rights) and, because this is a portable EXE that can move, re-points itself automatically if the stored path goes stale.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 133 — Fix: update check never ran
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        The update badge added in build 130 never appeared, even with a newer release published. The check had been chained onto the end of the startup library-scan callback, which is effectively async void — if the scan threw, the exception was swallowed and everything after it, including the update check, was silently skipped. The check now fires on its own dispatcher callback, independent of the library scan; startup scan failures are caught and logged rather than aborting the rest of startup. The check is also traceable now: it previously failed silently in every case, so "no update" and "never ran" looked identical — which is why this went unnoticed. It now logs each outcome (skipped, checking, none found, update available, or failed with the reason), all still non-fatal.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 132 — Silence the last compiler warning
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        The Duplicates results setter drew a CS8601 "possible null reference assignment" warning. The value is coalesced to an empty collection on that line, and _groups is null-guarded both before and after, so null and empty were always handled identically — the warning was cosmetic, never a runtime risk. Build 131's coalescing didn't satisfy the compiler (its nullable analysis can't see through the generic Set&lt;T&gt;(ref T, T) helper), so it's now suppressed at the site with a #pragma documenting the reasoning. No behaviour change; the build log is warning-clean.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 131 — Release tooling and warning cleanup
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        The CI workflow's GitHub Actions (checkout, setup-dotnet) were bumped to v5, clearing GitHub's Node 20 deprecation notice. The Duplicates CS8601 warning was addressed by coalescing null to an empty collection — correct and harmless, but it didn't clear the warning (see Build 132). Release publishing also moved to PowerShell: publish-release.ps1 reads the version by parsing the csproj as XML, verifies gh auth, locates the versioned EXE, refuses to overwrite an existing release, builds notes from the changelog, and confirms before publishing.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 130 — Update check with title-bar badge
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        On startup the app now checks the GitHub Releases page for a newer version and, if one exists, shows a small "⬆ Update available" badge under the title — click it to open the release page in your browser. No download happens automatically (this is a portable app; you choose when to grab the new EXE). The check runs quietly in the background, never blocks startup, and fails silent if you're offline or there's no newer release. It can be turned off in Settings → Behaviour → "Check GitHub for updates on startup". The version-comparison logic lives in a pure, unit-tested UpdateCheckService (tolerates a leading "v" on tags, treats only strictly-newer releases as updates); the badge stays dormant until a release newer than the running build is published.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 129 — Selection-aware Batch Edit, Help refresh, and a cluster of fixes
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Batch Edit Fields is now selection-aware: when every selected file is a movie the Show title field is greyed out (TV-only), and when every selected file is a TV episode the Year field is greyed out (episodes use their aired date); a mixed selection leaves all fields available, and fields shared by both types (Genre, Cast, Director, MPA, Watched) are never greyed. The Help tab's Features list and Recommended Workflow were brought up to date with the whole 120–128 arc — the rename grammar (conditional blocks, zero-padding, multi-episode ranges, {AbsoluteEpisode}), the NFO export overhaul, NFO import, batch field editing, artwork sidecar export, the remux-to-fix suggestion, and the multi-folder Watch Folder. Fixes bundled into this build: (1) the shared body-text style now wraps long lines, so Features and Workflow entries that previously ran off the right edge (clipped even when maximised) now reflow correctly; (2) ApplyRetrievedToEditing was hardened — two ID assignments (ImdbId, TvdbId) that used the live SelectedFile now use the same null-guarded file snapshot as the rest of the method, closing a rare NullReferenceException on fast deselect and clearing two compiler warnings; (3) moving files into a watched folder no longer re-adds them to the Files panel — Move now seeds each destination path into the Watch Folder's known-set so relocated files aren't re-detected as new arrivals (a regression from the build-128 multi-folder watch); and (4) the revision history below was reformatted so builds 89–129 match the two-line title/detail style used by build 88 and earlier.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 128 — Watch Folder now monitors every folder your files came from
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Previously the Files-panel Watch Folder monitored only a single folder (the last one loaded), so new files dropped into a different source folder — common after "Add Files" or loading from several folders — weren't detected. It now watches every distinct folder among the currently loaded files (one watcher per folder, via the same MultiWatchFolderService the Library watch uses). Adding more files from a new folder automatically extends the watch to cover it. Honors the existing recursive and poll-interval settings. If the toggle is enabled before any files are loaded, it falls back to the last loaded folder as before.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 127 — Suggest remux when a write fails at the container level
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        When embedding metadata fails because the MP4 container is structured in a way the tag writer can't update in place (a failure category of FormatUnsupported or Unknown — not read-only, locked, permission, or network/volume issues, which a remux wouldn't fix), the app now offers to losslessly remux the file to a clean container and automatically retry the write. No re-encode, no quality loss; the original is replaced only after the remux succeeds, then the write is retried once on the new file. Requires ffmpeg (Settings → External Tools); if it's not installed the app falls back to the normal write-error diagnostic. The decision of whether to offer the remux lives in a pure, unit-tested RemuxSuggestionService; the remux itself reuses the existing FfmpegService + RemuxCommitService machinery. Applies to the single-file Apply + Embed + Rename path (batch operations are unaffected, since they shouldn't pause on per-file prompts).
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 126 — Fix: Raw Data action buttons no longer clip
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        The bottom action row on the Raw Data tab (Export NFO, Export Artwork, Import NFO, Apply + Embed + Rename, Rename Only, Use Retrieved, Lock/Unlock) was a single horizontal row that ran past the window edge once Export Artwork and Import NFO were added in builds 124–125, clipping the rightmost buttons even when maximised. The row is now a WrapPanel: when there isn't enough width, buttons reflow onto a second line instead of being cut off. No behaviour change — purely layout.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 125 — NFO import
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        New "📥 Import NFO" button reads the .nfo sidecar next to each selected video and loads its metadata into the editable fields for review — nothing is written to the file until you click Apply + Embed. The inverse of Export NFO, built to tolerate real-world variation: modern &lt;uniqueid type="..."&gt; AND legacy flat &lt;imdbid&gt;/&lt;tmdbid&gt;/&lt;id&gt;; the modern &lt;ratings&gt;&lt;rating&gt;&lt;value&gt; block AND a legacy flat &lt;rating&gt;; multiple &lt;genre&gt;/&lt;actor&gt; elements collapse to the comma lists; Jellyfin &lt;played&gt; maps to watched; tag casing and surrounding whitespace are handled. Recognises &lt;movie&gt;, &lt;episodedetails&gt; (first block of a multi-episode file), and &lt;tvshow&gt; roots. Single selection loads straight into the editor; a multi-file selection populates each file's pending metadata from its own sidecar. Files with no sidecar or unparseable XML are skipped and counted, never failing the run.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 124 — Artwork sidecar export
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        New "🖼 Export Artwork" button writes the poster as an image file next to each selected video, so Plex, Jellyfin, Emby, and Kodi can read it from disk (not just from the embedded tag). Two naming styles, chosen in Settings → 🖼 Artwork Export: Kodi style names the image after the video (&lt;video&gt;-poster.jpg; TV episodes use -thumb.jpg) and works even when several videos share a folder; Plex/Jellyfin folder style writes a single poster.jpg per folder. The poster is sourced from the already-loaded metadata, then the embedded tag, then downloaded via TMDB when an ID is present; files with no obtainable image are skipped (counted, not failed). This build is poster-only — fanart/backdrop is planned for a later build.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 123 — Batch field editing
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        New "✎ Batch Edit Fields" button (top toolbar, enabled when files are selected) applies one or more shared field values across every selected file in a single operation. A checkbox dialog lets you change only the fields you tick: Genre, Cast, Director, MPA rating, Year, Show title, and Watched. Genre and Cast support Replace or Append (Append merges and de-duplicates case-insensitively). Per-file-unique fields — Title, Episode title, Season/Episode, plot, aired date, IDs, and rating — are intentionally NOT batch-editable, so a shared value can never overwrite them. Each file is written through the normal metadata-write path, existing artwork is preserved, and the whole operation is recorded as an Undo Batch snapshot, so "↩ Undo Batch" reverts every changed file at once. Batch editing does not rename files.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 122 — NFO export overhaul: tvshow.nfo, multi-episode blocks, stricter Kodi format
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        The .nfo sidecar exporter was reworked into pure, unit-tested XML builders and brought fully in line with the Kodi/XBMC format that Plex (NFO Agent), Jellyfin, and Emby all read. New: an optional tvshow.nfo (Settings → 📄 NFO Export) written once per show folder when exporting episode NFOs; multi-episode files now emit one &lt;episodedetails&gt; block per episode in the range; &lt;originaltitle&gt;, proper &lt;uniqueid&gt; default flagging (first id marked default="true"), &lt;ratings&gt; with value+votes, and &lt;actor&gt; with &lt;order&gt;. Genres and cast are split into individual elements. The XML declaration now matches the spec (UTF-8, standalone="yes") and apostrophes are escaped. The "📄 Export NFO" button and batch/library export are unchanged in how they're used; only the output quality improved. Existing patterns and all prior behaviour are preserved.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 121 — {AbsoluteEpisode} token + EXE filename now tracks the version
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        New rename token {AbsoluteEpisode} for anime absolute (series-wide) episode numbering. A new "Auto-detect absolute episode number" toggle in Settings → 🎌 AniList (off by default) populates it: first by reading an absolute number from the source filename (fansub layouts like "[Group] Show - 153", "Show E153", "Show 153 [BD]"), and if the name has none and the file is AniList-matched, by computing it from the AniList relations graph (summing prior seasons' episode counts via the PREQUEL chain). The AniList fallback is best-effort and runs only at rename time — when the relation chain is ambiguous (a fork, a cycle, or a missing episode count) it leaves the token empty rather than emitting a wrong number. Live preview shows the filename-derived value. The token honours pad specs ({AbsoluteEpisode:000}) and conditional blocks, and never fires when a season/episode code (S01E01) is present, since that number is season-relative. Also fixed: the published EXE filename was hardcoded to "v1.4.0.119" and would not have matched newer builds. The assembly name now derives from a single FullVersion property in the project file, so the EXE filename, assembly version, and file version always agree.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 120 — Rename engine: conditional blocks, zero-pad control, multi-episode ranges
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        The filename builder is now a small tokenizer instead of a flat text replace. Three additions: (1) Conditional blocks — wrap text in angle brackets, e.g. {ShowTitle}&lt; - {EpisodeTitle}&gt;, and the whole segment (separators included) disappears cleanly when its token is empty, so episodes without a title no longer leave a dangling " - ". Square brackets [ ] remain literal, so the common {ImdbId}/{MPA} bracket idiom still works. (2) Zero-pad control — {Season:00} and {Episode:000} set the digit width; existing patterns are unchanged because Season/Episode still default to two digits with no spec. (3) Multi-episode ranges — a new "Detect multi-episode ranges from source filename" toggle in Settings → Rename Behaviour (off by default). When on, renaming a TV episode reads the ORIGINAL filename for a range (S01E01-E03, 1x01-1x03, consecutive ExxExx, or 01_02) and expands {Episode} to a range like 01-03. The range is read from the source name only; it never alters already-renamed files and has no effect when the toggle is off. All existing rename patterns produce byte-for-byte identical output.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 119 — Write Diagnostic popup: Close fix + lock during run
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        The Close button on the Full Write Diagnostic window appeared dead: per-step UI updates used a blocking dispatch that tied up the UI thread during the 16 checks, so the click only registered after the run ended. Step updates are now non-blocking. Both Close and Export Log… now stay disabled until every check finishes and unlock together — and the title-bar X is blocked during the run — so the window can't be dismissed (leaving work running in the background) before it's done.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 118 — Memory &amp; lifetime audit
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        A dedicated pass over event handlers, timers, disposables, and caches. Fixed a real session-growing leak: each file added to the FILES list attached a property-change handler that was never removed when files were reloaded, so old files accumulated. Handlers are now detached on removal and before clearing the list. Also reduced rename-preview timer churn (one reused timer instead of a new one per keystroke). Audited and confirmed sound: the API cache (capped + expiring), the TV-tree poster cache (self-collecting), file-system watchers and cancellation sources (disposed on close), and the duplicate hash cache (cleared after edits). No behaviour change.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 117 — Phase 2 milestone: child ViewModels are WPF-free
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Internal refactor, no behaviour change. Adds an IClipboardService abstraction (the Health Check "copy report" now routes through it). With this, all five extracted child ViewModels — Search, Metadata, Copy/Move, Duplicates, Media Health — contain no direct WPF code; their only WPF tie is the shared ICommand interface. Every dispatcher, dialog, picker, clipboard, bitmap, and custom-window use now goes through an abstraction or a View callback. MainViewModel stays the WPF-aware coordinator by design.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 116 — TV tree poster caching + DuplicatesViewModel fully decoupled
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Performance: show posters in the TV tree were re-decoded from JPEG on the UI thread every time the tree rebuilt (filtering, sorting, or switching into Tree view), causing a noticeable delay when entering the tree. Decoded posters are now cached by their source bytes, so rebuilds and re-entry reuse the already-decoded image. (The tree getter still re-scans season folders on each rebuild — a larger separate optimisation is planned.) Phase 2 (internal, no behaviour change): DuplicatesViewModel is now fully decoupled from WPF — its scan progress updates route through IUiDispatcher, and the side-by-side compare window is supplied by the View via a callback rather than created in the ViewModel. It now references WPF only through the cross-platform ICommand interface.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 115 — Phase 2: DuplicatesViewModel migrated to dialog abstraction
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Internal refactor, no behaviour change. DuplicatesViewModel now routes all its standard dialogs through the IDialogService abstraction from Build 114: the source/destination folder pickers, all six message boxes (batch and single delete/move confirms, the network permanent-delete warning, partial-failure and error notices, and the cache import merge/replace prompt), and the three file pickers (reference file, cache export, cache import). Identical prompts and buttons. It now touches WPF only via ICommand, one batched-UI Dispatcher block, and the custom side-by-side compare window — the latter two deferred to their own follow-ups.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 114 — Phase 2: dialog abstraction (Health Check migrated)
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Internal refactor, no behaviour change. Introduces IDialogService — a platform-neutral abstraction over message boxes and file/folder pickers — so ViewModels no longer call WPF's MessageBox or Microsoft.Win32 dialogs directly. The WPF-backed implementation stays in the app; a headless fallback auto-cancels (and never auto-confirms a destructive prompt) for tests. MediaHealthViewModel is migrated first: all its confirmation and result dialogs (faststart confirm, fix-complete summary, remux complete/failed, ffmpeg-missing, the re-embed confirm) now go through the abstraction, with identical prompts and buttons. DuplicatesViewModel (which also has file/folder pickers) follows next. Added CI tests for the headless dialog service.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 113 — Phase 2: command framework decoupled from WPF CommandManager
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        The keystone Phase 2 change. Behaviour is identical to before — this changes coupling, not function. The RelayCommand / AsyncRelayCommand family no longer references WPF's CommandManager directly; CanExecute re-evaluation is routed through a new platform-neutral seam (CommandRequery / ICommandRequeryProvider). On WPF the app installs a CommandManager-backed provider at startup (before any ViewModel is built), so the automatic enable/disable behaviour every button relies on — Search enabling when you type, Embed/Apply enabling on selection, async buttons disabling while running — is preserved exactly. The one remaining WPF tie in the command classes and the cleaned child ViewModels is the cross-platform ICommand interface itself, which Avalonia shares. Added CI tests for the seam.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 112 — Phase 2: MetadataViewModel imaging cleanup + debounce disposal
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Internal refactor, no behaviour change. Removed a dead, unused BitmapSource artwork property (and its System.Windows.Media.Imaging import) from MetadataViewModel — it was a leftover from the earlier ViewModel extraction and nothing bound to it; the live artwork display binds to MainViewModel.ArtworkImage and to RetrievedMetadata.ArtworkBytes via the existing bytes-to-image converter, both untouched. MetadataViewModel now references WPF only through ICommand. Also tightened the Build 111 rename-preview debounce to dispose the previous CancellationTokenSource when it is replaced, so rapid typing no longer accumulates undisposed token sources.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 111 — Phase 2: MetadataViewModel timer decoupling
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Internal refactor, no behaviour change. The rename-preview field in the metadata editor updates after a short pause as you type (a 150ms debounce). That debounce previously used WPF's DispatcherTimer; it now uses a platform-agnostic Task.Delay plus cancellation, with the result marshalled back to the UI thread through the IUiDispatcher abstraction from Build 110. Same debounce interval, same preview output — only the underlying timer mechanism changed, removing another WPF dependency from the ViewModel.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 110 — Phase 2: UI-dispatcher abstraction (cross-platform prep)
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Internal refactor, no behaviour change. The first step of Phase 2's goal: purifying the extracted ViewModels of direct WPF dependencies so they can move into a shared, platform-agnostic core project (the foundation for a future Mac/Linux build). Introduces IUiDispatcher — an abstraction over the UI-thread marshaller — with a WPF-backed implementation that stays in the app and a headless no-op fallback for tests. SearchViewModel is the proof-of-pattern: it no longer calls Application.Current.Dispatcher or CommandManager directly, instead routing through the abstraction. The remaining ViewModels follow in later builds. Added CI tests for the null dispatcher.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 109 — Re-embed semicolon-flagged files from Health Check
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        New "📝 Re-embed Semicolon Files (n)" button on the Health Check panel, beside Fix All Issues. It loads every file flagged with a semicolon in its stored comment into the FILES panel and switches to that tab, so you can re-fetch metadata and Embed cleanly on this build. The button shows a live count and is enabled only when there are flagged files and no scan is running. Note: tags already lost to a pre-105 truncation can't be recovered from the file itself — re-fetching from the provider restores them. That's why this loads files for a real re-embed rather than just rewriting the truncated comment. Complements Fix All Issues, which excludes semicolon files (their fix is a re-embed, not a remux).
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 108 — CI build fix + Health Check semicolon scan
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Fix: Build 107 failed to compile in CI — WriteSelfTest.cs used Path/FileInfo/Directory which didn't resolve in the WPF markup-compile pass. Switched those calls to explicit aliases (matching the existing SysFile pattern). Resolved. New: the Media Health Check now reads each file's embedded comment and flags any containing a semicolon — these files' stored tags may have been truncated by a pre-Build-105 write, so re-embed them on Build 105+ to be safe. Shown as a Warning; it does not block or trigger the ffmpeg "Fix All" (re-embedding is the fix, not remuxing).
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 107 — Built-in Full Write Diagnostic tool
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Enabling Settings → Write Error Diagnostics → "Enable full diagnostic dump" now also reveals a "🩺 Run Full Write Diagnostic on a File…" button. It runs the entire 16-step write investigation (the same checks built up while tracking down the Build 105 bug) against a file you choose — on a safe copy, the original is never modified — showing a green check or red cross for each step with a plain-language interpretation, then exports the full log to a location of your choice. The file picker defaults to your Move/Copy destination folder. Use this to capture a precise report for any future write problem.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 106 — Optional diagnostic dump
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        The full per-file write diagnostic used to isolate the Build 105 bug is retained as an opt-in tool rather than removed. Enable it under Settings → Write Error Diagnostics → "Enable full diagnostic dump" (default OFF). When on, every embed appends a detailed report to %TEMP%\vme_artdump\&lt;filename&gt;.diag.txt covering the MP4 atom layout and tag state before/after the write at each pipeline stage.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 105 — ROOT CAUSE FIX: semicolon truncated the metadata comment
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        The long-running "embeds then reverts on rescan" / "Write Failed" bug that affected only SOME files is fixed. Root cause: TagLib# 2.3.0 truncates the MP4/Apple comment atom (©cmt) at the FIRST SEMICOLON on write. VME stores its [VME:...] tokens at the END of the comment, after the plot description — so any file whose description contained a ';' had its entire token block (IMDB/TMDB IDs, rating, MPA, and every TV episode field) silently chopped off, leaving the file's previous comment in place. On the next Library rescan the file therefore appeared to "revert" to its pre-embed state. Files with no semicolon in the description were never affected, which is exactly why only some files failed. How it was found: a sequence of standalone diagnostics showed synthetic comment text of any length wrote fine, while the real descriptions failed at a fixed point. A controlled real-vs-synthetic test isolated it to content, and character-class elimination pinned it to the semicolon — at the exact position matching the truncated read-back length on both test files ("A Taste of Hunger" at 105 chars, a Dr. STONE episode at 99). Fix: VmeCommentCodec.Encode now sanitises semicolons (replacing ';' with ',', which reads naturally in prose) in the description and in free-text token values before building the comment, so the token block can never be truncated away. Decoding is unaffected. Regression tests use the exact real descriptions that failed. Note: files already truncated by an older build keep their incomplete tags until re-embedded on this build (see the Health Check semicolon scan and the "Re-embed Semicolon Files" button added in later builds).
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 100 — Write-failure dialog layout fix
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Fix: the "Write Failed" dialog crammed five buttons into a fixed 720px non-resizable window, so the right-aligned row overflowed off the left edge and clipped the first button (e.g. "Open in TagScanner" → "in TagScanner"). The window is now wider and resizable, and buttons reflow in a WrapPanel instead of clipping. Note: when verification reports the comment-token fields (IMDB/TMDB/MPA/rating) didn't commit while Title did, the container can't reliably hold the embedded comment block — the fix is Remux → .mp4, which rebuilds a clean faststart container; Replace Original then re-embeds the metadata with artwork.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 99 — Remux cache eviction on extension change
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Fix: after Remux → Replace Original, the cache was evicted for the original and candidate paths but not the actual final path when the extension changed (e.g. .mkv remuxed to .mp4). A stale entry under the final path could be served on the next scan, making a remuxed file appear to revert. The final path is now evicted too. One mechanism within the broader write→cache→scan family fixed across Builds 92–98; not the cause of reverts on files never remuxed.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 98 — Remux auto-embed and context-menu fixes
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Fix: Remux → Replace Original → auto-embed now routes through the single source-of-truth projection so the panel shows verified disk content (and the disk-verified badge) rather than optimistic intended metadata. With the Build 97 handle fix, the embed that used to fail after a successful replace should now succeed or give an honest diagnosis. Fix: original metadata is captured WITH artwork before replacing, so the remuxed file keeps its cover art on auto-embed. Fix: FILES-panel right-click "Open in fallback app (e.g. TagScanner)" could render cut off — shortened to "Open in fallback app…" with the example moved to the tooltip.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 97 — Verification false-positive fix
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Fix: post-write verification re-opened the file while the write handle was still open, which could read a partially-flushed/locked view and report phantom "fields not committed" failures on files (and remuxed copies) that actually wrote fine. The tag-write now runs in its own scope that releases the handle BEFORE verification re-opens the file. Fix: the free-text Description field is no longer hard-verified — some containers truncate/normalise long comment atoms, which would fail an otherwise-correct write. Structured tokens (rating, IDs, MPA, watched, all TV fields) are still strictly verified. Note: a true revert (rescan shows pre-write values) still exhausts retries and recommends a faststart remux; the remux relocates the MP4 moov atom so tags can be written, and is now verified correctly rather than false-failing.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 96 — Phase 2: Self-verification and recoverability
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Verification: after every embed the write path now re-reads the file and verifies the FULL VME token set (rating, IDs, MPA, watched, and all TV fields), not just Title. A container that silently dropped tokens used to pass the Title-only check and revert on the next scan; now the write fails with the exact list of fields that didn't commit. Enforced only for formats that claim full-tag support (MP4/M4V/MKV/MOV); WebM/WMV/AVI keep the Title-only check to avoid false failures. Indicator: FILES panel shows a per-file badge — green "verified on disk" when the post-embed re-read matched, amber "not verified" when it didn't — so a silent revert is visible, not hidden. Tests: 6 new VerifyWritten unit tests (CI-runnable, pure logic).
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 95 — First-save cache persistence bug fix
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Fix: LibraryCacheService.SaveAsync used File.Replace, which throws on the first save for a folder (no existing target) and was silently swallowed — the first cache write was lost on fresh setups, compounding metadata-revert symptoms. Now uses File.Move to create the file, File.Replace only when it exists; save failures are logged instead of silenced. Caught by the Phase 1 integration tests.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 94 — CI fix for Phase 1 tests
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Fix: added LibraryModels/LibraryCacheService/SubtitleDetector to the test compile list and guarded WPF-only members (CoverSource decode, LibraryTab) under NO_WPF so the cache persistence tests compile in the non-WPF test project.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 93 — Phase 1: Foundation stabilization
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Architecture: deleted the dead LibraryViewModel shell (its own unused Entries/Tabs/View/commands the UI never bound to) — removes the two-parallel-collections confusion behind the recurring library state bugs. Behaviour unchanged. Architecture: SyncLibraryEntry is now the single source-of-truth projection — one fresh disk read projected into the grid row, the cache, AND the FILES-panel snapshot in one place. Grid and cache field mapping share one helper so they can't drift. Fix: batch and TV-batch embeds now refresh the FILES-panel snapshot too (previously only the single-file path did), closing the same revert class one layer up. Tests: new LibraryCachePersistenceTests (5 tests) cover the embed → save → reload lifecycle where metadata used to revert; run unskipped in CI. Total 80 tests across 10 files.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 92 — Library persistence root-cause fix
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Fix: library metadata no longer reverts to pre-embed values after a Library scan or after closing and reopening the app. Root cause: SyncLibraryEntry trusted the in-memory metadata object and returned early before updating the persistent cache whenever a file was not yet in LibraryEntries (added via Add Files/Add Folder, not scanned), leaving the cache stale; the in-memory forced-read set masked this within a session but is wiped on restart. Fix: SyncLibraryEntry now re-reads the file from disk after every embed and writes that authoritative result into both the grid entry and the persistent cache — unconditionally, even when the file is not yet in the library. Stale old-path cache entries are evicted on rename. Fix: all three embed paths (single-file, batch, TV batch) now call SyncLibraryEntry; previously only the single-file path did. Fix: FILES panel snapshot refreshed from disk after single-file embed; TV-tree refresh marshalled to UI dispatcher for background batch embeds. Fix: TV tree no longer shows correctly-tagged episodes (e.g. Dr. Stone S02E04) as "untagged" — the gap-scanner now excludes episode numbers already represented by a real library entry.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 91 — Audit pass: all Step 6/7/8 items implemented
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Build/Version: bumped to v1.4.0.91; all version markers updated consistently. Step 6 — Feature completeness: remux auto-embeds original metadata on Replace Original; TV Batch skips already-tagged files with Yes/No/Cancel prompt. Step 7 — Improvements: library scan workers now drive-aware (DriveCapabilityService); all 16 event handlers unsubscribed on close; WatchFolderService + LibraryWatchService disposed; TraktApiService HttpClient static singleton; ApiService User-Agent reads AssemblyVersion; full changelog updated. Step 8.4 — Export All NFO: ExportLibraryNfoCommand wired; 📄 NFO button added to Library toolbar; ToMovieMetadata() added to LibraryEntry; exports Kodi/Jellyfin/Plex-compatible sidecar files for entire library. Step 8.5 — Search confidence: MatchLabel badge already wired in search results (✓ Exact / ≈ Good / ~ Partial / ? Weak). Step 8.6 — Watched progress: WatchedProgress + ProgressLabel fields on VideoFile; teal progress badge appears in FILES panel item alongside watched badge when Trakt reports in-progress playback. Step 8.7 — Auto update check: CheckForUpdateAsync fires at ApplicationIdle; compares AssemblyVersion to latest GitHub release tag; shows status bar notification if newer version available — non-blocking, non-intrusive. Fix: ToMovieMetadata used ImdbRating (wrong) → Rating (correct MovieMetadata field name). Fix: WatchedProgress setter used if(Set(...)) → VideoFile.Set returns void; rewritten as explicit equality check. Fix: GetCorrectExtension called with r.FilePath (string) → r (HealthResult) in FixAllIssuesAsync. Fix: Unused done variable removed from ExportLibraryNfoAsync.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 90 — Major quality pass: library persistence, audit fixes, new features
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Library: in-place scan update (no more clear-and-rebuild), metadata persists across Scan Library clicks. Library: MarkAsEmbedded ensures fresh TagLib# read on next scan for any embedded file. Library: cache now saved on app close; IsWatched preserved across restarts. Library: ExportLibraryNfoCommand now wired — 📄 NFO button in toolbar exports Kodi/Plex sidecars. Library: scan workers now drive-aware (DriveCapabilityService) — HDD no longer thrashes. UI: Subtitle panel added to RETRIEVED DATA tab (🗒 Subtitles expander, Search + Download Selected). UI: Undo Batch permanent button in RAW DATA tab (no longer only in transient banner chip). UI: Mark Watched button now shows ♥ Watched / Unwatched (was showing ✓ Found / Not found). UI: Progress badge added to FILES panel items showing Trakt watch progress %. UI: Save Layout now syncs column widths before save (resize-without-reorder now captured). Embed: Rename Current File now snapshots undo state correctly. Embed: Remux Replace Original auto-embeds original metadata into remuxed file. Embed: TV Batch now prompts to skip already-tagged files (Yes/No/Cancel). Embed: Batch undo warns before clearing snapshot when new batch starts. Stability: CanScanLibrary now checks IsBusy — scan blocked during embed. Stability: LibraryCacheService _index changed to ConcurrentDictionary (parallel scan safety). Stability: Trakt token refresh now uses SemaphoreSlim — no double-refresh race. Stability: TraktApiService.HttpClient changed to static readonly singleton. Stability: ApiService User-Agent now reads from AssemblyVersion (was hardcoded 1.3.4). Stability: MainWindow_Closing now unsubscribes all 16 event handlers + disposes FSW services. Stability: WatchFolderService and LibraryWatchService now disposed on app close. Bindings: SubtitleSearchResults binding corrected (was SubtitleResults — silent failure). Bindings: InverseBool → InvBool (correct converter key, was causing startup crash). Bindings: ChipClickHandler moved to class-level (was local function — CS0103 error). Startup: Auto update check fires at ApplicationIdle — notifies via status bar if newer version available. Build: WriteStatus.None → WriteStatus.Untouched (CS0117 CI error fixed). IMPROVEMENTS: Fingerprint cache import now supports Merge vs Replace and no longer requires restart (new Reload/MergeFrom methods). Quick Scan now honours excluded patterns (was only respected in Deep Scan). Cross-stage duplicate group deduplication — same file pair caught by multiple stages now appears only once, highest-confidence kept. TMDB popularity score used as tiebreaker in search ranking (common-title disambiguation). Standard tag fallback in MetadataService reads IMDB ID, rating, MPA from Apple tag atoms on files tagged by external tools (TagScanner, tinyMediaManager, Plex). Health Check: new ✏ Fix Extension option renames mislabeled files instantly (no remux, no re-encode). TV batch now cross-references library gaps and logs which episodes remain unmatched. Folder watcher completely rewritten: silent seed pass on startup prevents re-reporting existing files; FSW buffer-overflow recovery now does an immediate poll scan instead of waiting up to 3 minutes; prunes stale entries every 10 polls. THREAD SAFETY: ConsoleLog.Insert routed through dispatcher-aware Log() helper across all 122 call sites — eliminates NotSupportedException on CollectionView from background threads (Trakt startup check, library rebuild, orphan sweep). Library cache auto-prunes ghost entries on every scan. VmeCommentCodec extracted as pure-logic class for testing. TESTS: MetadataRoundTripTests (10) verify VME tag encode/decode round-trips including TV episode fields, rating precision, locale-safe decimal format, and token isolation. Total: 66 test methods. CI: GitHub Actions updated to checkout@v4.2.2 / setup-dotnet@v4.3.1 (eliminates Node.js 20 deprecation warnings before June 2026 deadline).
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 89 — Media Health Check + Deep Scan polish
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        NEW 📋 Media Health Check tab. MediaHealthService detects the true container from file-header magic bytes (MP4, QuickTime, Matroska, AVI, ASF/WMV, MPEG-TS/PS, FLV) and compares against the extension — catches misnamed files that silently fail metadata embedding. Flags MP4 no-faststart (moov atom at end), zero-byte/truncated files, unreadable headers, and unknown containers. Parallel detection (ProcessorCount−1), reads only first ~64 KB per file. Plain-English issue + suggested fix per row; 📋 Copy Report; ✕ Clear. STAGE 2: FfmpegService adds ⚡ Fix All Faststart — lossless stream-copy remux (-c copy -movflags +faststart), preserves timestamps, no re-encode. ffmpeg auto-detected from native\ folder, app folder, or PATH. Settings → External Tools shows ffmpeg status, 🔄 Re-detect, and 🌐 Download link (gyan.dev). ffmpeg is NOT bundled. UI: tab strip tightened (padding 16,10 → 9,9; font 13 → 12) so all tabs fit at default width. Health Check tab icon is a clipboard 📋. Right-click Remux: both the Health Check grid and the FILES panel now offer 🔧 Remux to .mkv / .mp4 — lossless container rebuild that fixes files refusing metadata embedding (the genuine answer to the "had to use TagScanner" cases). FILES panel also gets 🔧 Open in fallback app and 📂 Open containing folder. Remux to .mp4 keeps MP4 and adds faststart; Remux to .mkv uses the most tag-permissive container. Fix All Faststart parallelised (ProcessorCount−1) with a completion summary dialog (count processed / failed). Build filename fix: AssemblyName bumped to 1.4.0.89 (was producing ...88.exe). Note: MKVToolNix only outputs MKV — MP4-preserving faststart needs ffmpeg, which is why Stage 2 uses ffmpeg rather than mkvmerge.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 88 — Chromaprint Deep Scan + duplicate cleanup workflow
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        ♪ Deep Scan — Chromaprint audio fingerprinting via fpcalc.exe
                                        (subprocess; FFmpeg statically linked, no extra deps). 3-phase
                                        parallel pipeline: fingerprint (ProcessorCount−1 workers) → pre-decode
                                        once → parallel pairwise compare. ~35 min for 5,000 files on 8 cores.
                                        ⬇ Install fpcalc / ⬆ Check Update auto-installer (GitHub releases,
                                        in-memory download to avoid Defender locks, MOTW strip). Fingerprint
                                        cache (fingerprints.json) with 💾 Export / 📂 Import. 🔎 Find
                                        Duplicates of File (O(n) reference scan). Smart Select (Smaller/
                                        Larger/Untagged/In Unsorted) + Auto-Resolve (Keep Largest/Newest/
                                        Tagged) across all groups. Per-file checkboxes; live disk-recovery
                                        badge; 🗑 Delete Selected / 📤 Move Selected (Recycle Bin). Exclude
                                        patterns in Settings. Fixes: filename-based TV rescue in
                                        ResolveDestination (untagged S##E## files no longer land in Movies);
                                        deep-scan now populates size + metadata (no more 0 MB vs 0 MB);
                                        Source==Destination dedup; LibraryEntry notifying setters (Rating/MPA
                                        no longer show stale after embed); UntaggedFileHandling /
                                        UnsortedFolderName settings proxies (were silently never saved);
                                        editable MPA Rating ComboBox; MPA "NR" display fallback unified.
                                    </TextBlock>


                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 88 — Phase 1: Chromaprint Audio Fingerprinting
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        NativeLibraryExtractor.cs: extracts embedded
                                        chromaprint.dll from assembly resources to
                                        AppDir
ative\ on first run. Registers
                                        NativeLibrary.SetDllImportResolver so all
                                        P/Invoke calls resolve automatically.
                                        ChromaprintService.cs: full P/Invoke wrapper
                                        for Chromaprint 1.5.1. ComputeFingerprint()
                                        feeds raw 16-bit PCM into Chromaprint and
                                        returns a base64-encoded fingerprint string.
                                        ComputeSimilarity() computes bit-error rate
                                        on packed uint[] arrays — returns 0.0-1.0.
                                        AudioDecoderService.cs: decodes first 120s
                                        of audio to 22kHz mono 16-bit PCM using
                                        Sdcb.FFmpeg (no external ffmpeg.exe needed).
                                        Handles FLTP/S16/S16P/FLT sample formats.
                                        Downmixes to mono, linear-resamples to 22kHz.
                                        FingerprintCacheService.cs: persists computed
                                        fingerprints to fingerprints.json alongside
                                        the EXE. Cache key = path+size+mtime.
                                        Stale entries auto-evicted on access.
                                        DuplicateDetectorService: Stage 5 DeepScanAsync
                                        + AudioMatch confidence tier. Pairwise
                                        fingerprint comparison with configurable
                                        similarity threshold (default 0.70 = 70%).
                                        DuplicatesViewModel: DeepScanCommand,
                                        RunDeepScanAsync, progress reporting.
                                        ChromaprintAvailable property checks for
                                        native DLLs at startup.
                                        UI: ♪ Deep Scan button with live progress
                                        bar and status. Shows warning when
                                        chromaprint.dll not installed.
                                        Sdcb.FFmpeg NuGet added to project.
                                    </TextBlock>


                                    <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,2">
                                        v1.4.0  ·  Build 87 — Duplicate Cross-Size Detection + Side-by-Side Preview
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BaseText}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="8,0,0,12" TextWrapping="Wrap">
                                        Duplicate detection Stage 4 — CrossSize: groups
                                        files with the same IMDb/TMDB ID or title+year
                                        regardless of file size. Catches same-movie
                                        duplicates at different encode qualities (e.g.
                                        720p vs 1080p of the same film). Presented as
