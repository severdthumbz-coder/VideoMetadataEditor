                                <TextBlock Style="{StaticResource BaseText}" TextWrapping="Wrap" Margin="0,0,0,8">
                                    Tag writing powered by
                                    <Hyperlink NavigateUri="https://github.com/mono/taglib-sharp" RequestNavigate="HelpLink_RequestNavigate">TagLib#</Hyperlink>
                                    (LGPL v2.1).
                                    Audio fingerprinting powered by
                                    <Hyperlink NavigateUri="https://acoustid.org/chromaprint" RequestNavigate="HelpLink_RequestNavigate">Chromaprint / fpcalc</Hyperlink>
                                    (LGPL v2.1).
                                    MKV artwork embedding powered by
                                    <Hyperlink NavigateUri="https://mkvtoolnix.download" RequestNavigate="HelpLink_RequestNavigate">MKVToolNix</Hyperlink>
                                    (GPL v2).
                                    Media remux and health repair powered by
                                    <Hyperlink NavigateUri="https://ffmpeg.org" RequestNavigate="HelpLink_RequestNavigate">FFmpeg</Hyperlink>
                                    (LGPL v2.1 or later).
                                </TextBlock>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ══════════════════════════════════════════════════════ -->
                    <!-- TAB 6 — PROCESSING LOG + DUPLICATES                   -->
                    <!-- ══════════════════════════════════════════════════════ -->
                    <TabItem Header="{DynamicResource Tab.Log}">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="160"/>
                            </Grid.RowDefinitions>

                            <!-- Log header + actions -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Processing Log"
                                           Style="{StaticResource SectionHeader}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="🔍 Find Duplicates"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding FindDuplicatesCommand}"
                                            Padding="10,5" FontSize="12" Margin="0,0,6,0"/>
                                    <Button Content="{DynamicResource Lib.ExportCsv}"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding ExportCsvCommand}"
                                            Padding="10,5" FontSize="12" Margin="0,0,6,0"/>
                                    <Button Content="📄 Export NFO"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding ExportNfoCommand}"
                                            Padding="10,5" FontSize="12" Margin="0,0,6,0"/>
                                    <Button Content="🖼 Bulk Artwork"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding BulkArtworkCommand}"
                                            Padding="10,5" FontSize="12"
                                            ToolTip="Download missing artwork for selected files using their TMDB IDs"/>
                                </StackPanel>
                            </Grid>

                            <!-- Log entries -->
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding ConsoleLog}"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     Background="{DynamicResource SurfaceAltBrush}"
                                     BorderThickness="1"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="6,2"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <!-- Clear log button -->
                            <Button Grid.Row="2"
                                    Content="Clear Log"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="10,5" FontSize="11"
                                    HorizontalAlignment="Right"
                                    Margin="0,6,0,6"
                                    Click="ClearLog_Click"/>

                            <!-- Duplicates panel -->
                            <Border Grid.Row="3"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6"
                                    Visibility="{Binding Duplicates.Count, Converter={StaticResource NullVis}}">
                                <Grid Margin="10,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Text="Duplicate Groups"
                                               Style="{StaticResource LabelText}"
                                               Margin="0,0,0,6"/>
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding Duplicates}"
                                             FontSize="12"
                                             Background="Transparent"
                                             BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource WarningBrush}"/>
                                                    <ItemsControl ItemsSource="{Binding Files}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding FilePath}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- STATUS BAR with embedded progress bar                             -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel>

                <!-- Progress bar — visible only when busy or progress > 0 -->
                <ProgressBar x:Name="StatusProgressBar"
                             Height="3"
                             Value="{Binding ProgressValue}"
                             Maximum="100"
                             Background="{DynamicResource SurfaceAltBrush}"
                             Foreground="{DynamicResource PrimaryBrush}"
                             BorderThickness="0"
                             Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolVis}}"/>

                <!-- Status text row -->
                <Grid Margin="12,5">
                    <!-- Left: status message with spinner -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⏳ "
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding StatusText}"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource ForegroundMutedBrush}"/>
                        <!-- Progress percentage when running -->
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Margin="8,0,0,0"
                                   Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolVis}}">
                            <TextBlock.Text>
                                <Binding Path="ProgressValue" StringFormat="  {0}%"/>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>

                    <!-- Right: file count · version -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding Files.Count, StringFormat='{}{0} file(s)'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource ForegroundMutedBrush}"/>
                        <TextBlock Text="  ·  "
                                   FontSize="12"
                                   Foreground="{DynamicResource ForegroundMutedBrush}"/>
                        <TextBlock Text="{Binding AppVersionFull, Mode=OneTime}"
                                   FontSize="12"
                                   Foreground="{DynamicResource ForegroundMutedBrush}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

    </Grid>
</Window>
